<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- SBCL compiles to memory and runs it, so the hardened runtime
       must allow writable, executable pages. -->
  <key>com.apple.security.cs.allow-jit</key><true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key><true/>
  <!-- Cadre loads libraries it didn't ship: tree-sitter (Homebrew's), the
       grammars and the shim it compiles on your Mac, and VTE when it isn't
       bundled. -->
  <key>com.apple.security.cs.disable-library-validation</key><true/>
</dict>
</plist>
