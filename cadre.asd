;;;; cadre.asd — Cadre, a Lisp editor

(defsystem "cadre"
  :description "Cadre: a Common Lisp editor with Emacs's depth and VS Code's interface."
  :author "Jessie Hughart"
  :license "MIT"
  :version "1.0.0"
  :depends-on ("cadre/core" "gtk4" "gtk4-adwaita")
  :pathname "src/ui/"
  :serial t
  :components ((:file "package")
               (:file "gtk-text")
               (:file "settings")
               (:file "themes")
               (:file "keys")
               (:file "highlight")
               (:file "editor-view")
               (:file "explorer")
               (:file "panel")
               (:file "window")
               (:file "tabs")
               (:file "tab-strip")
               (:file "layout")
               (:file "commands")
               (:file "picker")
               (:file "search")
               (:file "lisp-commands")
               (:file "editing")
               (:file "paredit")
               (:file "macros")
               (:file "session")
               (:file "repl")
               (:file "notes")
               (:file "debugger")
               (:file "completion")
               (:file "lisp-eval")
               (:file "hints")
               (:file "image-faces")
               (:file "inspector")
               (:file "presentations")
               (:file "xref")
               (:file "macroexpand")
               (:file "trace")
               (:file "stepper")
               (:file "profiler")
               (:file "scratch")
               (:file "systems")
               (:file "libraries")
               (:file "review")
               (:file "file-watch")
               (:file "claude-tools")
               (:file "claude")
               (:file "editor-repl")
               (:file "language-repl")
               (:file "clojure")
               (:file "restore")
               (:file "settings-page")
               (:file "project-search")
               (:file "refactor")
               (:file "markdown")
               (:file "hyperspec")
               (:file "image-view")
               (:file "file-ops")
               (:file "outline")
               (:file "everyday")
               (:file "git")
               (:file "git-history")
               (:file "git-merge")
               (:file "folding")
               (:file "tree-sitter")
               (:file "terminal")
               (:file "format")
               (:file "new-project")
               (:file "build")
               (:file "racket")
               (:file "language-docs")
               (:file "projects")
               (:file "databases")
               (:file "api")
               (:file "gtk-app")
               (:file "run-app")
               (:file "bindings")
               (:file "session-log")
               (:file "app"))
  :in-order-to ((test-op (test-op "cadre/tests"))))

(defsystem "cadre/core"
  :description "Cadre's editor model, with no GTK dependency: text, buffers, commands, keymaps, modes, hooks, options."
  :depends-on ("sb-bsd-sockets" "sb-posix" "sb-introspect" "sb-md5" "cl-ppcre" "cffi" "cl-postgres" "qmynd" "docset")
  :pathname "src/core/"
  :serial t
  :components ((:file "package")
               (:file "hooks")
               (:file "options")
               (:file "resources")
               (:file "text")
               (:file "keymaps")
               (:file "modes")
               (:file "buffers")
               (:file "editor")
               (:file "commands")
               (:file "editing")
               (:file "fuzzy")
               (:module "lisp"
                :serial t
                :components ((:file "dialect")
                             (:file "lexer")
                             (:file "syntax")
                             (:file "indent")
                             (:file "faces")
                             (:file "paredit")
                             (:file "refactor")))
               (:file "search")
               (:file "definitions" :pathname "lisp/definitions")
               (:file "markdown")
               (:file "folding")
               (:file "format")
               (:file "git")
               (:file "new-project")
               (:file "backend")
               (:module "swank"
                :serial t
                :components ((:file "sexp")
                             (:file "connection")
                             (:file "backend")
                             (:file "inferior")
                             (:file "forms")
                             (:file "tools")
                             (:file "image")
                             (:static-file "profiler-remote.lisp")
                             (:file "profiler")))
               (:module "nrepl"
                :serial t
                :components ((:file "bencode")
                             (:file "connection")
                             (:file "backend")
                             (:file "start")))
               (:file "racket-backend" :pathname "racket/backend")
               (:file "build")
               (:file "terminal")
               (:file "tree-sitter" :pathname "tree-sitter/tree-sitter")
               (:module "claude"
                :serial t
                :components ((:file "json")
                             (:file "cli")
                             (:file "mcp")
                             (:file "diff")))
               (:file "language-docs")
               (:file "edn")
               (:file "language-projects")
               (:module "database"
                :serial t
                :components ((:file "database")
                             (:file "sqlite")
                             (:file "postgres")
                             (:file "mysql")))
               (:file "http" :pathname "http/http")
               (:file "libraries")))

(defsystem "cadre/tests"
  :description "Headless tests for cadre/core."
  :depends-on ("cadre/core" "parachute")
  :pathname "tests/"
  :serial t
  :components ((:file "package")
               (:file "text")
               (:file "buffers")
               (:file "commands")
               (:file "keymaps")
               (:file "lisp")
               (:file "editing")
               (:file "dialects")
               (:file "swank")
               (:file "nrepl")
               (:file "racket")
               (:file "claude")
               (:file "terminal")
               (:file "database")
               (:file "postgres")
               (:file "mysql")
               (:file "http")
               (:file "profiler")
               (:file "libraries"))
  :perform (test-op (op c) (uiop:symbol-call :parachute :test :cadre-tests)))
