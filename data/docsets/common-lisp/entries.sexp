(:entry "glossary/active" :names ("active") :kind :glossary-term :kind-name "Glossary Term" :summary "(of a handler, a restart, or a catch tag) having been established but not yet disestablished." :sections (("Definition" (:p (:i "adj.")) (:list (:item (:label "1.") (:p "(of a " (:term "glossary/handler" "handler") ", a " (:term "glossary/restart" "restart") ", or a " (:term "glossary/catch tag" "catch tag") ") having been " (:term "glossary/establish" "established") " but not yet " (:term "glossary/disestablish" "disestablished") ".")) (:item (:label "2.") (:p "(of an " (:term "glossary/element" "element") " of an " (:term "glossary/array" "array") ") having an index that is greater than or equal to zero, but less than the " (:term "glossary/fill pointer" "fill pointer") " (if any). For an " (:term "glossary/array" "array") " that has no " (:term "glossary/fill pointer" "fill pointer") ", all " (:term "glossary/element" "elements") " are considered " (:term "glossary/active" "active") "."))))))
