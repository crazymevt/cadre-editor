(:entry "glossary/simple general vector" :names ("simple general vector") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/simple vector" "simple vector") "."))))
(:entry "glossary/simple string" :names ("simple string") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/string" "string") " " "of " (:term "glossary/type" "type") " " (:ref "type/simple-string" "simple-string") "."))))
(:entry "glossary/simple vector" :names ("simple vector") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/vector" "vector") " " "of " (:term "glossary/type" "type") " " (:ref "type/simple-vector" "simple-vector") ", sometimes called a “" (:term "glossary/simple general vector" "simple general vector") ".” Not all " (:term "glossary/vector" "vectors") " that are " (:term "glossary/simple" "simple") " are " (:term "glossary/simple vector" "simple vectors") "—only those that have " (:term "glossary/element type" "element type") " " (:ref "system-class/t" "t") "."))))
(:entry "glossary/single escape" :names ("single escape") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") ", " (:i "adj.")) (:list (:item (:label "1.") (:p (:i "n.") " " "the " (:term "glossary/syntax type" "syntax type") " of a " (:term "glossary/character" "character") " that indicates that the next " (:term "glossary/character" "character") " is to be treated as an " (:term "glossary/alphabetic" "alphabetic") (:sense "2") " " (:term "glossary/character" "character") " with its " (:term "glossary/case" "case") " preserved. For details, " "see " (:secref "SingleEscapeChar" "Section 2.1.4.6 ({}Single Escape Character)") ".")) (:item (:label "2.") (:p (:i "adj.") " " "(of a " (:term "glossary/character" "character") ") having the " (:term "glossary/single escape" "single escape") " " (:term "glossary/syntax type" "syntax type") ".")) (:item (:label "3.") (:p (:i "n.") " " "a " (:term "glossary/single escape" "single escape") (:sense "2") " " (:term "glossary/character" "character") ". (In the " (:term "glossary/standard readtable" "standard readtable") ", " (:term "glossary/slash" "slash") " is the only " (:term "glossary/single escape" "single escape") ".)"))))))
(:entry "glossary/single float" :names ("single float") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " an " (:term "glossary/object" "object") " " "of " (:term "glossary/type" "type") " " (:ref "type/short-float" "single-float") "."))))
(:entry "glossary/single-quote" :names ("single-quote") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " the " (:term "glossary/standard character" "standard character") " that is variously called “apostrophe,” “acute accent,” “quote,” or “single quote” (" (:code "'") "). " "See " (:secref "StdCharsThree" "Figure~2--5") "."))))
(:entry "glossary/singleton" :names ("singleton") :kind :glossary-term :kind-name "Glossary Term" :summary "adj." :sections (("Definition" (:p (:i "adj.") " " "(of a " (:term "glossary/sequence" "sequence") ") having only one " (:term "glossary/element" "element") ". " "“" (:code "(list 'hello)") " returns a singleton list.”"))))
(:entry "glossary/situation" :names ("situation") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " the " (:term "glossary/evaluation" "evaluation") " of a " (:term "glossary/form" "form") " in a specific " (:term "glossary/environment" "environment") "."))))
(:entry "glossary/slash" :names ("slash") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " the " (:term "glossary/standard character" "standard character") " that is variously called “solidus” or “slash” (" (:code "/") "). " "See " (:secref "StdCharsThree" "Figure~2--5") "."))))
(:entry "glossary/slot" :names ("slot") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a component of an " (:term "glossary/object" "object") " that can store a " (:term "glossary/value" "value") "."))))
(:entry "glossary/slot specifier" :names ("slot specifier") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a representation of a " (:term "glossary/slot" "slot") " that includes the " (:term "glossary/name" "name") " of the " (:term "glossary/slot" "slot") " and zero or more " (:term "glossary/slot" "slot") " options. A " (:term "glossary/slot" "slot") " option pertains only to a single " (:term "glossary/slot" "slot") "."))))
(:entry "glossary/source code" :names ("source code") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " " (:term "glossary/code" "code") " representing " (:term "glossary/object" "objects") " suitable for " (:term "glossary/evaluation" "evaluation") " (" (:i "e.g.") ", " (:term "glossary/object" "objects") " created by " (:ref "function/read" "read") ", by " (:term "glossary/macro expansion" "macro expansion") ", " " or by " (:term "glossary/compiler macro expansion" "compiler macro expansion") ")."))))
(:entry "glossary/source file" :names ("source file") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/file" "file") " which contains a textual representation of " (:term "glossary/source code" "source code") ", that can be edited, " (:term "glossary/load" "loaded") ", or " (:term "glossary/compile" "compiled") "."))))
(:entry "glossary/space" :names ("space") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " the " (:term "glossary/standard character" "standard character") " " "⟨" (:i "Space") "⟩" ", notated for the " (:term "glossary/lisp reader" "Lisp reader") " as " (:code "#" "\\" "Space") "."))))
(:entry "glossary/special form" :names ("special form") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/list" "list") ", other than a " (:term "glossary/macro form" "macro form") ", which is a " (:term "glossary/form" "form") " with special syntax or special " (:term "glossary/evaluation" "evaluation") " rules or both, possibly manipulating the " (:term "glossary/evaluation" "evaluation") " " (:term "glossary/environment" "environment") " or control flow or both. The first element of a " (:term "glossary/special form" "special form") " is a " (:term "glossary/special operator" "special operator") "."))))
(:entry "glossary/special operator" :names ("special operator") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " one of a fixed set of " (:term "glossary/symbol" "symbols") ", enumerated in " (:secref "CLSpecialOps" "Figure~3--2") ", that may appear in the " (:term "glossary/car" "car") " of a " (:term "glossary/form" "form") " in order to identify the " (:term "glossary/form" "form") " as a " (:term "glossary/special form" "special form") "."))))
(:entry "glossary/special variable" :names ("special variable") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " (:i "Trad.") " " " a " (:term "glossary/dynamic variable" "dynamic variable") "."))))
(:entry "glossary/specialize" :names ("specialize") :kind :glossary-term :kind-name "Glossary Term" :summary "v.t." :sections (("Definition" (:p (:i "v.t.") " " "(a " (:term "glossary/generic function" "generic function") ") to define a " (:term "glossary/method" "method") " for the " (:term "glossary/generic function" "generic function") ", or in other words, to refine the behavior of the " (:term "glossary/generic function" "generic function") " by giving it a specific meaning for a particular set of " (:term "glossary/class" "classes") " or " (:term "glossary/argument" "arguments") "."))))
(:entry "glossary/specialized" :names ("specialized") :kind :glossary-term :kind-name "Glossary Term" :summary "(of a generic function) having methods which specialize the generic function." :sections (("Definition" (:p (:i "adj.")) (:list (:item (:label "1.") (:p "(of a " (:term "glossary/generic function" "generic function") ") having " (:term "glossary/method" "methods") " which " (:term "glossary/specialize" "specialize") " the " (:term "glossary/generic function" "generic function") ".")) (:item (:label "2.") (:p "(of an " (:term "glossary/array" "array") ") having an " (:term "glossary/actual array element type" "actual array element type") " that is a " (:term "glossary/proper subtype" "proper subtype") " of " "the " (:term "glossary/type" "type") " " (:ref "system-class/t" "t") "; " "see " (:secref "ArrayElements" "Section 15.1.1 (Array Elements)") ". " "“" (:code "(make-array 5 :element-type 'bit)") " makes an array of length five that is specialized for bits.”"))))))
(:entry "glossary/specialized lambda list" :names ("specialized lambda list") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " an " (:term "glossary/extended lambda list" "extended lambda list") " used in " (:term "glossary/form" "forms") " that " (:term "glossary/establish" "establish") " " (:term "glossary/method" "method") " definitions, such as " (:ref "macro/defmethod" "defmethod") ". " "See " (:secref "SpecializedLambdaLists" "Section 3.4.3 (Specialized Lambda Lists)") "."))))
(:entry "glossary/spreadable argument list designator" :names ("spreadable argument list designator") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/designator" "designator") " for a " (:term "glossary/list" "list") " of " (:term "glossary/object" "objects") "; that is, an " (:term "glossary/object" "object") " that denotes a " (:term "glossary/list" "list") " and that is a " (:term nil "non-null") " " (:term "glossary/list" "list") " " (:math "L1") " of length " (:math "n") ", whose last element is a " (:term "glossary/list" "list") " " (:math "L2") " of length " (:math "m") " (denoting a list " (:math "L3") " of length " (:math "m+n-1") " whose " (:term "glossary/element" "elements") " are " (:math "L1" (:sub "i")) " for " (:math "i < n-1") " followed by " (:math "L2" (:sub "j")) " for " (:math "j < m") "). " "“The list (1 2 (3 4 5)) is a spreadable argument list designator for the list (1 2 3 4 5).”"))))
(:entry "glossary/stack allocate" :names ("stack allocate") :kind :glossary-term :kind-name "Glossary Term" :summary "v.t." :sections (("Definition" (:p (:i "v.t.") " " (:i "Trad.") " " " to allocate in a non-permanent way, such as on a stack. Stack-allocation is an optimization technique used in some " (:term "glossary/implementation" "implementations") " for allocating certain kinds of " (:term "glossary/object" "objects") " that have " (:term "glossary/dynamic extent" "dynamic extent") ". Such " (:term "glossary/object" "objects") " are allocated on the stack rather than in the heap so that their storage can be freed as part of unwinding the stack rather than taking up space in the heap until the next garbage collection. What " (:term "glossary/type" "types") " (if any) can have " (:term "glossary/dynamic extent" "dynamic extent") " can vary from " (:term "glossary/implementation" "implementation") " to " (:term "glossary/implementation" "implementation") ". No " (:term "glossary/implementation" "implementation") " is ever required to perform stack-allocation."))))
(:entry "glossary/stack-allocated" :names ("stack-allocated") :kind :glossary-term :kind-name "Glossary Term" :summary "adj." :sections (("Definition" (:p (:i "adj.") " " (:i "Trad.") " " " having been " (:term "glossary/stack allocate" "stack allocated") "."))))
(:entry "glossary/standard character" :names ("standard character") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/character" "character") " " "of " (:term "glossary/type" "type") " " (:ref "type/standard-char" "standard-char") ", which is one of a fixed set of 96 such " (:term "glossary/character" "characters") " required to be present in all " (:term "glossary/conforming implementation" "conforming implementations") ". " "See " (:secref "StandardChars" "Section 2.1.3 (Standard Characters)") "."))))
(:entry "glossary/standard class" :names ("standard class") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/class" "class") " that is a " (:term "glossary/generalized instance" "generalized instance") " " "of " (:term "glossary/class" "class") " " (:ref "system-class/standard-class" "standard-class") "."))))
(:entry "glossary/standard generic function" :names ("standard generic function") :kind :glossary-term :kind-name "Glossary Term" :summary "a function of type standard-generic-function." :sections (("Definition" (:p "a " (:term "glossary/function" "function") " " "of " (:term "glossary/type" "type") " " (:ref "system-class/standard-generic-function" "standard-generic-function") "."))))
(:entry "glossary/standard input" :names ("standard input") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " the " (:term "glossary/input" "input") " " (:term "glossary/stream" "stream") " which is the " (:term "glossary/value" "value") " of the " (:term "glossary/dynamic variable" "dynamic variable") " " (:ref "variable/*debug-io*" "*standard-input*") "."))))
(:entry "glossary/standard method combination" :names ("standard method combination") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " the " (:term "glossary/method combination" "method combination") " named " (:code "standard") "."))))
(:entry "glossary/standard object" :names ("standard object") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " an " (:term "glossary/object" "object") " that is") (:p "a " (:term "glossary/generalized instance" "generalized instance") " " "of " (:term "glossary/class" "class") " " (:ref "class/standard-object" "standard-object") "."))))
(:entry "glossary/standard output" :names ("standard output") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " the " (:term "glossary/output" "output") " " (:term "glossary/stream" "stream") " which is the " (:term "glossary/value" "value") " of the " (:term "glossary/dynamic variable" "dynamic variable") " " (:ref "variable/*debug-io*" "*standard-output*") "."))))
(:entry "glossary/standard pprint dispatch table" :names ("standard pprint dispatch table") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " A " (:term "glossary/pprint dispatch table" "pprint dispatch table") " that is " (:term "glossary/different" "different") " from the " (:term "glossary/initial pprint dispatch table" "initial pprint dispatch table") ", that implements " (:term "glossary/pretty print" "pretty printing") " as described in this specification, and that, unlike other " (:term "glossary/pprint dispatch table" "pprint dispatch tables") ", must never be modified by any program. (Although the definite reference “the " (:term "glossary/standard pprint dispatch table" "standard pprint dispatch table") "” is generally used within this document, it is actually " (:term "glossary/implementation-dependent" "implementation-dependent") " whether a single " (:term "glossary/object" "object") " fills the role of the " (:term "glossary/standard pprint dispatch table" "standard pprint dispatch table") ", or whether there might be multiple such objects, any one of which could be used on any given occasion where “the " (:term "glossary/standard pprint dispatch table" "standard pprint dispatch table") "” is called for. As such, this phrase should be seen as an indefinite reference in all cases except for anaphoric references.)"))))
(:entry "glossary/standard readtable" :names ("standard readtable") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " A " (:term "glossary/readtable" "readtable") " that is " (:term "glossary/different" "different") " from the " (:term "glossary/initial readtable" "initial readtable") ", that implements the " (:term "glossary/expression" "expression") " syntax defined in this specification, and that, unlike other " (:term "glossary/readtable" "readtables") ", must never be modified by any program. (Although the definite reference “the " (:term "glossary/standard readtable" "standard readtable") "” is generally used within this document, it is actually " (:term "glossary/implementation-dependent" "implementation-dependent") " whether a single " (:term "glossary/object" "object") " fills the role of the " (:term "glossary/standard readtable" "standard readtable") ", or whether there might be multiple such objects, any one of which could be used on any given occasion where “the " (:term "glossary/standard readtable" "standard readtable") "” is called for. As such, this phrase should be seen as an indefinite reference in all cases except for anaphoric references.)"))))
(:entry "glossary/standard syntax" :names ("standard syntax") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " the syntax represented by the " (:term "glossary/standard readtable" "standard readtable") " and used as a reference syntax throughout this document. " "See " (:secref "TheStandardSyntax" "Section 2.1 (Character Syntax)") "."))))
(:entry "glossary/standardized" :names ("standardized") :kind :glossary-term :kind-name "Glossary Term" :summary "adj." :sections (("Definition" (:p (:i "adj.") " " "(of a " (:term "glossary/name" "name") ", " (:term "glossary/object" "object") ", or definition) having been defined by " "Common Lisp" ". " "“All standardized variables that are required to hold bidirectional streams have “" (:code "-io*") "” in their name.”"))))
(:entry "glossary/startup environment" :names ("startup environment") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " the " (:term "glossary/global environment" "global environment") " of the running " (:term "glossary/lisp image" "Lisp image") " from which the " (:term "glossary/compiler" "compiler") " was invoked."))))
(:entry "glossary/step" :names ("step") :kind :glossary-term :kind-name "Glossary Term" :summary "v.t." :sections (("Definition" (:p (:i "v.t.") ", " (:i "n.")) (:list (:item (:label "1.") (:p (:i "v.t.") " " "(an iteration " (:term "glossary/variable" "variable") ") to " (:term "glossary/assign" "assign") " the " (:term "glossary/variable" "variable") " a new " (:term "glossary/value" "value") " at the end of an iteration, in preparation for a new iteration.")) (:item (:label "2.") (:p (:i "n.") " " "the " (:term "glossary/code" "code") " that identifies how the next value in an iteration is to be computed.")) (:item (:label "3.") (:p (:i "v.t.") " " "(" (:term "glossary/code" "code") ") to specially execute the " (:term "glossary/code" "code") ", pausing at intervals to allow user confirmation or intervention, usually for debugging."))))))
(:entry "glossary/stream" :names ("stream") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " an " (:term "glossary/object" "object") " that can be used with an input or output function to identify an appropriate source or sink of " (:term "glossary/character" "characters") " or " (:term "glossary/byte" "bytes") " for that operation."))))
(:entry "glossary/stream associated with a file" :names ("stream associated with a file") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/file stream" "file stream") ", or a " (:term "glossary/synonym stream" "synonym stream") " the " (:term "glossary/target" "target") " of which is a " (:term "glossary/stream associated with a file" "stream associated with a file") ".") (:p "Such a " (:term "glossary/stream" "stream") " cannot be created with " (:ref "function/make-two-way-stream" "make-two-way-stream") ", " (:ref "function/make-echo-stream" "make-echo-stream") ", " (:ref "function/make-broadcast-stream" "make-broadcast-stream") ", " (:ref "function/make-concatenated-stream" "make-concatenated-stream") ", " (:ref "function/make-string-input-stream" "make-string-input-stream") ", or " (:ref "function/make-string-output-stream" "make-string-output-stream") "."))))
(:entry "glossary/stream designator" :names ("stream designator") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/designator" "designator") " for a " (:term "glossary/stream" "stream") "; that is, an " (:term "glossary/object" "object") " that denotes a " (:term "glossary/stream" "stream") " and that is one of: " (:ref "constant-variable/t" "t") " " "(denoting " "the " (:term "glossary/value" "value") " of " (:ref "variable/*terminal-io*" "*terminal-io*") "), " (:ref "constant-variable/nil" "nil") " " "(denoting " "the " (:term "glossary/value" "value") " of " (:ref "variable/*debug-io*" "*standard-input*") " for " (:term "glossary/input" "input") " " (:term "glossary/stream designator" "stream designators") " or denoting " "the " (:term "glossary/value" "value") " of " (:ref "variable/*debug-io*" "*standard-output*") " for " (:term "glossary/output" "output") " " (:term "glossary/stream designator" "stream designators") "), or a " (:term "glossary/stream" "stream") " (denoting itself)."))))
(:entry "glossary/stream element type" :names ("stream element type") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " "(of a " (:term "glossary/stream" "stream") ") the " (:term "glossary/type" "type") " of data for which the " (:term "glossary/stream" "stream") " is specialized."))))
(:entry "glossary/stream variable" :names ("stream variable") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/variable" "variable") " whose " (:term "glossary/value" "value") " must be a " (:term "glossary/stream" "stream") "."))))
(:entry "glossary/stream variable designator" :names ("stream variable designator") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/designator" "designator") " for a " (:term "glossary/stream variable" "stream variable") "; that is, a " (:term "glossary/symbol" "symbol") " that denotes a " (:term "glossary/stream variable" "stream variable") " and that is one of: " (:ref "constant-variable/t" "t") " " "(denoting " (:ref "variable/*terminal-io*" "*terminal-io*") "), " (:ref "constant-variable/nil" "nil") " " "(denoting " (:ref "variable/*debug-io*" "*standard-input*") " for " (:term "glossary/input" "input") " " (:term "glossary/stream variable designator" "stream variable designators") " or denoting " (:ref "variable/*debug-io*" "*standard-output*") " for " (:term "glossary/output" "output") " " (:term "glossary/stream variable designator" "stream variable designators") "), or some other " (:term "glossary/symbol" "symbol") " (denoting itself)."))))
(:entry "glossary/string" :names ("string") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a specialized " (:term "glossary/vector" "vector") " that is " "of " (:term "glossary/type" "type") " " (:ref "system-class/string" "string") ", and whose elements are " "of " (:term "glossary/type" "type") " " (:ref "system-class/character" "character") " or a " (:term "glossary/subtype" "subtype") " of " (:term "glossary/type" "type") " " (:ref "system-class/character" "character") "."))))
(:entry "glossary/string designator" :names ("string designator") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/designator" "designator") " for a " (:term "glossary/string" "string") "; that is, an " (:term "glossary/object" "object") " that denotes a " (:term "glossary/string" "string") " and that is one of: a " (:term "glossary/character" "character") " (denoting a " (:term "glossary/singleton" "singleton") " " (:term "glossary/string" "string") " that has the " (:term "glossary/character" "character") " as its only " (:term "glossary/element" "element") "), a " (:term "glossary/symbol" "symbol") " (denoting the " (:term "glossary/string" "string") " that is its " (:term "glossary/name" "name") "), or a " (:term "glossary/string" "string") " (denoting itself). " " The intent is that this term be consistent with the behavior of " (:ref "function/string" "string") "; " (:term "glossary/implementation" "implementations") " that extend " (:ref "function/string" "string") " must extend the meaning of this term in a compatible way."))))
(:entry "glossary/string equal" :names ("string equal") :kind :glossary-term :kind-name "Glossary Term" :summary "adj." :sections (("Definition" (:p (:i "adj.") " " " the " (:term "glossary/same" "same") " under " (:ref "function/string=" "string-equal") "."))))
(:entry "glossary/string stream" :names ("string stream") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/stream" "stream") " " "of " (:term "glossary/type" "type") " " (:ref "system-class/string-stream" "string-stream") "."))))
(:entry "glossary/structure" :names ("structure") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " an " (:term "glossary/object" "object") " " "of " (:term "glossary/type" "type") " " (:ref "class/structure-object" "structure-object") "."))))
(:entry "glossary/structure class" :names ("structure class") :kind :glossary-term :kind-name "Glossary Term" :summary "a class that is a generalized instance of class structure-class." :sections (("Definition" (:p (:i "n.")) (:p "a " (:term "glossary/class" "class") " that is a " (:term "glossary/generalized instance" "generalized instance") " " "of " (:term "glossary/class" "class") " " (:ref "system-class/structure-class" "structure-class") "."))))
(:entry "glossary/structure name" :names ("structure name") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/name" "name") " defined with " (:ref "macro/defstruct" "defstruct") ". Usually, such a " (:term "glossary/type" "type") " is also a " (:term "glossary/structure class" "structure class") ",") (:p "but there may be " (:term "glossary/implementation-dependent" "implementation-dependent") " situations in which this is not so, if the " (:code ":type") " option to " (:ref "macro/defstruct" "defstruct") " is used."))))
(:entry "glossary/style warning" :names ("style warning") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/condition" "condition") " " "of " (:term "glossary/type" "type") " " (:ref "condition-type/style-warning" "style-warning") "."))))
(:entry "glossary/subclass" :names ("subclass") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/class" "class") " that " (:term "glossary/inherit" "inherits") " from another " (:term "glossary/class" "class") ", called a " (:term "glossary/superclass" "superclass") ". (No " (:term "glossary/class" "class") " is a " (:term "glossary/subclass" "subclass") " of itself.)"))))
(:entry "glossary/subexpression" :names ("subexpression") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " "(of an " (:term "glossary/expression" "expression") ") an " (:term "glossary/expression" "expression") " that is contained within the " (:term "glossary/expression" "expression") ". (In fact, the state of being a " (:term "glossary/subexpression" "subexpression") " is not an attribute of the " (:term "glossary/subexpression" "subexpression") ", but really an attribute of the containing " (:term "glossary/expression" "expression") " since the " (:term "glossary/same" "same") " " (:term "glossary/object" "object") " can at once be a " (:term "glossary/subexpression" "subexpression") " in one context, and not in another.)"))))
(:entry "glossary/subform" :names ("subform") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " "(of a " (:term "glossary/form" "form") ") an " (:term "glossary/expression" "expression") " that is a " (:term "glossary/subexpression" "subexpression") " of the " (:term "glossary/form" "form") ", and which by virtue of its position in that " (:term "glossary/form" "form") " is also a " (:term "glossary/form" "form") ". " "“" (:code "(f x)") " and " (:code "x") ", but not " (:code "exit") ", are subforms of " (:code "(return-from exit (f x))") ".”"))))
(:entry "glossary/subrepertoire" :names ("subrepertoire") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a subset of a " (:term "glossary/repertoire" "repertoire") "."))))
(:entry "glossary/subtype" :names ("subtype") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/type" "type") " whose membership is the same as or a proper subset of the membership of another " (:term "glossary/type" "type") ", called a " (:term "glossary/supertype" "supertype") ". (Every " (:term "glossary/type" "type") " is a " (:term "glossary/subtype" "subtype") " of itself.)"))))
(:entry "glossary/superclass" :names ("superclass") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/class" "class") " from which another " (:term "glossary/class" "class") " (called a " (:term "glossary/subclass" "subclass") ") " (:term "glossary/inherit" "inherits") ". (No " (:term "glossary/class" "class") " is a " (:term "glossary/superclass" "superclass") " of itself.) " "See " (:term "glossary/subclass" "subclass") "."))))
(:entry "glossary/supertype" :names ("supertype") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/type" "type") " whose membership is the same as or a proper superset of the membership of another " (:term "glossary/type" "type") ", called a " (:term "glossary/subtype" "subtype") ". (Every " (:term "glossary/type" "type") " is a " (:term "glossary/supertype" "supertype") " of itself.) " "See " (:term "glossary/subtype" "subtype") "."))))
(:entry "glossary/supplied-p parameter" :names ("supplied-p parameter") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/parameter" "parameter") " which recieves its " (:term "glossary/generalized boolean" "generalized boolean") " value implicitly due to the presence or absence of an " (:term "glossary/argument" "argument") " corresponding to another " (:term "glossary/parameter" "parameter") " (such as an " (:term "glossary/optional parameter" "optional parameter") " or a " (:term "glossary/rest parameter" "rest parameter") "). " "See " (:secref "OrdinaryLambdaLists" "Section 3.4.1 (Ordinary Lambda Lists)") "."))))
(:entry "glossary/symbol" :names ("symbol") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " an " (:term "glossary/object" "object") " " "of " (:term "glossary/type" "type") " " (:ref "system-class/symbol" "symbol") "."))))
(:entry "glossary/symbol macro" :names ("symbol macro") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/symbol" "symbol") " that stands for another " (:term "glossary/form" "form") ". " "See the " (:term "glossary/macro" "macro") " " (:ref "special-operator/symbol-macrolet" "symbol-macrolet") "."))))
(:entry "glossary/symbol name designator" :names ("symbol name designator") :kind :glossary-term :kind-name "Glossary Term" :sections (("Definition" (:p (:i "n.")))))
(:entry "glossary/synonym stream" :names ("synonym stream") :kind :glossary-term :kind-name "Glossary Term" :summary "a stream of type synonym-stream, which is consequently a stream that is an alias for another stream, which is the value of a dynamic variable whose name is the synonym stream symbol of the synonym…" :sections (("Definition" (:p (:i "n.")) (:list (:item (:label "1.") (:p "a " (:term "glossary/stream" "stream") " " "of " (:term "glossary/type" "type") " " (:ref "system-class/synonym-stream" "synonym-stream") ", which is consequently a " (:term "glossary/stream" "stream") " that is an alias for another " (:term "glossary/stream" "stream") ", which is the " (:term "glossary/value" "value") " of a " (:term "glossary/dynamic variable" "dynamic variable") " whose " (:term "glossary/name" "name") " is the " (:term "glossary/synonym stream symbol" "synonym stream symbol") " of the " (:term "glossary/synonym stream" "synonym stream") ". " "See the " (:term "glossary/function" "function") " " (:ref "function/make-synonym-stream" "make-synonym-stream") ".")) (:item (:label "2.") (:p "(to a " (:term "glossary/stream" "stream") ") a " (:term "glossary/synonym stream" "synonym stream") " which has the " (:term "glossary/stream" "stream") " as the " (:term "glossary/value" "value") " of its " (:term "glossary/synonym stream symbol" "synonym stream symbol") ".")) (:item (:label "3.") (:p "(to a " (:term "glossary/symbol" "symbol") ") a " (:term "glossary/synonym stream" "synonym stream") " which has the " (:term "glossary/symbol" "symbol") " as its " (:term "glossary/synonym stream symbol" "synonym stream symbol") "."))))))
(:entry "glossary/synonym stream symbol" :names ("synonym stream symbol") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " "(of a " (:term "glossary/synonym stream" "synonym stream") ") the " (:term "glossary/symbol" "symbol") " which names the " (:term "glossary/dynamic variable" "dynamic variable") " which has as its " (:term "glossary/value" "value") " another " (:term "glossary/stream" "stream") " for which the " (:term "glossary/synonym stream" "synonym stream") " is an alias."))))
(:entry "glossary/syntax type" :names ("syntax type") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " "(of a " (:term "glossary/character" "character") ") one of several classifications, enumerated in " (:secref "PossibleSyntaxTypes" "Figure~2--6") ", that are used for dispatch during parsing by the " (:term "glossary/lisp reader" "Lisp reader") ". " "See " (:secref "CharacterSyntaxTypes" "Section 2.1.4 (Character Syntax Types)") "."))))
(:entry "glossary/system class" :names ("system class") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/class" "class") " that may be " "of " (:term "glossary/type" "type") " " (:ref "system-class/built-in-class" "built-in-class") " in a " (:term "glossary/conforming implementation" "conforming implementation") " and hence cannot be inherited by " (:term "glossary/class" "classes") " defined by " (:term "glossary/conforming program" "conforming programs") "."))))
(:entry "glossary/system code" :names ("system code") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " " (:term "glossary/code" "code") " supplied by the " (:term "glossary/implementation" "implementation") " to implement this specification (" (:i "e.g.") ", " "the definition of " (:ref "function/mapc" "mapcar") ") or generated automatically in support of this specification (" (:i "e.g.") ", " "during method combination); that is, " (:term "glossary/code" "code") " that is not " (:term "glossary/programmer code" "programmer code") "."))))
(:entry "glossary/system stream variable" :names ("system stream variable") :kind :glossary-term :kind-name "Glossary Term" :sections (("Definition" (:p (:i "n.")))))
(:entry "glossary/t" :names ("t") :kind :glossary-term :kind-name "Glossary Term" :summary "a." :sections (("Definition" (:p (:i "n.")) (:list (:item (:label "1.") (:p "a. the " (:term "glossary/boolean" "boolean") " representing true. b. the canonical " (:term "glossary/generalized boolean" "generalized boolean") " representing true. (Although any " (:term "glossary/object" "object") " other than " (:ref "constant-variable/nil" "nil") " " "is considered " (:term "glossary/true" "true") " as a " (:term "glossary/generalized boolean" "generalized boolean") ", " (:code "t") " is generally used when there is no special reason to prefer one such " (:term "glossary/object" "object") " over another.)")) (:item (:label "2.") (:p "the " (:term "glossary/name" "name") " of the " (:term "glossary/type" "type") " to which all " (:term "glossary/object" "objects") " belong—the " (:term "glossary/supertype" "supertype") " of all " (:term "glossary/type" "types") " (including itself).")) (:item (:label "3.") (:p "the " (:term "glossary/name" "name") " of the " (:term "glossary/superclass" "superclass") " of all " (:term "glossary/class" "classes") " except itself."))))))
(:entry "glossary/tag" :names ("tag") :kind :glossary-term :kind-name "Glossary Term" :sections (("Definition" (:p (:i "n.")) (:list (:item (:label "1.") (:p "a " (:term "glossary/catch tag" "catch tag") ".")) (:item (:label "2.") (:p "a " (:term "glossary/go tag" "go tag") "."))))))
(:entry "glossary/tail" :names ("tail") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " "(of a " (:term "glossary/list" "list") ") an " (:term "glossary/object" "object") " that is the " (:term "glossary/same" "same") " as either some " (:term "glossary/cons" "cons") " which makes up that " (:term "glossary/list" "list") " or the " (:term "glossary/atom" "atom") " (if any) which terminates the " (:term "glossary/list" "list") ". " "“The empty list is a tail of every proper list.”"))))
(:entry "glossary/target" :names ("target") :kind :glossary-term :kind-name "Glossary Term" :summary "(of a constructed stream) a constituent of the constructed stream." :sections (("Definition" (:p (:i "n.")) (:list (:item (:label "1.") (:p "(of a " (:term "glossary/constructed stream" "constructed stream") ") a " (:term "glossary/constituent" "constituent") " of the " (:term "glossary/constructed stream" "constructed stream") ". " "“The target of a synonym stream is the value of its synonym stream symbol.”")) (:item (:label "2.") (:p "(of a " (:term "glossary/displaced array" "displaced array") ") the " (:term "glossary/array" "array") " to which the " (:term "glossary/displaced array" "displaced array") " is displaced. (In the case of a chain of " (:term "glossary/constructed stream" "constructed streams") " or " (:term "glossary/displaced array" "displaced arrays") ", the unqualified term “" (:term "glossary/target" "target") "” always refers to the immediate " (:term "glossary/target" "target") " of the first item in the chain, not the immediate target of the last item.)"))))))
(:entry "glossary/terminal i/o" :names ("terminal I/O") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " the " (:term "glossary/bidirectional" "bidirectional") " " (:term "glossary/stream" "stream") " that is the " (:term "glossary/value" "value") " of " "the " (:term "glossary/variable" "variable") " " (:ref "variable/*terminal-io*" "*terminal-io*") "."))))
(:entry "glossary/terminating" :names ("terminating") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " "(of a " (:term "glossary/macro character" "macro character") ") being such that, if it appears while parsing a token, it terminates that token. " "See " (:secref "ReaderAlgorithm" "Section 2.2 (Reader Algorithm)") "."))))
(:entry "glossary/tertiary value" :names ("tertiary value") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " "(of " (:term "glossary/value" "values") " resulting from the " (:term "glossary/evaluation" "evaluation") " of a " (:term "glossary/form" "form") ") the third " (:term "glossary/value" "value") ", if any, or else " (:ref "constant-variable/nil" "nil") " " "if there are fewer than three " (:term "glossary/value" "values") "."))))
(:entry "glossary/throw" :names ("throw") :kind :glossary-term :kind-name "Glossary Term" :summary "v." :sections (("Definition" (:p (:i "v.") " " " to transfer control and " (:term "glossary/value" "values") " to a " (:term "glossary/catch" "catch") ". " "See the " (:term "glossary/special operator" "special operator") " " (:ref "special-operator/throw" "throw") "."))))
(:entry "glossary/tilde" :names ("tilde") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " the " (:term "glossary/standard character" "standard character") " that is called “tilde” (" (:code "~") "). " "See " (:secref "StdCharsThree" "Figure~2--5") "."))))
(:entry "glossary/time" :names ("time") :kind :glossary-term :kind-name "Glossary Term" :summary "a representation of a point (absolute time) or an interval (relative time) on a time line." :sections (("Definition" (:p "a representation of a point (" (:term "glossary/absolute" "absolute") " " (:term "glossary/time" "time") ") or an interval (" (:term "glossary/relative" "relative") " " (:term "glossary/time" "time") ") on a time line. " "See " (:term "glossary/decoded time" "decoded time") ", " (:term "glossary/internal time" "internal time") ", and " (:term "glossary/universal time" "universal time") "."))))
(:entry "glossary/time zone" :names ("time zone") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/rational" "rational") " multiple of " (:code "1/3600") " between " (:code "-24") " (inclusive) and " (:code "24") " (inclusive) that represents a time zone as a number of hours offset from Greenwich Mean Time. Time zone values increase with motion to the west, so Massachusetts, U.S.A. is in time zone " (:code "5") ", California, U.S.A. is time zone " (:code "8") ", and Moscow, Russia is time zone " (:term nil "-3") ".") (:p "(When “daylight savings time” is separately represented as an " (:term "glossary/argument" "argument") " or " (:term "glossary/return value" "return value") ", the " (:term "glossary/time zone" "time zone") " that accompanies it does not depend on whether daylight savings time is in effect.)"))))
(:entry "glossary/token" :names ("token") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a textual representation for a " (:term "glossary/number" "number") " or a " (:term "glossary/symbol" "symbol") ". " "See " (:secref "InterpOfTokens" "Section 2.3 (Interpretation of Tokens)") "."))))
(:entry "glossary/top level form" :names ("top level form") :kind :glossary-term :kind-name "Glossary Term" :summary "a form which is processed specially by compile-file for the purposes of enabling compile time evaluation of that form." :sections (("Definition" (:p (:i "n.")) (:p "a " (:term "glossary/form" "form") " which is processed specially by " (:ref "function/compile-file" "compile-file") " for the purposes of enabling " (:term "glossary/compile time" "compile time") " " (:term "glossary/evaluation" "evaluation") " of that " (:term "glossary/form" "form") ". " (:term "glossary/top level form" "Top level forms") " include those " (:term "glossary/form" "forms") " which are not " (:term "glossary/subform" "subforms") " of any other " (:term "glossary/form" "form") ", and certain other cases. " "See " (:secref "TopLevelForms" "Section 3.2.3.1 (Processing of Top Level Forms)") "."))))
(:entry "glossary/trace output" :names ("trace output") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " the " (:term "glossary/output" "output") " " (:term "glossary/stream" "stream") " which is the " (:term "glossary/value" "value") " of the " (:term "glossary/dynamic variable" "dynamic variable") " " (:ref "variable/*debug-io*" "*trace-output*") "."))))
(:entry "glossary/tree" :names ("tree") :kind :glossary-term :kind-name "Glossary Term" :summary "a binary recursive data structure made up of conses and atoms:" :sections (("Definition" (:p (:i "n.")) (:list (:item (:label "1.") (:p "a binary recursive data structure made up of " (:term "glossary/cons" "conses") " and " (:term "glossary/atom" "atoms") ": the " (:term "glossary/cons" "conses") " are themselves also " (:term "glossary/tree" "trees") " (sometimes called “subtrees” or “branches”), and the " (:term "glossary/atom" "atoms") " are terminal nodes (sometimes called " (:term nil "leaves") "). Typically, the " (:term nil "leaves") " represent data while the branches establish some relationship among that data.")) (:item (:label "2.") (:p "in general, any recursive data structure that has some notion of “branches” and " (:term nil "leaves") "."))))))
(:entry "glossary/tree structure" :names ("tree structure") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " "(of a " (:term "glossary/tree" "tree") (:sense "1") ") the set of " (:term "glossary/cons" "conses") " that make up the " (:term "glossary/tree" "tree") ". Note that while the " (:term "glossary/car" "car") (:sense "1b") " component of each such " (:term "glossary/cons" "cons") " is part of the " (:term "glossary/tree structure" "tree structure") ", the " (:term "glossary/object" "objects") " that are the " (:term "glossary/car" "cars") (:sense "2") " of each " (:term "glossary/cons" "cons") " in the " (:term "glossary/tree" "tree") " are not themselves part of its " (:term "glossary/tree structure" "tree structure") " unless they are also " (:term "glossary/cons" "conses") "."))))
(:entry "glossary/true" :names ("true") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " any " (:term "glossary/object" "object") " that is not " (:term "glossary/false" "false") " and that is used to represent the success of a " (:term "glossary/predicate" "predicate") " test. " "See " (:term "glossary/t" "t") (:sense "1") "."))))
(:entry "glossary/truename" :names ("truename") :kind :glossary-term :kind-name "Glossary Term" :summary "the canonical filename of a file in the file system." :sections (("Definition" (:p (:i "n.")) (:list (:item (:label "1.") (:p "the canonical " (:term "glossary/filename" "filename") " of a " (:term "glossary/file" "file") " in the " (:term "glossary/file system" "file system") ". " "See " (:secref "Truenames" "Section 20.1.3 (Truenames)") ".")) (:item (:label "2.") (:p "a " (:term "glossary/pathname" "pathname") " representing a " (:term "glossary/truename" "truename") (:sense "1") "."))))))
(:entry "glossary/two-way stream" :names ("two-way stream") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/stream" "stream") " " "of " (:term "glossary/type" "type") " " (:ref "system-class/two-way-stream" "two-way-stream") ", which is a " (:term "glossary/bidirectional" "bidirectional") " " (:term "glossary/composite stream" "composite stream") " that receives its input from an associated " (:term "glossary/input" "input") " " (:term "glossary/stream" "stream") " and sends its output to an associated " (:term "glossary/output" "output") " " (:term "glossary/stream" "stream") "."))))
(:entry "glossary/type" :names ("type") :kind :glossary-term :kind-name "Glossary Term" :summary "a set of objects, usually with common structure, behavior, or purpose." :sections (("Definition" (:p (:i "n.")) (:list (:item (:label "1.") (:p "a set of " (:term "glossary/object" "objects") ", usually with common structure, behavior, or purpose. (Note that the expression “" (:i "X") " is of type " (:param "S" (:math (:sub "a"))) "” naturally implies that “" (:i "X") " is of type " (:param "S" (:math (:sub "b"))) "” if " (:param "S" (:math (:sub "a"))) " is a " (:term "glossary/subtype" "subtype") " of " (:param "S" (:math (:sub "b"))) ".)")) (:item (:label "2.") (:p "(immediately following the name of a " (:term "glossary/type" "type") ") a " (:term "glossary/subtype" "subtype") " of that " (:term "glossary/type" "type") ". " "“The type " (:ref "system-class/vector" "vector") " is an array type.”"))))))
(:entry "glossary/type declaration" :names ("type declaration") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/declaration" "declaration") " that asserts that every reference to a specified " (:term "glossary/binding" "binding") " within the scope of the " (:term "glossary/declaration" "declaration") " results in some " (:term "glossary/object" "object") " of the specified " (:term "glossary/type" "type") "."))))
(:entry "glossary/type equivalent" :names ("type equivalent") :kind :glossary-term :kind-name "Glossary Term" :summary "adj." :sections (("Definition" (:p (:i "adj.") " " "(of two " (:term "glossary/type" "types") " " (:math "X") " and " (:math "Y") ") having the same " (:term "glossary/element" "elements") "; that is, " (:math "X") " is a " (:term "glossary/subtype" "subtype") " of " (:math "Y") " and " (:math "Y") " is a " (:term "glossary/subtype" "subtype") " of " (:math "X") "."))))
(:entry "glossary/type expand" :names ("type expand") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " to fully expand a " (:term "glossary/type specifier" "type specifier") ", removing any references to " (:term "glossary/derived type" "derived types") ". (" "Common Lisp" " " "provides no program interface to cause this to occur, but the semantics of " "Common Lisp" " " "are such that every " (:term "glossary/implementation" "implementation") " must be able to do this internally, and some situations involving " (:term "glossary/type specifier" "type specifiers") " are most easily described in terms of a fully expanded " (:term "glossary/type specifier" "type specifier") ".)"))))
(:entry "glossary/type specifier" :names ("type specifier") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " an " (:term "glossary/expression" "expression") " that denotes a " (:term "glossary/type" "type") ". " "“The symbol " (:code "random-state") ", the list " (:code "(integer 3 5)") ", the list " (:code "(and list (not null))") ", and the class named " (:code "standard-class") " are type specifiers.”"))))
(:entry "glossary/unbound" :names ("unbound") :kind :glossary-term :kind-name "Glossary Term" :summary "adj." :sections (("Definition" (:p (:i "adj.") " " " not having an associated denotation in a " (:term "glossary/binding" "binding") ". " "See " (:term "glossary/bound" "bound") "."))))
(:entry "glossary/unbound variable" :names ("unbound variable") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/name" "name") " that is syntactically plausible as the name of a " (:term "glossary/variable" "variable") " but which is not " (:term "glossary/bound" "bound") " in the " (:term "glossary/variable" "variable") " " (:term "glossary/namespace" "namespace") "."))))
(:entry "glossary/undefined function" :names ("undefined function") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/name" "name") " that is syntactically plausible as the name of a " (:term "glossary/function" "function") " but which is not " (:term "glossary/bound" "bound") " in the " (:term "glossary/function" "function") " " (:term "glossary/namespace" "namespace") "."))))
(:entry "glossary/unintern" :names ("unintern") :kind :glossary-term :kind-name "Glossary Term" :summary "v.t." :sections (("Definition" (:p (:i "v.t.") " " "(a " (:term "glossary/symbol" "symbol") " in a " (:term "glossary/package" "package") ") to make the " (:term "glossary/symbol" "symbol") " not be " (:term "glossary/present" "present") " in that " (:term "glossary/package" "package") ". (The " (:term "glossary/symbol" "symbol") " might continue to be " (:term "glossary/accessible" "accessible") " by inheritance.)"))))
(:entry "glossary/uninterned" :names ("uninterned") :kind :glossary-term :kind-name "Glossary Term" :summary "adj." :sections (("Definition" (:p (:i "adj.") " " "(of a " (:term "glossary/symbol" "symbol") ") not " (:term "glossary/accessible" "accessible") " in any " (:term "glossary/package" "package") "; " (:i "i.e.") ", " "not " (:term "glossary/interned" "interned") (:sense "1") "."))))
(:entry "glossary/universal time" :names ("universal time") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " " (:term "glossary/time" "time") ", represented as a non-negative " (:term "glossary/integer" "integer") " number of seconds.") (:p (:term "glossary/absolute" "Absolute") " " (:term "glossary/universal time" "universal time") " is measured as an offset from the beginning of the year 1900 (ignoring " (:term "glossary/leap seconds" "leap seconds") "). " "See " (:secref "UniversalTime" "Section 25.1.4.2 (Universal Time)") "."))))
(:entry "glossary/unqualified method" :names ("unqualified method") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/method" "method") " with no " (:term "glossary/qualifier" "qualifiers") "."))))
(:entry "glossary/unregistered package" :names ("unregistered package") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/package" "package") " " (:term "glossary/object" "object") " that is not present in the " (:term "glossary/package registry" "package registry") ". An " (:term "glossary/unregistered package" "unregistered package") " has no " (:term "glossary/name" "name") "; " (:i "i.e.") ", " "its " (:term "glossary/name" "name") " is " (:ref "constant-variable/nil" "nil") ". " "See the " (:term "glossary/function" "function") " " (:ref "function/delete-package" "delete-package") "."))))
(:entry "glossary/unsafe" :names ("unsafe") :kind :glossary-term :kind-name "Glossary Term" :summary "adj." :sections (("Definition" (:p (:i "adj.") " " "(of " (:term "glossary/code" "code") ") not " (:term "glossary/safe" "safe") ". (Note that, unless explicitly specified otherwise, if a particular kind of error checking is guaranteed only in a " (:term "glossary/safe" "safe") " context, the same checking might or might not occur in that context if it were " (:term "glossary/unsafe" "unsafe") "; describing a context as " (:term "glossary/unsafe" "unsafe") " means that certain kinds of error checking are not reliably enabled but does not guarantee that error checking is definitely disabled.)"))))
(:entry "glossary/unsafe call" :names ("unsafe call") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/call" "call") " that is not a " (:term "glossary/safe call" "safe call") ". For more detailed information, " "see " (:secref "SafeAndUnsafeCalls" "Section 3.5.1.1 (Safe and Unsafe Calls)") "."))))
(:entry "glossary/upgrade" :names ("upgrade") :kind :glossary-term :kind-name "Glossary Term" :summary "v.t." :sections (("Definition" (:p (:i "v.t.") " " "(a declared " (:term "glossary/type" "type") " to an actual " (:term "glossary/type" "type") ")") (:list (:item (:label "1.") (:p "(when creating an " (:term "glossary/array" "array") ") to substitute an " (:term "glossary/actual array element type" "actual array element type") " for an " (:term "glossary/expressed array element type" "expressed array element type") " when choosing an appropriately " (:term "glossary/specialized" "specialized") " " (:term "glossary/array" "array") " representation. " "See the " (:term "glossary/function" "function") " " (:ref "function/upgraded-array-element-type" "upgraded-array-element-type") ".")) (:item (:label "2.") (:p "(when creating a " (:term "glossary/complex" "complex") ") to substitute an " (:term "glossary/actual complex part type" "actual complex part type") " for an " (:term "glossary/expressed complex part type" "expressed complex part type") " when choosing an appropriately " (:term "glossary/specialized" "specialized") " " (:term "glossary/complex" "complex") " representation. " "See the " (:term "glossary/function" "function") " " (:ref "function/upgraded-complex-part-type" "upgraded-complex-part-type") "."))))))
(:entry "glossary/upgraded array element type" :names ("upgraded array element type") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " "(of a " (:term "glossary/type" "type") ") a " (:term "glossary/type" "type") " that is a " (:term "glossary/supertype" "supertype") " of the " (:term "glossary/type" "type") " and that is used instead of the " (:term "glossary/type" "type") " whenever the " (:term "glossary/type" "type") " is used as an " (:term "glossary/array element type" "array element type") " for object creation or type discrimination. " "See " (:secref "ArrayUpgrading" "Section 15.1.2.1 (Array Upgrading)") "."))))
(:entry "glossary/upgraded complex part type" :names ("upgraded complex part type") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " "(of a " (:term "glossary/type" "type") ") a " (:term "glossary/type" "type") " that is a " (:term "glossary/supertype" "supertype") " of the " (:term "glossary/type" "type") " and that is used instead of the " (:term "glossary/type" "type") " whenever the " (:term "glossary/type" "type") " is used as a " (:term "glossary/complex part type" "complex part type") " for object creation or type discrimination. " "See the " (:term "glossary/function" "function") " " (:ref "function/upgraded-complex-part-type" "upgraded-complex-part-type") "."))))
(:entry "glossary/uppercase" :names ("uppercase") :kind :glossary-term :kind-name "Glossary Term" :summary "adj." :sections (("Definition" (:p (:i "adj.") " " "(of a " (:term "glossary/character" "character") ") being among " (:term "glossary/standard character" "standard characters") " corresponding to the capital letters " (:code "A") " through " (:code "Z") ", or being some other " (:term "glossary/implementation-defined" "implementation-defined") " " (:term "glossary/character" "character") " that is defined by the " (:term "glossary/implementation" "implementation") " to be " (:term "glossary/uppercase" "uppercase") ". " "See " (:secref "CharactersWithCase" "Section 13.1.4.3 (Characters With Case)") "."))))
(:entry "glossary/use" :names ("use") :kind :glossary-term :kind-name "Glossary Term" :summary "v.t." :sections (("Definition" (:p (:i "v.t.") " " "(a " (:term "glossary/package" "package") " " (:math "P" (:sub "1")) ") to " (:term "glossary/inherit" "inherit") " the " (:term "glossary/external symbol" "external symbols") " of " (:math "P" (:sub "1")) ". (If a package " (:math "P" (:sub "2")) " uses " (:math "P" (:sub "1")) ", the " (:term "glossary/external symbol" "external symbols") " of " (:math "P" (:sub "1")) " become " (:term "glossary/internal symbol" "internal symbols") " of " (:math "P" (:sub "2")) " unless they are explicitly " (:term "glossary/exported" "exported") ".) " "“The package " (:code "CL-USER") " uses the package " (:code "CL") ".”"))))
(:entry "glossary/use list" :names ("use list") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " "(of a " (:term "glossary/package" "package") ") a (possibly empty) " (:term "glossary/list" "list") " associated with each " (:term "glossary/package" "package") " which determines what other " (:term "glossary/package" "packages") " are currently being " (:term "glossary/use" "used") " by that " (:term "glossary/package" "package") "."))))
(:entry "glossary/user" :names ("user") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " an active entity, typically a human, that invokes or interacts with a " (:term "glossary/program" "program") " at run time, but that is not necessarily a " (:term "glossary/programmer" "programmer") "."))))
(:entry "glossary/valid array dimension" :names ("valid array dimension") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/fixnum" "fixnum") " suitable for use as an " (:term "glossary/array" "array") " " (:term "glossary/dimension" "dimension") ". Such a " (:term "glossary/fixnum" "fixnum") " must be greater than or equal to zero, and less than the " (:term "glossary/value" "value") " of " (:ref "constant-variable/array-dimension-limit" "array-dimension-limit") ". When multiple " (:term "glossary/array" "array") " " (:term "glossary/dimension" "dimensions") " are to be used together to specify a multi-dimensional " (:term "glossary/array" "array") ", there is also an implied constraint that the product of all of the " (:term "glossary/dimension" "dimensions") " be less than the " (:term "glossary/value" "value") " of " (:ref "constant-variable/array-total-size-limit" "array-total-size-limit") "."))))
(:entry "glossary/valid array index" :names ("valid array index") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " "(of an " (:term "glossary/array" "array") ") a " (:term "glossary/fixnum" "fixnum") " suitable for use as one of possibly several indices needed to name an " (:term "glossary/element" "element") " of the " (:term "glossary/array" "array") " according to a multi-dimensional Cartesian coordinate system. Such a " (:term "glossary/fixnum" "fixnum") " must be greater than or equal to zero, and must be less than the corresponding " (:term "glossary/dimension" "dimension") (:sense "1") " of the " (:term "glossary/array" "array") ". (Unless otherwise explicitly specified, the phrase “a " (:term "glossary/list" "list") " of " (:term nil "valid array indices") "” further implies that the " (:term "glossary/length" "length") " of the " (:term "glossary/list" "list") " must be the same as the " (:term "glossary/rank" "rank") " of the " (:term "glossary/array" "array") ".) " "“For a " (:code "2") " by " (:code "3") " array, valid array indices for the first dimension are " (:code "0") " and " (:code "1") ", and valid array indices for the second dimension are " (:code "0") ", " (:code "1") " and " (:code "2") ".”"))))
(:entry "glossary/valid array row-major index" :names ("valid array row-major index") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " "(of an " (:term "glossary/array" "array") ", which might have any number of " (:term "glossary/dimension" "dimensions") (:sense "2") ") a single " (:term "glossary/fixnum" "fixnum") " suitable for use in naming any " (:term "glossary/element" "element") " of the " (:term "glossary/array" "array") ", by viewing the array’s storage as a linear series of " (:term "glossary/element" "elements") " in row-major order. Such a " (:term "glossary/fixnum" "fixnum") " must be greater than or equal to zero, and less than the " (:term "glossary/array total size" "array total size") " of the " (:term "glossary/array" "array") "."))))
(:entry "glossary/valid fill pointer" :names ("valid fill pointer") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " "(of an " (:term "glossary/array" "array") ") a " (:term "glossary/fixnum" "fixnum") " suitable for use as a " (:term "glossary/fill pointer" "fill pointer") " for the " (:term "glossary/array" "array") ". Such a " (:term "glossary/fixnum" "fixnum") " must be greater than or equal to zero, and less than or equal to the " (:term "glossary/array total size" "array total size") " of the " (:term "glossary/array" "array") ".") (:p (:note "KMP: The “valid pathname xxx” definitions were taken from text found in make-pathname, but look wrong to me. I’ll fix them later.")))))
(:entry "glossary/valid logical pathname host" :names ("valid logical pathname host") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/string" "string") " that has been defined as the name of a " (:term "glossary/logical host" "logical host") ". " "See the " (:term "glossary/function" "function") " " (:ref "function/load-logical-pathname-translations" "load-logical-pathname-translations") "."))))
(:entry "glossary/valid pathname device" :names ("valid pathname device") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/string" "string") ", " (:ref "constant-variable/nil" "nil") ", " (:code ":unspecific") ", or some other " (:term "glossary/object" "object") " defined by the " (:term "glossary/implementation" "implementation") " to be a " (:term "glossary/valid pathname device" "valid pathname device") "."))))
(:entry "glossary/valid pathname directory" :names ("valid pathname directory") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/string" "string") ", a " (:term "glossary/list" "list") " of " (:term "glossary/string" "strings") ", " (:ref "constant-variable/nil" "nil") ", " " " (:code ":wild") ", " " " (:code ":unspecific") ", or some other " (:term "glossary/object" "object") " defined by the " (:term "glossary/implementation" "implementation") " to be a " (:term nil "valid directory component") "."))))
(:entry "glossary/valid pathname host" :names ("valid pathname host") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/valid physical pathname host" "valid physical pathname host") " or a " (:term "glossary/valid logical pathname host" "valid logical pathname host") "."))))
(:entry "glossary/valid pathname name" :names ("valid pathname name") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/string" "string") ", " (:ref "constant-variable/nil" "nil") ", " (:code ":wild") ", " (:code ":unspecific") ", or some other " (:term "glossary/object" "object") " defined by the " (:term "glossary/implementation" "implementation") " to be a " (:term "glossary/valid pathname name" "valid pathname name") "."))))
(:entry "glossary/valid pathname type" :names ("valid pathname type") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/string" "string") ", " (:ref "constant-variable/nil" "nil") ", " (:code ":wild") ", " (:code ":unspecific") "."))))
(:entry "glossary/valid pathname version" :names ("valid pathname version") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a non-negative " (:term "glossary/integer" "integer") ", or one of " (:code ":wild") ", " (:code ":newest") ", " (:code ":unspecific") ", or " (:ref "constant-variable/nil" "nil") ".") (:p "The symbols " (:code ":oldest") ", " (:code ":previous") ", and " (:code ":installed") " are " (:term "glossary/semi-standard" "semi-standard") " special version symbols."))))
(:entry "glossary/valid physical pathname host" :names ("valid physical pathname host") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " any of a " (:term "glossary/string" "string") ", a " (:term "glossary/list" "list") " of " (:term "glossary/string" "strings") ", or the symbol " (:code ":unspecific") ", that is recognized by the implementation as the name of a host."))))
(:entry "glossary/valid sequence index" :names ("valid sequence index") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " "(of a " (:term "glossary/sequence" "sequence") ") an " (:term "glossary/integer" "integer") " suitable for use to name an " (:term "glossary/element" "element") " of the " (:term "glossary/sequence" "sequence") ". Such an " (:term "glossary/integer" "integer") " must be greater than or equal to zero, and must be less than the " (:term "glossary/length" "length") " of the " (:term "glossary/sequence" "sequence") ". " " (If the " (:term "glossary/sequence" "sequence") " is an " (:term "glossary/array" "array") ", the " (:term "glossary/valid sequence index" "valid sequence index") " is further constrained to be a " (:term "glossary/fixnum" "fixnum") ".)"))))
(:entry "glossary/value" :names ("value") :kind :glossary-term :kind-name "Glossary Term" :summary "a." :sections (("Definition" (:p (:i "n.")) (:list (:item (:label "1.") (:p "a. one of possibly several " (:term "glossary/object" "objects") " that are the result of an " (:term "glossary/evaluation" "evaluation") ". b. (in a situation where exactly one value is expected from the " (:term "glossary/evaluation" "evaluation") " of a " (:term "glossary/form" "form") ") the " (:term "glossary/primary value" "primary value") " returned by the " (:term "glossary/form" "form") ". c. (of " (:term "glossary/form" "forms") " in an " (:term "glossary/implicit progn" "implicit progn") ") one of possibly several " (:term "glossary/object" "objects") " that result from the " (:term "glossary/evaluation" "evaluation") " of the last " (:term "glossary/form" "form") ", or " (:ref "constant-variable/nil" "nil") " " "if there are no " (:term "glossary/form" "forms") ".")) (:item (:label "2.") (:p "an " (:term "glossary/object" "object") " associated with a " (:term "glossary/name" "name") " in a " (:term "glossary/binding" "binding") ".")) (:item (:label "3.") (:p "(of a " (:term "glossary/symbol" "symbol") ") the " (:term "glossary/value" "value") " of the " (:term "glossary/dynamic variable" "dynamic variable") " named by that symbol.")) (:item (:label "4.") (:p "an " (:term "glossary/object" "object") " associated with a " (:term "glossary/key" "key") " in an " (:term "glossary/association list" "association list") ", a " (:term "glossary/property list" "property list") ", or a " (:term "glossary/hash table" "hash table") "."))))))
(:entry "glossary/value cell" :names ("value cell") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " (:i "Trad.") " " "(of a " (:term "glossary/symbol" "symbol") ") The " (:term "glossary/place" "place") " which holds the " (:term "glossary/value" "value") ", if any, of the " (:term "glossary/dynamic variable" "dynamic variable") " named by that " (:term "glossary/symbol" "symbol") ", and which is " (:term "glossary/access" "accessed") " by " (:ref "accessor/symbol-value" "symbol-value") ". " "See " (:term "glossary/cell" "cell") "."))))
(:entry "glossary/variable" :names ("variable") :kind :glossary-term :kind-name "Glossary Term" :summary "a binding in the “variable” namespace." :sections (("Definition" (:p (:i "n.")) (:p "a " (:term "glossary/binding" "binding") " in the “variable” " (:term "glossary/namespace" "namespace") ". " "See " (:secref "SymbolsAsForms" "Section 3.1.2.1.1 (Symbols as Forms)") "."))))
(:entry "glossary/vector" :names ("vector") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a one-dimensional " (:term "glossary/array" "array") "."))))
(:entry "glossary/vertical-bar" :names ("vertical-bar") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " the " (:term "glossary/standard character" "standard character") " that is called “vertical bar” (" (:code "|") "). " "See " (:secref "StdCharsThree" "Figure~2--5") "."))))
(:entry "glossary/whitespace" :names ("whitespace") :kind :glossary-term :kind-name "Glossary Term" :summary "one or more characters that are either the graphic character #\\Space or else non-graphic characters such as #\\Newline that only move the print position." :sections (("Definition" (:p (:i "n.")) (:list (:item (:label "1.") (:p "one or more " (:term "glossary/character" "characters") " that are either the " (:term "glossary/graphic" "graphic") " " (:term "glossary/character" "character") " " (:code "#" "\\" "Space") " or else " (:term "glossary/non-graphic" "non-graphic") " characters such as " (:code "#" "\\" "Newline") " that only move the print position.")) (:item (:label "2.") (:p "a. " (:i "n.") " " "the " (:term "glossary/syntax type" "syntax type") " of a " (:term "glossary/character" "character") " that is a " (:term "glossary/token" "token") " separator. For details, " "see " (:secref "WhitespaceChars" "Section 2.1.4.7 ({}Whitespace Characters)") ". b. " (:i "adj.") " " "(of a " (:term "glossary/character" "character") ") having the " (:term "glossary/whitespace" "whitespace") (:sense "2a") " " (:term "glossary/syntax type" "syntax type") (:sense "2") ". c. " (:i "n.") " " "a " (:term "glossary/whitespace" "whitespace") (:sense "2b") " " (:term "glossary/character" "character") "."))))))
(:entry "glossary/wild" :names ("wild") :kind :glossary-term :kind-name "Glossary Term" :summary "(of a namestring) using an implementation-defined syntax for naming files, which might “match” any of possibly several possible filenames, and which can therefore be used to refer to the aggregate…" :sections (("Definition" (:p (:i "adj.")) (:list (:item (:label "1.") (:p "(of a " (:term "glossary/namestring" "namestring") ") using an " (:term "glossary/implementation-defined" "implementation-defined") " syntax for naming files, which might “match” any of possibly several possible " (:term "glossary/filename" "filenames") ", and which can therefore be used to refer to the aggregate of the " (:term "glossary/file" "files") " named by those " (:term "glossary/filename" "filenames") ".")) (:item (:label "2.") (:p "(of a " (:term "glossary/pathname" "pathname") ") a structured representation of a name which might “match” any of possibly several " (:term "glossary/pathname" "pathnames") ", and which can therefore be used to refer to the aggregate of the " (:term "glossary/file" "files") " named by those " (:term "glossary/pathname" "pathnames") ". The set of " (:term "glossary/wild" "wild") " " (:term "glossary/pathname" "pathnames") " includes, but is not restricted to, " (:term "glossary/pathname" "pathnames") " which have a component which is " (:code ":wild") ", or which have a directory component which contains " (:code ":wild") " or " (:code ":wild-inferors") ". " "See the " (:term "glossary/function" "function") " " (:ref "function/wild-pathname-p" "wild-pathname-p") "."))))))
(:entry "glossary/write" :names ("write") :kind :glossary-term :kind-name "Glossary Term" :summary "(a binding or slot or component) to change the value of the binding or slot." :sections (("Definition" (:p (:i "v.t.")) (:list (:item (:label "1.") (:p "(a " (:term "glossary/binding" "binding") " or " (:term "glossary/slot" "slot") " or component) to change the " (:term "glossary/value" "value") " of the " (:term "glossary/binding" "binding") " or " (:term "glossary/slot" "slot") ".")) (:item (:label "2.") (:p "(an " (:term "glossary/object" "object") " to a " (:term "glossary/stream" "stream") ") to output a representation of the " (:term "glossary/object" "object") " to the " (:term "glossary/stream" "stream") "."))))))
(:entry "glossary/writer" :names ("writer") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/function" "function") " that " (:term "glossary/write" "writes") (:sense "1") " a " (:term "glossary/variable" "variable") " or " (:term "glossary/slot" "slot") "."))))
(:entry "glossary/yield" :names ("yield") :kind :glossary-term :kind-name "Glossary Term" :summary "v.t." :sections (("Definition" (:p (:i "v.t.") " " "(" (:term "glossary/value" "values") ") to produce the " (:term "glossary/value" "values") " as the result of " (:term "glossary/evaluation" "evaluation") ". " "“The form " (:code "(+ 2 3)") " yields " (:code "5") ".”"))))
