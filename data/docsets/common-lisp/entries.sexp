(:entry "glossary/alphabetic" :names ("alphabetic") :kind :glossary-term :kind-name "Glossary Term" :summary "adj." :sections (("Definition" (:p (:i "n.") ", " (:i "adj.")) (:list (:item (:label "1.") (:p (:i "adj.") " " "(of a " (:term "glossary/character" "character") ") being one of the " (:term "glossary/standard character" "standard characters") " " (:code "A") " through " (:code "Z") " or " (:code "a") " through " (:code "z") ", or being any " (:term "glossary/implementation-defined" "implementation-defined") " character that has " (:term "glossary/case" "case") ", or being some other " (:term "glossary/graphic" "graphic") " " (:term "glossary/character" "character") " defined by the " (:term "glossary/implementation" "implementation") " to be " (:term "glossary/alphabetic" "alphabetic") (:sense "1") ".")) (:item (:label "2.") (:p "a. " (:i "n.") " " " one of several possible " (:term "glossary/constituent trait" "constituent traits") " of a " (:term "glossary/character" "character") ". For details, " "see " (:secref "ConstituentChars" "Section 2.1.4.1 (Constituent Characters)") " " "and " (:secref "ReaderAlgorithm" "Section 2.2 (Reader Algorithm)") ". b. " (:i "adj.") " " "(of a " (:term "glossary/character" "character") ") being a " (:term "glossary/character" "character") " that has " (:term "glossary/syntax type" "syntax type") " " (:term "glossary/constituent" "constituent") " in the " (:term "glossary/current readtable" "current readtable") " and that has the " (:term "glossary/constituent trait" "constituent trait") " " (:term "glossary/alphabetic" "alphabetic") (:sense "2a") ". " "See " (:secref "ConstituentTraitsOfStdChars" "Figure~2--8") "."))))))
