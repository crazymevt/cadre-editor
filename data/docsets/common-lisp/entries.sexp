(:entry "glossary/apply" :names ("apply") :kind :glossary-term :kind-name "Glossary Term" :summary "v.t." :sections (("Definition" (:p (:i "v.t.") " " "(a " (:term "glossary/function" "function") " to a " (:term "glossary/list" "list") ") to " (:term "glossary/call" "call") " the " (:term "glossary/function" "function") " with arguments that are the " (:term "glossary/element" "elements") " of the " (:term "glossary/list" "list") ". " "“Applying the function " (:ref "function/+" "+") " to a list of integers returns the sum of the elements of that list.”"))))
(:entry "glossary/argument" :names ("argument") :kind :glossary-term :kind-name "Glossary Term" :summary "(of a function) an object which is offered as data to the function when it is called." :sections (("Definition" (:p (:i "n.")) (:list (:item (:label "1.") (:p "(of a " (:term "glossary/function" "function") ") an " (:term "glossary/object" "object") " which is offered as data to the " (:term "glossary/function" "function") " when it is " (:term "glossary/call" "called") ".")) (:item (:label "2.") (:p "(of a " (:term "glossary/format control" "format control") ") a " (:term "glossary/format argument" "format argument") "."))))))
(:entry "glossary/argument evaluation order" :names ("argument evaluation order") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " the order in which " (:term "glossary/argument" "arguments") " are evaluated in a function call. " "“The argument evaluation order for Common Lisp is left to right.”" " " "See " (:secref "Evaluation" "Section 3.1 (Evaluation)") "."))))
(:entry "glossary/argument precedence order" :names ("argument precedence order") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " the order in which the " (:term "glossary/argument" "arguments") " to a " (:term "glossary/generic function" "generic function") " are considered when sorting the " (:term "glossary/applicable method" "applicable methods") " into precedence order."))))
(:entry "glossary/around method" :names ("around method") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/method" "method") " having the " (:term "glossary/qualifier" "qualifier") " " (:code ":around") "."))))
(:entry "glossary/array" :names ("array") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " an " (:term "glossary/object" "object") " " "of " (:term "glossary/type" "type") " " (:ref "system-class/array" "array") ", which serves as a container for other " (:term "glossary/object" "objects") " arranged in a Cartesian coordinate system."))))
(:entry "glossary/array element type" :names ("array element type") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " "(of an " (:term "glossary/array" "array") ")") (:list (:item (:label "1.") (:p "a " (:term "glossary/type" "type") " associated with the " (:term "glossary/array" "array") ", and of which all " (:term "glossary/element" "elements") " of the " (:term "glossary/array" "array") " are constrained to be members.")) (:item (:label "2.") (:p "the " (:term "glossary/actual array element type" "actual array element type") " of the " (:term "glossary/array" "array") ".")) (:item (:label "3.") (:p "the " (:term "glossary/expressed array element type" "expressed array element type") " of the " (:term "glossary/array" "array") "."))))))
(:entry "glossary/array total size" :names ("array total size") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " the total number of " (:term "glossary/element" "elements") " in an " (:term "glossary/array" "array") ", computed by taking the product of the " (:term "glossary/dimension" "dimensions") " of the " (:term "glossary/array" "array") ". (The size of a zero-dimensional " (:term "glossary/array" "array") " is therefore one.)"))))
(:entry "glossary/assign" :names ("assign") :kind :glossary-term :kind-name "Glossary Term" :summary "v.t." :sections (("Definition" (:p (:i "v.t.") " " "(a " (:term "glossary/variable" "variable") ") to change the " (:term "glossary/value" "value") " of the " (:term "glossary/variable" "variable") " in a " (:term "glossary/binding" "binding") " that has already been " (:term "glossary/establish" "established") ". " "See the " (:term "glossary/special operator" "special operator") " " (:ref "special-form/setq" "setq") "."))))
(:entry "glossary/association list" :names ("association list") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/list" "list") " of " (:term "glossary/cons" "conses") " representing an association of " (:term "glossary/key" "keys") " with " (:term "glossary/value" "values") ", where the " (:term "glossary/car" "car") " of each " (:term "glossary/cons" "cons") " is the " (:term "glossary/key" "key") " and the " (:term "glossary/cdr" "cdr") " is the " (:term "glossary/value" "value") " associated with that " (:term "glossary/key" "key") "."))))
(:entry "glossary/asterisk" :names ("asterisk") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " the " (:term "glossary/standard character" "standard character") " that is variously called “asterisk” or “star” (" (:code "*") "). " "See " (:secref "StdCharsThree" "Figure~2--5") "."))))
(:entry "glossary/at-sign" :names ("at-sign") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " the " (:term "glossary/standard character" "standard character") " that is variously called “commercial at” or “at sign” (" (:code "@") "). " "See " (:secref "StdCharsThree" "Figure~2--5") "."))))
(:entry "glossary/atom" :names ("atom") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " any " (:term "glossary/object" "object") " that is not a " (:term "glossary/cons" "cons") ". " "“A vector is an atom.”"))))
(:entry "glossary/atomic" :names ("atomic") :kind :glossary-term :kind-name "Glossary Term" :summary "adj." :sections (("Definition" (:p (:i "adj.") " " " being an " (:term "glossary/atom" "atom") ". " "“The number 3, the symbol " (:code "foo") ", and " (:ref "constant-variable/nil" "nil") " " "are atomic.”"))))
(:entry "glossary/atomic type specifier" :names ("atomic type specifier") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/type specifier" "type specifier") " that is " (:term "glossary/atomic" "atomic") ". For every " (:term "glossary/atomic type specifier" "atomic type specifier") ", " (:i "x") ", there is an equivalent " (:term "glossary/compound type specifier" "compound type specifier") " with no arguments supplied, " (:code "(" (:i "x") ")") "."))))
(:entry "glossary/attribute" :names ("attribute") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " "(of a " (:term "glossary/character" "character") ") a program-visible aspect of the " (:term "glossary/character" "character") ". The only " (:term "glossary/standardized" "standardized") " " (:term "glossary/attribute" "attribute") " of a " (:term "glossary/character" "character") " is its " (:term "glossary/code" "code") (:sense "2") ", but " (:term "glossary/implementation" "implementations") " are permitted to have additional " (:term "glossary/implementation-defined" "implementation-defined") " " (:term "glossary/attribute" "attributes") ". " "See " (:secref "CharacterAttributes" "Section 13.1.3 (Character Attributes)") ". " "“An implementation that support fonts might make font information an attribute of a character, while others might represent font information separately from characters.”"))))
(:entry "glossary/aux variable" :names ("aux variable") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/variable" "variable") " that occurs in the part of a " (:term "glossary/lambda list" "lambda list") " that was introduced by " (:code "&aux") ". Unlike all other " (:term "glossary/variable" "variables") " introduced by a " (:term nil "lambda-list") ", " (:term "glossary/aux variable" "aux variables") " are not " (:term "glossary/parameter" "parameters") "."))))
(:entry "glossary/auxiliary method" :names ("auxiliary method") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a member of one of two sets of " (:term "glossary/method" "methods") " (the set of " (:term "glossary/primary method" "primary methods") " is the other) that form an exhaustive partition of the set of " (:term "glossary/method" "methods") " on the " (:term "glossary/method" "method") "’s " (:term "glossary/generic function" "generic function") ". How these sets are determined is dependent on the " (:term "glossary/method combination" "method combination") " type; " "see " (:secref "IntroToMethods" "Section 7.6.2 (Introduction to Methods)") "."))))
(:entry "glossary/backquote" :names ("backquote") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " the " (:term "glossary/standard character" "standard character") " that is variously called “grave accent” or “backquote” (" (:code "`") "). " "See " (:secref "StdCharsThree" "Figure~2--5") "."))))
(:entry "glossary/backslash" :names ("backslash") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " the " (:term "glossary/standard character" "standard character") " that is variously called “reverse solidus” or “backslash” (" (:code "\\") "). " "See " (:secref "StdCharsThree" "Figure~2--5") "."))))
(:entry "glossary/base character" :names ("base character") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/character" "character") " " " " "of " (:term "glossary/type" "type") " " (:ref "type/base-char" "base-char") "."))))
(:entry "glossary/base string" :names ("base string") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/string" "string") " " "of " (:term "glossary/type" "type") " " (:ref "type/base-string" "base-string") "."))))
(:entry "glossary/before method" :names ("before method") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/method" "method") " having the " (:term "glossary/qualifier" "qualifier") " " (:code ":before") "."))))
(:entry "glossary/bidirectional" :names ("bidirectional") :kind :glossary-term :kind-name "Glossary Term" :summary "adj." :sections (("Definition" (:p (:i "adj.") " " "(of a " (:term "glossary/stream" "stream") ") being both an " (:term "glossary/input" "input") " " (:term "glossary/stream" "stream") " and an " (:term "glossary/output" "output") " " (:term "glossary/stream" "stream") "."))))
(:entry "glossary/binary" :names ("binary") :kind :glossary-term :kind-name "Glossary Term" :summary "(of a stream) being a stream that has an element type that is a subtype of type integer." :sections (("Definition" (:p (:i "adj.")) (:list (:item (:label "1.") (:p "(of a " (:term "glossary/stream" "stream") ") being a " (:term "glossary/stream" "stream") " that has an " (:term "glossary/element type" "element type") " that is a " (:term "glossary/subtype" "subtype") " of " (:term "glossary/type" "type") " " (:ref "system-class/integer" "integer") ". The most fundamental operation on a " (:term "glossary/binary" "binary") " " (:term "glossary/input" "input") " " (:term "glossary/stream" "stream") " is " (:ref "function/read-byte" "read-byte") " and on a " (:term "glossary/binary" "binary") " " (:term "glossary/output" "output") " " (:term "glossary/stream" "stream") " is " (:ref "function/write-byte" "write-byte") ". " "See " (:term "glossary/character" "character") ".")) (:item (:label "2.") (:p "(of a " (:term "glossary/file" "file") ") having been created by opening a " (:term "glossary/binary" "binary") " " (:term "glossary/stream" "stream") ". (It is " (:term "glossary/implementation-dependent" "implementation-dependent") " whether this is an detectable aspect of the " (:term "glossary/file" "file") ", or whether any given " (:term "glossary/character" "character") " " (:term "glossary/file" "file") " can be treated as a " (:term "glossary/binary" "binary") " " (:term "glossary/file" "file") ".)"))))))
(:entry "glossary/bind" :names ("bind") :kind :glossary-term :kind-name "Glossary Term" :summary "v.t." :sections (("Definition" (:p (:i "v.t.") " " "(a " (:term "glossary/variable" "variable") ") to establish a " (:term "glossary/binding" "binding") " for the " (:term "glossary/variable" "variable") "."))))
(:entry "glossary/binding" :names ("binding") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " an association between a " (:term "glossary/name" "name") " and that which the " (:term "glossary/name" "name") " denotes. " "“A lexical binding is a lexical association between a name and its value.”") (:p "When the term " (:term "glossary/binding" "binding") " is qualified by the name of a " (:term "glossary/namespace" "namespace") ", such as “variable” or “function,” it restricts the binding to the indicated namespace, as in: " "“" (:ref "special-operator/let" "let") " establishes variable bindings.”" " or " "“" (:ref "special-operator/let" "let") " establishes bindings of variables.”"))))
(:entry "glossary/bit" :names ("bit") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " an " (:term "glossary/object" "object") " " "of " (:term "glossary/type" "type") " " (:ref "type/bit" "bit") "; that is, the " (:term "glossary/integer" "integer") " " (:code "0") " or the " (:term "glossary/integer" "integer") " " (:code "1") "."))))
(:entry "glossary/bit array" :names ("bit array") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a specialized " (:term "glossary/array" "array") " that is of " (:term "glossary/type" "type") " " (:code "(array bit)") ", and whose elements are " "of " (:term "glossary/type" "type") " " (:ref "type/bit" "bit") "."))))
(:entry "glossary/bit vector" :names ("bit vector") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a specialized " (:term "glossary/vector" "vector") " that is " "of " (:term "glossary/type" "type") " " (:ref "system-class/bit-vector" "bit-vector") ", and whose elements are " "of " (:term "glossary/type" "type") " " (:ref "type/bit" "bit") "."))))
(:entry "glossary/bit-wise logical operation specifier" :names ("bit-wise logical operation specifier") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " an " (:term "glossary/object" "object") " which names one of the sixteen possible bit-wise logical operations that can be performed by the " (:ref "function/boole" "boole") " function, and which is the " (:term "glossary/value" "value") " of exactly one of the " (:term "glossary/constant variable" "constant variables") " " (:ref "constant-variable/boole-1" "boole-clr") ", " (:ref "constant-variable/boole-1" "boole-set") ", " (:ref "constant-variable/boole-1" "boole-1") ", " (:ref "constant-variable/boole-1" "boole-2") ", " (:ref "constant-variable/boole-1" "boole-c1") ", " (:ref "constant-variable/boole-1" "boole-c2") ", " (:ref "constant-variable/boole-1" "boole-and") ", " (:ref "constant-variable/boole-1" "boole-ior") ", " (:ref "constant-variable/boole-1" "boole-xor") ", " (:ref "constant-variable/boole-1" "boole-eqv") ", " (:ref "constant-variable/boole-1" "boole-nand") ", " (:ref "constant-variable/boole-1" "boole-nor") ", " (:ref "constant-variable/boole-1" "boole-andc1") ", " (:ref "constant-variable/boole-1" "boole-andc2") ", " (:ref "constant-variable/boole-1" "boole-orc1") ", or " (:ref "constant-variable/boole-1" "boole-orc2") "."))))
(:entry "glossary/block" :names ("block") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a named lexical " (:term "glossary/exit point" "exit point") ", " (:term "glossary/establish" "established") " explicitly by " (:ref "special-operator/block" "block") " or implicitly by " (:term "glossary/operator" "operators") " such as " (:ref "macro/loop" "loop") ", " (:ref "macro/do" "do") " and " (:ref "macro/prog" "prog") ", to which control and values may be transfered by using a " (:ref "special-operator/return-from" "return-from") " " (:term "glossary/form" "form") " with the name of the " (:term "glossary/block" "block") "."))))
(:entry "glossary/block tag" :names ("block tag") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " the " (:term "glossary/symbol" "symbol") " that, within the " (:term "glossary/lexical scope" "lexical scope") " of a " (:ref "special-operator/block" "block") " " (:term "glossary/form" "form") ", names the " (:term "glossary/block" "block") " " (:term "glossary/establish" "established") " by that " (:ref "special-operator/block" "block") " " (:term "glossary/form" "form") ". See " (:ref "macro/return" "return") " or " (:ref "special-operator/return-from" "return-from") "."))))
(:entry "glossary/boa lambda list" :names ("boa lambda list") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/lambda list" "lambda list") " that is syntactically like an " (:term "glossary/ordinary lambda list" "ordinary lambda list") ", but that is processed in “" (:b "b") "y " (:b "o") "rder of " (:b "a") "rgument” style. " "See " (:secref "BoaLambdaLists" "Section 3.4.6 (Boa Lambda Lists)") "."))))
(:entry "glossary/body parameter" :names ("body parameter") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/parameter" "parameter") " available in certain " (:term "glossary/lambda list" "lambda lists") " which from the point of view of " (:term "glossary/conforming program" "conforming programs") " is like a " (:term "glossary/rest parameter" "rest parameter") " in every way except that it is introduced by " (:code "&body") " instead of " (:code "&rest") ". (" (:term "glossary/implementation" "Implementations") " are permitted to provide extensions which distinguish " (:term "glossary/body parameter" "body parameters") " and " (:term "glossary/rest parameter" "rest parameters") "—" (:i "e.g.") ", " "the " (:term "glossary/form" "forms") " for " (:term "glossary/operator" "operators") " which were defined using a " (:term "glossary/body parameter" "body parameter") " might be pretty printed slightly differently than " (:term "glossary/form" "forms") " for " (:term "glossary/operator" "operators") " which were defined using " (:term "glossary/rest parameter" "rest parameters") ".)"))))
(:entry "glossary/boolean" :names ("boolean") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " an " (:term "glossary/object" "object") " " "of " (:term "glossary/type" "type") " " (:ref "type/boolean" "boolean") "; that is, one of the following " (:term "glossary/object" "objects") ": the symbol " (:ref "constant-variable/t" "t") " " " (representing " (:term "glossary/true" "true") "), or the symbol " (:ref "constant-variable/nil" "nil") " " "(representing " (:term "glossary/false" "false") "). " "See " (:term "glossary/generalized boolean" "generalized boolean") "."))))
(:entry "glossary/boolean equivalent" :names ("boolean equivalent") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " "(of an " (:term "glossary/object" "object") " " (:math "O" (:sub "1")) ") any " (:term "glossary/object" "object") " " (:math "O" (:sub "2")) " that has the same truth value as " (:math "O" (:sub "1")) " when both " (:math "O" (:sub "1")) " and " (:math "O" (:sub "2")) " are viewed as " (:term "glossary/generalized boolean" "generalized booleans") "."))))
(:entry "glossary/bound" :names ("bound") :kind :glossary-term :kind-name "Glossary Term" :summary "adj." :sections (("Definition" (:p (:i "adj.") ", " (:i "v.t.")) (:list (:item (:label "1.") (:p (:i "adj.") " " "having an associated denotation in a " (:term "glossary/binding" "binding") ". " "“The variables named by a " (:ref "special-operator/let" "let") " are bound within its body.”" " " "See " (:term "glossary/unbound" "unbound") ".")) (:item (:label "2.") (:p (:i "adj.") " " "having a local " (:term "glossary/binding" "binding") " which " (:term "glossary/shadow" "shadows") (:sense "2") " another. " "“The variable " (:ref "variable/*print-escape*" "*print-escape*") " is bound while in the " (:ref "function/write" "princ") " function.”")) (:item (:label "3.") (:p (:i "v.t.") " " "the past tense of " (:term "glossary/bind" "bind") "."))))))
(:entry "glossary/bound declaration" :names ("bound declaration") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/declaration" "declaration") " that refers to or is associated with a " (:term "glossary/variable" "variable") " or " (:term "glossary/function" "function") " and that appears within the " (:term "glossary/special form" "special form") " that " (:term "glossary/establish" "establishes") " the " (:term "glossary/variable" "variable") " or " (:term "glossary/function" "function") ", but before the body of that " (:term "glossary/special form" "special form")) (:p "(specifically, at the head of that " (:term "glossary/form" "form") "’s body).") (:p "(If a " (:term "glossary/bound declaration" "bound declaration") " refers to a " (:term "glossary/function" "function") " " (:term "glossary/binding" "binding") " or a " (:term "glossary/lexical variable" "lexical variable") " " (:term "glossary/binding" "binding") ", the " (:term "glossary/scope" "scope") " of the " (:term "glossary/declaration" "declaration") " is exactly the " (:term "glossary/scope" "scope") " of that " (:term "glossary/binding" "binding") ". If the " (:term "glossary/declaration" "declaration") " refers to a " (:term "glossary/dynamic variable" "dynamic variable") " " (:term "glossary/binding" "binding") ", the " (:term "glossary/scope" "scope") " of the " (:term "glossary/declaration" "declaration") " is what the " (:term "glossary/scope" "scope") " of the " (:term "glossary/binding" "binding") " would have been if it were lexical rather than dynamic.)"))))
(:entry "glossary/bounded" :names ("bounded") :kind :glossary-term :kind-name "Glossary Term" :summary "adj." :sections (("Definition" (:p (:i "adj.") " " "(of a " (:term "glossary/sequence" "sequence") " " (:math "S") ", by an ordered pair of " (:term nil "bounding indices") " " (:math "i" (:sub "start")) " and " (:math "i" (:sub "end")) ") restricted to a subrange of the " (:term "glossary/element" "elements") " of " (:math "S") " that includes each " (:term "glossary/element" "element") " beginning with (and including) the one indexed by " (:math "i" (:sub "start")) " and continuing up to (but not including) the one indexed by " (:math "i" (:sub "end")) "."))))
(:entry "glossary/bounding index" :names ("bounding index") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " "(of a " (:term "glossary/sequence" "sequence") " with " (:term "glossary/length" "length") " " (:math "n") ") either of a conceptual pair of " (:term "glossary/integer" "integers") ", " (:math "i" (:sub "start")) " and " (:math "i" (:sub "end")) ", respectively called the “lower bounding index” and “upper bounding index”, such that " (:math "0 " "≤" "i" (:sub "start") " " "≤" "i" (:sub "end") " " "≤" "n") ", and which therefore delimit a subrange of the " (:term "glossary/sequence" "sequence") " " (:term "glossary/bounded" "bounded") " by " (:math "i" (:sub "start")) " and " (:math "i" (:sub "end")) "."))))
(:entry "glossary/bounding index designator" :names ("bounding index designator") :kind :glossary-term :kind-name "Glossary Term" :summary "(for a sequence) one of two objects that, taken together as an ordered pair, behave as a designator for bounding indices of the sequence;" :sections (("Definition" (:p "(for a " (:term "glossary/sequence" "sequence") ") one of two " (:term "glossary/object" "objects") " that, taken together as an ordered pair, behave as a " (:term "glossary/designator" "designator") " for " (:term nil "bounding indices") " of the " (:term "glossary/sequence" "sequence") "; that is, they denote " (:term nil "bounding indices") " of the " (:term "glossary/sequence" "sequence") ", and are either: an " (:term "glossary/integer" "integer") " (denoting itself) and " (:ref "constant-variable/nil" "nil") " " " (denoting the " (:term "glossary/length" "length") " of the " (:term "glossary/sequence" "sequence") "), or two " (:term "glossary/integer" "integers") " (each denoting themselves)."))))
(:entry "glossary/break loop" :names ("break loop") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " A variant of the normal " (:term "glossary/lisp read-eval-print loop" "Lisp read-eval-print loop") " that is recursively entered, usually because the ongoing " (:term "glossary/evaluation" "evaluation") " of some other " (:term "glossary/form" "form") " has been suspended for the purpose of debugging. Often, a " (:term "glossary/break loop" "break loop") " provides the ability to exit in such a way as to continue the suspended computation. " "See the " (:term "glossary/function" "function") " " (:ref "function/break" "break") "."))))
(:entry "glossary/broadcast stream" :names ("broadcast stream") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " an " (:term "glossary/output" "output") " " (:term "glossary/stream" "stream") " " "of " (:term "glossary/type" "type") " " (:ref "system-class/broadcast-stream" "broadcast-stream") "."))))
(:entry "glossary/built-in class" :names ("built-in class") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/class" "class") " that is a " (:term "glossary/generalized instance" "generalized instance") " " "of " (:term "glossary/class" "class") " " (:ref "system-class/built-in-class" "built-in-class") "."))))
(:entry "glossary/built-in type" :names ("built-in type") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " one of the " (:term "glossary/type" "types") " in " (:secref "StandardizedAtomicTypeSpecs" "Figure~4--2") ".") (:p (:i "n.")))))
(:entry "glossary/byte" :names ("byte") :kind :glossary-term :kind-name "Glossary Term" :summary "adjacent bits within an integer." :sections (("Definition" (:p (:i "n.")) (:list (:item (:label "1.") (:p "adjacent bits within an " (:term "glossary/integer" "integer") ". (The specific number of bits can vary from point to point in the program; " "see the " (:term "glossary/function" "function") " " (:ref "function/byte" "byte") ".)")) (:item (:label "2.") (:p "an integer in a specified range.") (:p "(The specific range can vary from point to point in the program; " "see the " (:term "glossary/function" "functions") " " (:ref "function/open" "open") " and " (:ref "function/write-byte" "write-byte") ".)"))))))
(:entry "glossary/byte specifier" :names ("byte specifier") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " An " (:term "glossary/object" "object") " of " (:term "glossary/implementation-dependent" "implementation-dependent") " nature that is returned by " "the " (:term "glossary/function" "function") " " (:ref "function/byte" "byte") " and that specifies the range of bits in an " (:term "glossary/integer" "integer") " to be used as a " (:term "glossary/byte" "byte") " by " (:term "glossary/function" "functions") " such as " (:ref "accessor/ldb" "ldb") "."))))
(:entry "glossary/cadr" :names ("cadr") :kind :glossary-term :kind-name "Glossary Term" :summary "[width 1pt height 2pt depth 2ptkawidth 1pt height 2pt depth 2ptdεr], n." :sections (("Definition" (:p (:math "[" (:b (:math) (:math) "width 1pt height 2pt depth 2pt" (:math) (:math) "ka" (:math) "width 1pt height 2pt depth 2pt" (:math) "d" (:math "ε") "r") "]") ", " (:i "n.") " " "(of an " (:term "glossary/object" "object") ") the " (:term "glossary/car" "car") " of the " (:term "glossary/cdr" "cdr") " of that " (:term "glossary/object" "object") "."))))
(:entry "glossary/call" :names ("call") :kind :glossary-term :kind-name "Glossary Term" :summary "v.t." :sections (("Definition" (:p (:i "v.t.") ", " (:i "n.")) (:list (:item (:label "1.") (:p (:i "v.t.") " " "(a " (:term "glossary/function" "function") " with " (:term "glossary/argument" "arguments") ") to cause the " (:term "glossary/code" "code") " represented by that " (:term "glossary/function" "function") " to be " (:term "glossary/execute" "executed") " in an " (:term "glossary/environment" "environment") " where " (:term "glossary/binding" "bindings") " for the " (:term "glossary/value" "values") " of its " (:term "glossary/parameter" "parameters") " have been " (:term "glossary/establish" "established") " based on the " (:term "glossary/argument" "arguments") ". " "“Calling the function " (:ref "function/+" "+") " with the arguments " (:code "5") " and " (:code "1") " yields a value of " (:code "6") ".”")) (:item (:label "2.") (:p (:i "n.") " " "a " (:term "glossary/situation" "situation") " in which a " (:term "glossary/function" "function") " is called."))))))
(:entry "glossary/captured initialization form" :names ("captured initialization form") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " an " (:term "glossary/initialization form" "initialization form") " along with the " (:term "glossary/lexical environment" "lexical environment") " in which the " (:term "glossary/form" "form") " that defined the " (:term "glossary/initialization form" "initialization form") " was " (:term "glossary/evaluate" "evaluated") ". " "“Each newly added shared slot is set to the result of evaluating the captured initialization form for the slot that was specified in the " (:ref "macro/defclass" "defclass") " form for the new class.”"))))
(:entry "glossary/car" :names ("car") :kind :glossary-term :kind-name "Glossary Term" :summary "a." :sections (("Definition" (:p (:i "n.")) (:list (:item (:label "1.") (:p "a. (of a " (:term "glossary/cons" "cons") ") the component of a " (:term "glossary/cons" "cons") " corresponding to the first " (:term "glossary/argument" "argument") " to " (:ref "function/cons" "cons") "; the other component is the " (:term "glossary/cdr" "cdr") ". " "“The function " (:ref "function/rplaca" "rplaca") " modifies the car of a cons.”" " b. (of a " (:term "glossary/list" "list") ") the first " (:term "glossary/element" "element") " of the " (:term "glossary/list" "list") ", or " (:ref "constant-variable/nil" "nil") " " "if the " (:term "glossary/list" "list") " is the " (:term "glossary/empty list" "empty list") ".")) (:item (:label "2.") (:p "the " (:term "glossary/object" "object") " that is held in the " (:term "glossary/car" "car") (:sense "1") ". " "“The function " (:ref "accessor/car" "car") " returns the car of a cons.”"))))))
(:entry "glossary/case" :names ("case") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " "(of a " (:term "glossary/character" "character") ") the property of being either " (:term "glossary/uppercase" "uppercase") " or " (:term "glossary/lowercase" "lowercase") ". Not all " (:term "glossary/character" "characters") " have " (:term "glossary/case" "case") ". " "“The characters " (:code "#" "\\" "A") " and " (:code "#" "\\" "a") " have case, but the character " (:code "#" "\\" "$") " has no case.”" " " "See " (:secref "CharactersWithCase" "Section 13.1.4.3 (Characters With Case)") " " "and " "the " (:term "glossary/function" "function") " " (:ref "function/upper-case-p" "both-case-p") "."))))
(:entry "glossary/case sensitivity mode" :names ("case sensitivity mode") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " one of the " (:term "glossary/symbol" "symbols") " " (:code ":upcase") ", " (:code ":downcase") ", " (:code ":preserve") ", or " (:code ":invert") "."))))
(:entry "glossary/catch" :names ("catch") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " an " (:term "glossary/exit point" "exit point") " which is " (:term "glossary/establish" "established") " by a " (:ref "special-operator/catch" "catch") " " (:term "glossary/form" "form") " within the " (:term "glossary/dynamic scope" "dynamic scope") " of its body, which is named by a " (:term "glossary/catch tag" "catch tag") ", and to which control and " (:term "glossary/value" "values") " may be " (:term nil "thrown") "."))))
(:entry "glossary/catch tag" :names ("catch tag") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " an " (:term "glossary/object" "object") " which names an " (:term "glossary/active" "active") " " (:term "glossary/catch" "catch") ". (If more than one " (:term "glossary/catch" "catch") " is active with the same " (:term "glossary/catch tag" "catch tag") ", it is only possible to " (:term "glossary/throw" "throw") " to the innermost such " (:term "glossary/catch" "catch") " because the outer one is " (:term "glossary/shadow" "shadowed") (:sense "2") ".)"))))
(:entry "glossary/cddr" :names ("cddr") :kind :glossary-term :kind-name "Glossary Term" :summary "[width 1pt height 2pt depth 2ptkudεwidth 1pt height 2pt depth 2ptdεr] or [width 1pt height 2pt depth 2ptkεwidth 1pt height 2pt depth 2ptdudεr], n." :sections (("Definition" (:p (:math "[" (:b (:math) (:math) "width 1pt height 2pt depth 2pt" (:math) (:math) "k" "ud" (:math "ε") (:math) "width 1pt height 2pt depth 2pt" (:math) "d" (:math "ε") "r") "]") " or " (:math "[" (:b (:math) (:math) "width 1pt height 2pt depth 2pt" (:math) (:math) "k" (:math "ε") (:math) "width 1pt height 2pt depth 2pt" (:math) "d" "ud" (:math "ε") "r") "]") ", " (:i "n.") " " " (of an " (:term "glossary/object" "object") ") the " (:term "glossary/cdr" "cdr") " of the " (:term "glossary/cdr" "cdr") " of that " (:term "glossary/object" "object") "."))))
(:entry "glossary/cdr" :names ("cdr") :kind :glossary-term :kind-name "Glossary Term" :summary "[width 1pt height 2pt depth 2ptkuwidth 1pt height 2pt depth 2ptdεr], n." :sections (("Definition" (:p (:math "[" (:b (:math) (:math) "width 1pt height 2pt depth 2pt" (:math) (:math) "k" "u" (:math) "width 1pt height 2pt depth 2pt" (:math) "d" (:math "ε") "r") "]") ", " (:i "n.")) (:list (:item (:label "1.") (:p "a. (of a " (:term "glossary/cons" "cons") ") the component of a " (:term "glossary/cons" "cons") " corresponding to the second " (:term "glossary/argument" "argument") " to " (:ref "function/cons" "cons") "; the other component is the " (:term "glossary/car" "car") ". " "“The function " (:ref "function/rplaca" "rplacd") " modifies the cdr of a cons.”" " b. (of a " (:term "glossary/list" "list") " " (:math "L" (:sub "1")) ") either the " (:term "glossary/list" "list") " " (:math "L" (:sub "2")) " that contains the " (:term "glossary/element" "elements") " of " (:math "L" (:sub "1")) " that follow after the first, or else " (:ref "constant-variable/nil" "nil") " " "if " (:math "L" (:sub "1")) " is the " (:term "glossary/empty list" "empty list") ".")) (:item (:label "2.") (:p "the " (:term "glossary/object" "object") " that is held in the " (:term "glossary/cdr" "cdr") (:sense "1") ". " "“The function " (:ref "accessor/car" "cdr") " returns the cdr of a cons.”"))))))
(:entry "glossary/cell" :names ("cell") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " (:i "Trad.") " " "(of an " (:term "glossary/object" "object") ") a conceptual " (:term "glossary/slot" "slot") " of that " (:term "glossary/object" "object") ". The " (:term "glossary/dynamic variable" "dynamic variable") " and global " (:term "glossary/function" "function") " " (:term "glossary/binding" "bindings") " of a " (:term "glossary/symbol" "symbol") " are sometimes referred to as its " (:term "glossary/value cell" "value cell") " and " (:term "glossary/function cell" "function cell") ", respectively."))))
(:entry "glossary/character" :names ("character") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") ", " (:i "adj.")) (:list (:item (:label "1.") (:p (:i "n.") " " "an " (:term "glossary/object" "object") " " "of " (:term "glossary/type" "type") " " (:ref "system-class/character" "character") "; that is, an " (:term "glossary/object" "object") " that represents a unitary token in an aggregate quantity of text; " "see " (:secref "CharacterConcepts" "Section 13.1 (Character Concepts)") ".")) (:item (:label "2.") (:p (:i "adj.") " " " a. (of a " (:term "glossary/stream" "stream") ") having an " (:term "glossary/element type" "element type") " that is a " (:term "glossary/subtype" "subtype") " of " (:term "glossary/type" "type") " " (:ref "system-class/character" "character") ". The most fundamental operation on a " (:term "glossary/character" "character") " " (:term "glossary/input" "input") " " (:term "glossary/stream" "stream") " is " (:ref "function/read-char" "read-char") " and on a " (:term "glossary/character" "character") " " (:term "glossary/output" "output") " " (:term "glossary/stream" "stream") " is " (:ref "function/write-char" "write-char") ". " "See " (:term "glossary/binary" "binary") ". b. (of a " (:term "glossary/file" "file") ") having been created by opening a " (:term "glossary/character" "character") " " (:term "glossary/stream" "stream") ". (It is " (:term "glossary/implementation-dependent" "implementation-dependent") " whether this is an inspectable aspect of the " (:term "glossary/file" "file") ", or whether any given " (:term "glossary/binary" "binary") " " (:term "glossary/file" "file") " can be treated as a " (:term "glossary/character" "character") " " (:term "glossary/file" "file") ".)"))))))
(:entry "glossary/character code" :names ("character code") :kind :glossary-term :kind-name "Glossary Term" :summary "one of possibly several attributes of a character." :sections (("Definition" (:p (:i "n.")) (:list (:item (:label "1.") (:p "one of possibly several " (:term "glossary/attribute" "attributes") " of a " (:term "glossary/character" "character") ".")) (:item (:label "2.") (:p "a non-negative " (:term "glossary/integer" "integer") " less than " "the " (:term "glossary/value" "value") " of " (:ref "constant-variable/char-code-limit" "char-code-limit") " that is suitable for use as a " (:term "glossary/character code" "character code") (:sense "1") "."))))))
(:entry "glossary/character designator" :names ("character designator") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/designator" "designator") " for a " (:term "glossary/character" "character") "; that is, an " (:term "glossary/object" "object") " that denotes a " (:term "glossary/character" "character") " and that is one of: a " (:term "glossary/designator" "designator") " for a " (:term "glossary/string" "string") " of " (:term "glossary/length" "length") " one (denoting the " (:term "glossary/character" "character") " that is its only " (:term "glossary/element" "element") "),") (:p "or a " (:term "glossary/character" "character") " (denoting itself)."))))
(:entry "glossary/circular" :names ("circular") :kind :glossary-term :kind-name "Glossary Term" :summary "(of a list) a circular list." :sections (("Definition" (:p (:i "adj.")) (:list (:item (:label "1.") (:p "(of a " (:term "glossary/list" "list") ") a " (:term "glossary/circular list" "circular list") ".")) (:item (:label "2.") (:p "(of an arbitrary " (:term "glossary/object" "object") ") having a " (:term nil "component") ", " (:term "glossary/element" "element") ", " (:term "glossary/constituent" "constituent") (:sense "2") ", or " (:term "glossary/subexpression" "subexpression") " (as appropriate to the context) that is the " (:term "glossary/object" "object") " itself."))))))
(:entry "glossary/circular list" :names ("circular list") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a chain of " (:term "glossary/cons" "conses") " that has no termination because some " (:term "glossary/cons" "cons") " in the chain is the " (:term "glossary/cdr" "cdr") " of a later " (:term "glossary/cons" "cons") "."))))
(:entry "glossary/class" :names ("class") :kind :glossary-term :kind-name "Glossary Term" :summary "an object that uniquely determines the structure and behavior of a set of other objects called its direct instances, that contributes structure and behavior to a set of other objects called its…" :sections (("Definition" (:p (:i "n.")) (:list (:item (:label "1.") (:p "an " (:term "glossary/object" "object") " that uniquely determines the structure and behavior of a set of other " (:term "glossary/object" "objects") " called its " (:term "glossary/direct instance" "direct instances") ", that contributes structure and behavior to a set of other " (:term "glossary/object" "objects") " called its " (:term "glossary/indirect instance" "indirect instances") ", and that acts as a " (:term "glossary/type specifier" "type specifier") " for a set of objects called its " (:term "glossary/generalized instance" "generalized instances") ". " "“The class " (:ref "system-class/integer" "integer") " is a subclass of the class " (:ref "system-class/number" "number") ".”" " (Note that the phrase “the " (:term "glossary/class" "class") " " (:code "foo") "” is often substituted for the more precise phrase “the " (:term "glossary/class" "class") " named " (:code "foo") "”—in both cases, a " (:term "glossary/class" "class") " " (:term "glossary/object" "object") " (not a " (:term "glossary/symbol" "symbol") ") is denoted.)")) (:item (:label "2.") (:p "(of an " (:term "glossary/object" "object") ") the uniquely determined " (:term "glossary/class" "class") " of which the " (:term "glossary/object" "object") " is a " (:term "glossary/direct instance" "direct instance") ". " "See the " (:term "glossary/function" "function") " " (:ref "function/class-of" "class-of") ". " "“The class of the object returned by " (:ref "function/gensym" "gensym") " is " (:ref "system-class/symbol" "symbol") ".”" " (Note that with this usage a phrase such as “its " (:term "glossary/class" "class") " is " (:code "foo") "” is often substituted for the more precise phrase “its " (:term "glossary/class" "class") " is the " (:term "glossary/class" "class") " named " (:code "foo") "”—in both cases, a " (:term "glossary/class" "class") " " (:term "glossary/object" "object") " (not a " (:term "glossary/symbol" "symbol") ") is denoted.)"))))))
(:entry "glossary/class designator" :names ("class designator") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/designator" "designator") " for a " (:term "glossary/class" "class") "; that is, an " (:term "glossary/object" "object") " that denotes a " (:term "glossary/class" "class") " and that is one of: a " (:term "glossary/symbol" "symbol") " (denoting the " (:term "glossary/class" "class") " named by that " (:term "glossary/symbol" "symbol") "; " "see the " (:term "glossary/function" "function") " " (:ref "accessor/find-class" "find-class") ") or a " (:term "glossary/class" "class") " (denoting itself)."))))
(:entry "glossary/class precedence list" :names ("class precedence list") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a unique total ordering on a " (:term "glossary/class" "class") " and its " (:term "glossary/superclass" "superclasses") " that is consistent with the " (:term "glossary/local precedence order" "local precedence orders") " for the " (:term "glossary/class" "class") " and its " (:term "glossary/superclass" "superclasses") ". For detailed information, " "see " (:secref "DeterminingtheCPL" "Section 4.3.5 (Determining the Class Precedence List)") "."))))
(:entry "glossary/close" :names ("close") :kind :glossary-term :kind-name "Glossary Term" :summary "v.t." :sections (("Definition" (:p (:i "v.t.") " " "(a " (:term "glossary/stream" "stream") ") to terminate usage of the " (:term "glossary/stream" "stream") " as a source or sink of data, permitting the " (:term "glossary/implementation" "implementation") " to reclaim its internal data structures, and to free any external resources which might have been locked by the " (:term "glossary/stream" "stream") " when it was opened."))))
(:entry "glossary/closed" :names ("closed") :kind :glossary-term :kind-name "Glossary Term" :summary "adj." :sections (("Definition" (:p (:i "adj.") " " "(of a " (:term "glossary/stream" "stream") ") having been " (:term "glossary/closed" "closed") " (" "see " (:term nil (:term nil)) "close" "). Some (but not all) operations that are valid on " (:term "glossary/open" "open") " " (:term "glossary/stream" "streams") " are not valid on " (:term "glossary/closed" "closed") " " (:term "glossary/stream" "streams") ". " "See " (:secref "OpenAndClosedStreams" "Section 21.1.1.1.2 (Open and Closed Streams)") "."))))
(:entry "glossary/closure" :names ("closure") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/lexical closure" "lexical closure") "."))))
(:entry "glossary/coalesce" :names ("coalesce") :kind :glossary-term :kind-name "Glossary Term" :summary "v.t." :sections (("Definition" (:p (:i "v.t.") " " "(" (:term nil "literal objects") " that are " (:term "glossary/similar" "similar") ") to consolidate the identity of those " (:term "glossary/object" "objects") ", such that they become the " (:term "glossary/same" "same") " " (:term "glossary/object" "object") ". " "See " (:secref "CompilationTerms" "Section 3.2.1 (Compiler Terminology)") "."))))
(:entry "glossary/code" :names ("code") :kind :glossary-term :kind-name "Glossary Term" :summary "Trad." :sections (("Definition" (:p (:i "n.")) (:list (:item (:label "1.") (:p (:i "Trad.") " " " any representation of actions to be performed, whether conceptual or as an actual " (:term "glossary/object" "object") ", such as " (:term "glossary/form" "forms") ", " (:term "glossary/lambda expression" "lambda expressions") ", " (:term "glossary/object" "objects") " of " (:term "glossary/type" "type") " " (:term "glossary/function" "function") ", text in a " (:term "glossary/source file" "source file") ", or instruction sequences in a " (:term "glossary/compiled file" "compiled file") ". This is a generic term; the specific nature of the representation depends on its context.")) (:item (:label "2.") (:p "(of a " (:term "glossary/character" "character") ") a " (:term "glossary/character code" "character code") "."))))))
(:entry "glossary/coerce" :names ("coerce") :kind :glossary-term :kind-name "Glossary Term" :summary "v.t." :sections (("Definition" (:p (:i "v.t.") " " "(an " (:term "glossary/object" "object") " to a " (:term "glossary/type" "type") ") to produce an " (:term "glossary/object" "object") " from the given " (:term "glossary/object" "object") ", without modifying that " (:term "glossary/object" "object") ", by following some set of coercion rules that must be specifically stated for any context in which this term is used. The resulting " (:term "glossary/object" "object") " is necessarily of the indicated " (:term "glossary/type" "type") ", except when that type is a " (:term "glossary/subtype" "subtype") " of " (:term "glossary/type" "type") " " (:ref "system-class/complex" "complex") "; in that case, if a " (:term "glossary/complex rational" "complex rational") " with an imaginary part of zero would result, the result is a " (:term "glossary/rational" "rational") " rather than a " (:term "glossary/complex" "complex") "—" "see " (:secref "RuleOfCanonRepForComplexRationals" "Section 12.1.5.3 (Rule of Canonical Representation for Complex Rationals)") "."))))
(:entry "glossary/colon" :names ("colon") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " the " (:term "glossary/standard character" "standard character") " that is called “colon” (" (:code ":") "). " "See " (:secref "StdCharsThree" "Figure~2--5") "."))))
(:entry "glossary/comma" :names ("comma") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " the " (:term "glossary/standard character" "standard character") " that is called “comma” (" (:code ",") "). " "See " (:secref "StdCharsThree" "Figure~2--5") "."))))
(:entry "glossary/compilation" :names ("compilation") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " the process of " (:term "glossary/compile" "compiling") " " (:term "glossary/code" "code") " by the " (:term "glossary/compiler" "compiler") "."))))
(:entry "glossary/compilation environment" :names ("compilation environment") :kind :glossary-term :kind-name "Glossary Term" :summary "An environment that represents information known by the compiler about a form that is being compiled." :sections (("Definition" (:p (:i "n.")) (:list (:item (:label "1.") (:p "An " (:term "glossary/environment" "environment") " that represents information known by the " (:term "glossary/compiler" "compiler") " about a " (:term "glossary/form" "form") " that is being " (:term "glossary/compile" "compiled") ". " "See " (:secref "CompilationTerms" "Section 3.2.1 (Compiler Terminology)") ".")) (:item (:label "2.") (:p "An " (:term "glossary/object" "object") " that represents the " (:term "glossary/compilation environment" "compilation environment") (:sense "1") " and that is used as a second argument to a " (:term "glossary/macro function" "macro function") " (which supplies a " (:term "glossary/value" "value") " for any " (:code "&environment") " " (:term "glossary/parameter" "parameter") " in the " (:term "glossary/macro function" "macro function") "’s definition)."))))))
(:entry "glossary/compilation unit" :names ("compilation unit") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " an interval during which a single unit of compilation is occurring. " "See the " (:term "glossary/macro" "macro") " " (:ref "macro/with-compilation-unit" "with-compilation-unit") "."))))
(:entry "glossary/compile" :names ("compile") :kind :glossary-term :kind-name "Glossary Term" :summary "(code) to perform semantic preprocessing of the code, usually optimizing one or more qualities of the code, such as run-time speed of execution or run-time storage usage." :sections (("Definition" (:p (:i "v.t.")) (:list (:item (:label "1.") (:p "(" (:term "glossary/code" "code") ") to perform semantic preprocessing of the " (:term "glossary/code" "code") ", usually optimizing one or more qualities of the code, such as run-time speed of " (:term nil "execution") " or run-time storage usage. The minimum semantic requirements of compilation are that it must remove all macro calls and arrange for all " (:term "glossary/load time value" "load time values") " to be resolved prior to run time.")) (:item (:label "2.") (:p "(a " (:term "glossary/function" "function") ") to produce a new " (:term "glossary/object" "object") " " "of " (:term "glossary/type" "type") " " (:ref "type/compiled-function" "compiled-function") " which represents the result of " (:term "glossary/compile" "compiling") " the " (:term "glossary/code" "code") " represented by the " (:term "glossary/function" "function") ". " "See the " (:term "glossary/function" "function") " " (:ref "function/compile" "compile") ".")) (:item (:label "3.") (:p "(a " (:term "glossary/source file" "source file") ") to produce a " (:term "glossary/compiled file" "compiled file") " from a " (:term "glossary/source file" "source file") ". " "See the " (:term "glossary/function" "function") " " (:ref "function/compile-file" "compile-file") "."))))))
(:entry "glossary/compile time" :names ("compile time") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " the duration of time that the " (:term "glossary/compiler" "compiler") " is processing " (:term "glossary/source code" "source code") "."))))
(:entry "glossary/compile-time definition" :names ("compile-time definition") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a definition in the " (:term "glossary/compilation environment" "compilation environment") "."))))
(:entry "glossary/compiled code" :names ("compiled code") :kind :glossary-term :kind-name "Glossary Term" :summary "compiled functions." :sections (("Definition" (:p (:i "n.")) (:list (:item (:label "1.") (:p (:term "glossary/compiled function" "compiled functions") ".")) (:item (:label "2.") (:p (:term "glossary/code" "code") " that represents " (:term "glossary/compiled function" "compiled functions") ", such as the contents of a " (:term "glossary/compiled file" "compiled file") "."))))))
(:entry "glossary/compiled file" :names ("compiled file") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/file" "file") " which represents the results of " (:term "glossary/compile" "compiling") " the " (:term "glossary/form" "forms") " which appeared in a corresponding " (:term "glossary/source file" "source file") ", and which can be " (:term "glossary/load" "loaded") ". " "See the " (:term "glossary/function" "function") " " (:ref "function/compile-file" "compile-file") "."))))
(:entry "glossary/compiled function" :names ("compiled function") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " an " (:term "glossary/object" "object") " " "of " (:term "glossary/type" "type") " " (:ref "type/compiled-function" "compiled-function") ", which is a " (:term "glossary/function" "function") " that has been " (:term "glossary/compile" "compiled") ", which contains no references to " (:term "glossary/macro" "macros") " that must be expanded at run time, and which contains no unresolved references to " (:term "glossary/load time value" "load time values") "."))))
(:entry "glossary/compiler" :names ("compiler") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a facility that is part of Lisp and that translates " (:term "glossary/code" "code") " into an " (:term "glossary/implementation-dependent" "implementation-dependent") " form that might be represented or " (:term "glossary/execute" "executed") " efficiently. The functions " (:ref "function/compile" "compile") " and " (:ref "function/compile-file" "compile-file") " permit programs to invoke the " (:term "glossary/compiler" "compiler") "."))))
(:entry "glossary/compiler macro" :names ("compiler macro") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " an auxiliary macro definition for a globally defined " (:term "glossary/function" "function") " or " (:term "glossary/macro" "macro") " which might or might not be called by any given " (:term "glossary/conforming implementation" "conforming implementation") " and which must preserve the semantics of the globally defined " (:term "glossary/function" "function") " or " (:term "glossary/macro" "macro") " but which might perform some additional optimizations. (Unlike a " (:term "glossary/macro" "macro") ", a " (:term "glossary/compiler macro" "compiler macro") " does not extend the syntax of " "Common Lisp" "; rather, it provides an alternate implementation strategy for some existing syntax or functionality.)"))))
(:entry "glossary/compiler macro expansion" :names ("compiler macro expansion") :kind :glossary-term :kind-name "Glossary Term" :summary "the process of translating a form into another form by a compiler macro." :sections (("Definition" (:p (:i "n.")) (:list (:item (:label "1.") (:p "the process of translating a " (:term "glossary/form" "form") " into another " (:term "glossary/form" "form") " by a " (:term "glossary/compiler macro" "compiler macro") ".")) (:item (:label "2.") (:p "the " (:term "glossary/form" "form") " resulting from this process."))))))
(:entry "glossary/compiler macro form" :names ("compiler macro form") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/function form" "function form") " or " (:term "glossary/macro form" "macro form") " whose " (:term "glossary/operator" "operator") " has a definition as a " (:term "glossary/compiler macro" "compiler macro") ", or a " (:ref "function/funcall" "funcall") " " (:term "glossary/form" "form") " whose first " (:term "glossary/argument" "argument") " is a " (:ref "special-operator/function" "function") " " (:term "glossary/form" "form") " whose " (:term "glossary/argument" "argument") " is the " (:term "glossary/name" "name") " of a " (:term "glossary/function" "function") " that has a definition as a " (:term "glossary/compiler macro" "compiler macro") "."))))
(:entry "glossary/compiler macro function" :names ("compiler macro function") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/function" "function") " of two arguments, a " (:term "glossary/form" "form") " and an " (:term "glossary/environment" "environment") ", that implements " (:term "glossary/compiler macro expansion" "compiler macro expansion") " by producing either a " (:term "glossary/form" "form") " to be used in place of the original argument " (:term "glossary/form" "form") " or else " (:ref "constant-variable/nil" "nil") ", indicating that the original " (:term "glossary/form" "form") " should not be replaced. " "See " (:secref "CompilerMacros" "Section 3.2.2.1 (Compiler Macros)") "."))))
(:entry "glossary/complex" :names ("complex") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " an " (:term "glossary/object" "object") " " "of " (:term "glossary/type" "type") " " (:ref "system-class/complex" "complex") "."))))
(:entry "glossary/complex float" :names ("complex float") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " an " (:term "glossary/object" "object") " " "of " (:term "glossary/type" "type") " " (:ref "system-class/complex" "complex") " which has a " (:term "glossary/complex part type" "complex part type") " that is a " (:term "glossary/subtype" "subtype") " of " (:ref "system-class/float" "float") ". A " (:term "glossary/complex float" "complex float") " is a " (:term "glossary/complex" "complex") ", but it is not a " (:term "glossary/float" "float") "."))))
(:entry "glossary/complex part type" :names ("complex part type") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " "(of a " (:term "glossary/complex" "complex") ")") (:list (:item (:label "1.") (:p "the " (:term "glossary/type" "type") " which is used to represent both the real part and the imaginary part of the " (:term "glossary/complex" "complex") ".")) (:item (:label "2.") (:p "the " (:term "glossary/actual complex part type" "actual complex part type") " of the " (:term "glossary/complex" "complex") ".")) (:item (:label "3.") (:p "the " (:term "glossary/expressed complex part type" "expressed complex part type") " of the " (:term "glossary/complex" "complex") "."))))))
(:entry "glossary/complex rational" :names ("complex rational") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " an " (:term "glossary/object" "object") " " "of " (:term "glossary/type" "type") " " (:ref "system-class/complex" "complex") " which has a " (:term "glossary/complex part type" "complex part type") " that is a " (:term "glossary/subtype" "subtype") " of " (:ref "system-class/rational" "rational") ". A " (:term "glossary/complex rational" "complex rational") " is a " (:term "glossary/complex" "complex") ", but it is not a " (:term "glossary/rational" "rational") ". No " (:term "glossary/complex rational" "complex rational") " has an imaginary part of zero because such a number is always represented by " "Common Lisp" " " "as an " (:term "glossary/object" "object") " " "of " (:term "glossary/type" "type") " " (:ref "system-class/rational" "rational") "; " "see " (:secref "RuleOfCanonRepForComplexRationals" "Section 12.1.5.3 (Rule of Canonical Representation for Complex Rationals)") "."))))
(:entry "glossary/complex single float" :names ("complex single float") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " an " (:term "glossary/object" "object") " " "of " (:term "glossary/type" "type") " " (:ref "system-class/complex" "complex") " which has a " (:term "glossary/complex part type" "complex part type") " that is a " (:term "glossary/subtype" "subtype") " of " (:ref "type/short-float" "single-float") ". A " (:term "glossary/complex single float" "complex single float") " is a " (:term "glossary/complex" "complex") ", but it is not a " (:term "glossary/single float" "single float") "."))))
(:entry "glossary/composite stream" :names ("composite stream") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/stream" "stream") " that is composed of one or more other " (:term "glossary/stream" "streams") ". " "“" (:ref "function/make-synonym-stream" "make-synonym-stream") " creates a composite stream.”"))))
(:entry "glossary/compound form" :names ("compound form") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/non-empty" "non-empty") " " (:term "glossary/list" "list") " which is a " (:term "glossary/form" "form") ": a " (:term "glossary/special form" "special form") ", a " (:term "glossary/lambda form" "lambda form") ", a " (:term "glossary/macro form" "macro form") ", or a " (:term "glossary/function form" "function form") "."))))
(:entry "glossary/compound type specifier" :names ("compound type specifier") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/type specifier" "type specifier") " that is a " (:term "glossary/cons" "cons") "; " (:i "i.e.") ", " "a " (:term "glossary/type specifier" "type specifier") " that is not an " (:term "glossary/atomic type specifier" "atomic type specifier") ". " "“" (:code "(vector single-float)") " is a compound type specifier.”"))))
(:entry "glossary/concatenated stream" :names ("concatenated stream") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " an " (:term "glossary/input" "input") " " (:term "glossary/stream" "stream") " " "of " (:term "glossary/type" "type") " " (:ref "system-class/concatenated-stream" "concatenated-stream") "."))))
(:entry "glossary/condition" :names ("condition") :kind :glossary-term :kind-name "Glossary Term" :summary "an object which represents a situation—usually, but not necessarily, during signaling." :sections (("Definition" (:p (:i "n.")) (:list (:item (:label "1.") (:p "an " (:term "glossary/object" "object") " which represents a " (:term "glossary/situation" "situation") "—usually, but not necessarily, during " (:term "glossary/signal" "signaling") ".")) (:item (:label "2.") (:p "an " (:term "glossary/object" "object") " " "of " (:term "glossary/type" "type") " " (:ref "condition-type/condition" "condition") "."))))))
(:entry "glossary/condition designator" :names ("condition designator") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " one or more " (:term "glossary/object" "objects") " that, taken together, denote either an existing " (:term "glossary/condition" "condition") " " (:term "glossary/object" "object") " or a " (:term "glossary/condition" "condition") " " (:term "glossary/object" "object") " to be implicitly created. For details, " "see " (:secref "ConditionDesignators" "Section 9.1.2.1 (Condition Designators)") "."))))
(:entry "glossary/condition handler" :names ("condition handler") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/function" "function") " that might be invoked by the act of " (:term "glossary/signal" "signaling") ", that receives the " (:term "glossary/condition" "condition") " being signaled as its only argument, and that is permitted to " (:term "glossary/handle" "handle") " the " (:term "glossary/condition" "condition") " or to " (:term "glossary/decline" "decline") ". " "See " (:secref "Signaling" "Section 9.1.4.1 (Signaling)") "."))))
(:entry "glossary/condition reporter" :names ("condition reporter") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/function" "function") " that describes how a " (:term "glossary/condition" "condition") " is to be printed when the " (:term "glossary/lisp printer" "Lisp printer") " is invoked while " (:ref "variable/*print-escape*" "*print-escape*") " is " (:term "glossary/false" "false") ". " "See " (:secref "PrintingConditions" "Section 9.1.3 (Printing Conditions)") "."))))
(:entry "glossary/conditional newline" :names ("conditional newline") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a point in output where a " (:term "glossary/newline" "newline") " might be inserted at the discretion of the " (:term "glossary/pretty printer" "pretty printer") ". There are four kinds of " (:term "glossary/conditional newline" "conditional newlines") ", called “linear-style,” “fill-style,” “miser-style,” and “mandatory-style.” " "See the " (:term "glossary/function" "function") " " (:ref "function/pprint-newline" "pprint-newline") " and " (:secref "DynamicControlofOutput" "Section 22.2.1.1 (Dynamic Control of the Arrangement of Output)") "."))))
(:entry "glossary/conformance" :names ("conformance") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a state achieved by proper and complete adherence to the requirements of this specification. " "See " (:secref "Conformance" "Section 1.5 (Conformance)") "."))))
(:entry "glossary/conforming code" :names ("conforming code") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " " (:term "glossary/code" "code") " that is all of part of a " (:term "glossary/conforming program" "conforming program") "."))))
(:entry "glossary/conforming implementation" :names ("conforming implementation") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " an " (:term "glossary/implementation" "implementation") ", used to emphasize complete and correct adherance to all conformance criteria. A " (:term "glossary/conforming implementation" "conforming implementation") " is capable of accepting a " (:term "glossary/conforming program" "conforming program") " as input, preparing that " (:term "glossary/program" "program") " for " (:term nil "execution") ", and executing the prepared " (:term "glossary/program" "program") " in accordance with this specification. An " (:term "glossary/implementation" "implementation") " which has been extended may still be a " (:term "glossary/conforming implementation" "conforming implementation") " provided that no extension interferes with the correct function of any " (:term "glossary/conforming program" "conforming program") "."))))
(:entry "glossary/conforming processor" :names ("conforming processor") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " (:i "ANSI") " " " a " (:term "glossary/conforming implementation" "conforming implementation") "."))))
(:entry "glossary/conforming program" :names ("conforming program") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/program" "program") ", used to emphasize the fact that the " (:term "glossary/program" "program") " depends for its correctness only upon documented aspects of " "Common Lisp" ", and can therefore be expected to run correctly in any " (:term "glossary/conforming implementation" "conforming implementation") "."))))
(:entry "glossary/congruent" :names ("congruent") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " conforming to the rules of " (:term "glossary/lambda list" "lambda list") " congruency, as detailed in " (:secref "GFMethodLambdaListCongruency" "Section 7.6.4 (Congruent Lambda-lists for all Methods of a Generic Function)") "."))))
(:entry "glossary/cons" :names ("cons") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") (:i "v.")) (:list (:item (:label "1.") (:p (:i "n.") " " "a compound data " (:term "glossary/object" "object") " having two components called the " (:term "glossary/car" "car") " and the " (:term "glossary/cdr" "cdr") ".")) (:item (:label "2.") (:p (:i "v.") " " "to create such an " (:term "glossary/object" "object") ".")) (:item (:label "3.") (:p (:i "v.") " " (:i "Idiom.") " " "to create any " (:term "glossary/object" "object") ", or to allocate storage."))))))
(:entry "glossary/constant" :names ("constant") :kind :glossary-term :kind-name "Glossary Term" :summary "a constant form." :sections (("Definition" (:p (:i "n.")) (:list (:item (:label "1.") (:p "a " (:term "glossary/constant form" "constant form") ".")) (:item (:label "2.") (:p "a " (:term "glossary/constant variable" "constant variable") ".")) (:item (:label "3.") (:p "a " (:term "glossary/constant object" "constant object") ".")) (:item (:label "4.") (:p "a " (:term "glossary/self-evaluating object" "self-evaluating object") "."))))))
(:entry "glossary/constant form" :names ("constant form") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " any " (:term "glossary/form" "form") " for which " (:term "glossary/evaluation" "evaluation") " always " (:term "glossary/yield" "yields") " the same " (:term "glossary/value" "value") ", that neither affects nor is affected by the " (:term "glossary/environment" "environment") " in which it is " (:term "glossary/evaluate" "evaluated") " (except that it is permitted to refer to the names of " (:term "glossary/constant variable" "constant variables") " defined in the " (:term "glossary/environment" "environment") "), and that neither affects nor is affected by the state of any " (:term "glossary/object" "object") " except those " (:term "glossary/object" "objects") " that are " (:term "glossary/otherwise inaccessible part" "otherwise inaccessible parts") " of " (:term "glossary/object" "objects") " created by the " (:term "glossary/form" "form") " itself. " "“A " (:ref "accessor/car" "car") " form in which the argument is a " (:ref "special-operator/quote" "quote") " form is a constant form.”"))))
(:entry "glossary/constant object" :names ("constant object") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " an " (:term "glossary/object" "object") " that is constrained (" (:i "e.g.") ", " "by its context in a " (:term "glossary/program" "program") " or by the source from which it was obtained) to be " (:term "glossary/immutable" "immutable") ". " "“A literal object that has been processed by " (:ref "function/compile-file" "compile-file") " is a constant object.”"))))
(:entry "glossary/constant variable" :names ("constant variable") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/variable" "variable") ", the " (:term "glossary/value" "value") " of which can never change; that is, a " (:term "glossary/keyword" "keyword") (:sense "1") " or a " (:term "glossary/named constant" "named constant") ". " "“The symbols " (:ref "constant-variable/t" "t") ", " (:ref "constant-variable/nil" "nil") ", " (:code ":direction") ", and " (:ref "constant-variable/most-positive-fixnum" "most-positive-fixnum") " " "are constant variables.”"))))
(:entry "glossary/constituent" :names ("constituent") :kind :glossary-term :kind-name "Glossary Term" :summary "a." :sections (("Definition" (:p (:i "n.") ", " (:i "adj.")) (:list (:item (:label "1.") (:p "a. " (:i "n.") " " "the " (:term "glossary/syntax type" "syntax type") " of a " (:term "glossary/character" "character") " that is part of a " (:term "glossary/token" "token") ". For details, " "see " (:secref "ConstituentChars" "Section 2.1.4.1 (Constituent Characters)") ". b. " (:i "adj.") " " "(of a " (:term "glossary/character" "character") ") having the " (:term "glossary/constituent" "constituent") (:sense "1a") " " (:term "glossary/syntax type" "syntax type") (:sense "2") ". c. " (:i "n.") " " "a " (:term "glossary/constituent" "constituent") (:sense "1b") " " (:term "glossary/character" "character") ".")) (:item (:label "2.") (:p (:i "n.") " " "(of a " (:term "glossary/composite stream" "composite stream") ") one of possibly several " (:term "glossary/object" "objects") " that collectively comprise the source or sink of that " (:term "glossary/stream" "stream") "."))))))
(:entry "glossary/constituent trait" :names ("constituent trait") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " "(of a " (:term "glossary/character" "character") ") one of several classifications of a " (:term "glossary/constituent" "constituent") " " (:term "glossary/character" "character") " in a " (:term "glossary/readtable" "readtable") ". " "See " (:secref "ConstituentChars" "Section 2.1.4.1 (Constituent Characters)") "."))))
(:entry "glossary/constructed stream" :names ("constructed stream") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/stream" "stream") " whose source or sink is a Lisp " (:term "glossary/object" "object") ". Note that since a " (:term "glossary/stream" "stream") " is another Lisp " (:term "glossary/object" "object") ", " (:term "glossary/composite stream" "composite streams") " are considered " (:term "glossary/constructed stream" "constructed streams") ". " "“A string stream is a constructed stream.”"))))
(:entry "glossary/contagion" :names ("contagion") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a process whereby operations on " (:term "glossary/object" "objects") " of differing " (:term "glossary/type" "types") " (" (:i "e.g.") ", " "arithmetic on mixed " (:term "glossary/type" "types") " of " (:term "glossary/number" "numbers") ") produce a result whose " (:term "glossary/type" "type") " is controlled by the dominance of one " (:term "glossary/argument" "argument") "’s " (:term "glossary/type" "type") " over the " (:term "glossary/type" "types") " of the other " (:term "glossary/argument" "arguments") ". " "See " (:secref "NumericContagionRules" "Section 12.1.1.2 (Contagion in Numeric Operations)") "."))))
(:entry "glossary/continuable" :names ("continuable") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " "(of an " (:term "glossary/error" "error") ") an " (:term "glossary/error" "error") " that is " (:term "glossary/correctable" "correctable") " by the " (:code "continue") " restart."))))
(:entry "glossary/control form" :names ("control form") :kind :glossary-term :kind-name "Glossary Term" :summary "a form that establishes one or more places to which control can be transferred." :sections (("Definition" (:p (:i "n.")) (:list (:item (:label "1.") (:p "a " (:term "glossary/form" "form") " that establishes one or more places to which control can be transferred.")) (:item (:label "2.") (:p "a " (:term "glossary/form" "form") " that transfers control."))))))
(:entry "glossary/copy" :names ("copy") :kind :glossary-term :kind-name "Glossary Term" :summary "(of a cons C) a fresh cons with the same car and cdr as C." :sections (("Definition" (:p (:i "n.")) (:list (:item (:label "1.") (:p "(of a " (:term "glossary/cons" "cons") " " (:math "C") ") a " (:term "glossary/fresh" "fresh") " " (:term "glossary/cons" "cons") " with the " (:term "glossary/same" "same") " " (:term "glossary/car" "car") " and " (:term "glossary/cdr" "cdr") " as " (:math "C") ".")) (:item (:label "2.") (:p "(of a " (:term "glossary/list" "list") " " (:math "L") ") a " (:term "glossary/fresh" "fresh") " " (:term "glossary/list" "list") " with the " (:term "glossary/same" "same") " " (:term "glossary/element" "elements") " as " (:math "L") ". (Only the " (:term "glossary/list structure" "list structure") " is " (:term "glossary/fresh" "fresh") "; the " (:term "glossary/element" "elements") " are the " (:term "glossary/same" "same") ".) " "See the " (:term "glossary/function" "function") " " (:ref "function/copy-list" "copy-list") ".")) (:item (:label "3.") (:p "(of an " (:term "glossary/association list" "association list") " " (:math "A") " with " (:term "glossary/element" "elements") " " (:math "A" (:sub "i")) ") a " (:term "glossary/fresh" "fresh") " " (:term "glossary/list" "list") " " (:math "B") " with " (:term "glossary/element" "elements") " " (:math "B" (:sub "i")) ", each of which is " (:ref "constant-variable/nil" "nil") " " "if " (:math "A" (:sub "i")) " is " (:ref "constant-variable/nil" "nil") ", or else a " (:term "glossary/copy" "copy") " of the " (:term "glossary/cons" "cons") " " (:math "A" (:sub "i")) ". " "See the " (:term "glossary/function" "function") " " (:ref "function/copy-alist" "copy-alist") ".")) (:item (:label "4.") (:p "(of a " (:term "glossary/tree" "tree") " " (:math "T") ") a " (:term "glossary/fresh" "fresh") " " (:term "glossary/tree" "tree") " with the " (:term "glossary/same" "same") " " (:term nil "leaves") " as " (:math "T") ". " "See the " (:term "glossary/function" "function") " " (:ref "function/copy-tree" "copy-tree") ".")) (:item (:label "5.") (:p "(of a " (:term "glossary/random state" "random state") " " (:math "R") ") a " (:term "glossary/fresh" "fresh") " " (:term "glossary/random state" "random state") " that, if used as an argument to to " "the " (:term "glossary/function" "function") " " (:ref "function/random" "random") " would produce the same series of “random” values as " (:math "R") " would produce.")) (:item (:label "6.") (:p "(of a " (:term "glossary/structure" "structure") " " (:math "S") ") a " (:term "glossary/fresh" "fresh") " " (:term "glossary/structure" "structure") " that has the same " (:term "glossary/type" "type") " as " (:math "S") ", and that has slot values, each of which is the " (:term "glossary/same" "same") " as the corresponding slot value of " (:math "S") ".") (:p "(Note that since the difference between a " (:term "glossary/cons" "cons") ", a " (:term "glossary/list" "list") ", and a " (:term "glossary/tree" "tree") " is a matter of “view” or “intention,” there can be no general-purpose " (:term "glossary/function" "function") " which, based solely on the " (:term "glossary/type" "type") " of an " (:term "glossary/object" "object") ", can determine which of these distinct meanings is intended. The distinction rests solely on the basis of the text description within this document. For example, phrases like “a " (:term "glossary/copy" "copy") " of the given " (:term "glossary/list" "list") "” or “copy of the " (:term "glossary/list" "list") " " (:param "x") "” imply the second definition.)"))))))
(:entry "glossary/correctable" :names ("correctable") :kind :glossary-term :kind-name "Glossary Term" :summary "adj." :sections (("Definition" (:p (:i "adj.") " " "(of an " (:term "glossary/error" "error") ")") (:list (:item (:label "1.") (:p "(by a " (:term "glossary/restart" "restart") " other than " (:ref "restart/abort" "abort") " that has been associated with the " (:term "glossary/error" "error") ") capable of being corrected by invoking that " (:term "glossary/restart" "restart") ". " "“The function " (:ref "function/cerror" "cerror") " signals an error that is correctable by the " (:ref "restart/continue" "continue") " " (:term "glossary/restart" "restart") ".”" " " " (Note that correctability is not a property of an " (:term "glossary/error" "error") " " (:term "glossary/object" "object") ", but rather a property of the " (:term "glossary/dynamic environment" "dynamic environment") " that is in effect when the " (:term "glossary/error" "error") " is " (:term "glossary/signal" "signaled") ". Specifically, the " (:term "glossary/restart" "restart") " is “associated with” the " (:term "glossary/error" "error") " " (:term "glossary/condition" "condition") " " (:term "glossary/object" "object") ". " "See " (:secref "AssocRestartWithCond" "Section 9.1.4.2.4 (Associating a Restart with a Condition)") ".)")) (:item (:label "2.") (:p "(when no specific " (:term "glossary/restart" "restart") " is mentioned) " (:term "glossary/correctable" "correctable") (:sense "1") " by at least one " (:term "glossary/restart" "restart") ". " "“" (:ref "function/import" "import") " signals a correctable error " "of " (:term "glossary/type" "type") " " (:ref "condition-type/package-error" "package-error") " if any of the imported symbols has the same name as some distinct symbol already accessible in the package.”"))))))
(:entry "glossary/current input base" :names ("current input base") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " "(in a " (:term "glossary/dynamic environment" "dynamic environment") ") the " (:term "glossary/radix" "radix") " that is " "the " (:term "glossary/value" "value") " of " (:ref "variable/*read-base*" "*read-base*") " in that " (:term "glossary/environment" "environment") ", and that is the default " (:term "glossary/radix" "radix") " employed by the " (:term "glossary/lisp reader" "Lisp reader") " and its related " (:term "glossary/function" "functions") "."))))
(:entry "glossary/current logical block" :names ("current logical block") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " the context of the innermost lexically enclosing use of " (:ref "macro/pprint-logical-block" "pprint-logical-block") "."))))
(:entry "glossary/current output base" :names ("current output base") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " "(in a " (:term "glossary/dynamic environment" "dynamic environment") ") the " (:term "glossary/radix" "radix") " that is " "the " (:term "glossary/value" "value") " of " (:ref "variable/*print-base*" "*print-base*") " in that " (:term "glossary/environment" "environment") ", and that is the default " (:term "glossary/radix" "radix") " employed by the " (:term "glossary/lisp printer" "Lisp printer") " and its related " (:term "glossary/function" "functions") "."))))
(:entry "glossary/current package" :names ("current package") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " "(in a " (:term "glossary/dynamic environment" "dynamic environment") ") the " (:term "glossary/package" "package") " that is " "the " (:term "glossary/value" "value") " of " (:ref "variable/*package*" "*package*") " in that " (:term "glossary/environment" "environment") ", and that is the default " (:term "glossary/package" "package") " employed by the " (:term "glossary/lisp reader" "Lisp reader") " and " (:term "glossary/lisp printer" "Lisp printer") ", and their related " (:term "glossary/function" "functions") "."))))
(:entry "glossary/current pprint dispatch table" :names ("current pprint dispatch table") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " "(in a " (:term "glossary/dynamic environment" "dynamic environment") ") the " (:term "glossary/pprint dispatch table" "pprint dispatch table") " that is " "the " (:term "glossary/value" "value") " of " (:ref "variable/*print-pprint-dispatch*" "*print-pprint-dispatch*") " in that " (:term "glossary/environment" "environment") ", and that is the default " (:term "glossary/pprint dispatch table" "pprint dispatch table") " employed by the " (:term "glossary/pretty printer" "pretty printer") "."))))
(:entry "glossary/current random state" :names ("current random state") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " "(in a " (:term "glossary/dynamic environment" "dynamic environment") ") the " (:term "glossary/random state" "random state") " that is " "the " (:term "glossary/value" "value") " of " (:ref "variable/*random-state*" "*random-state*") " in that " (:term "glossary/environment" "environment") ", and that is the default " (:term "glossary/random state" "random state") " employed by " (:ref "function/random" "random") "."))))
(:entry "glossary/current readtable" :names ("current readtable") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " "(in a " (:term "glossary/dynamic environment" "dynamic environment") ") the " (:term "glossary/readtable" "readtable") " that is " "the " (:term "glossary/value" "value") " of " (:ref "variable/*readtable*" "*readtable*") " in that " (:term "glossary/environment" "environment") ", and that affects the way in which " (:term "glossary/expression" "expressions") (:sense "2") " are parsed into " (:term "glossary/object" "objects") " by the " (:term "glossary/lisp reader" "Lisp reader") "."))))
(:entry "glossary/data type" :names ("data type") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " (:i "Trad.") " " " a " (:term "glossary/type" "type") "."))))
(:entry "glossary/debug i/o" :names ("debug I/O") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " the " (:term "glossary/bidirectional" "bidirectional") " " (:term "glossary/stream" "stream") " that is the " (:term "glossary/value" "value") " of " "the " (:term "glossary/variable" "variable") " " (:ref "variable/*debug-io*" "*debug-io*") "."))))
(:entry "glossary/debugger" :names ("debugger") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a facility that allows the " (:term "glossary/user" "user") " to handle a " (:term "glossary/condition" "condition") " interactively. For example, the " (:term "glossary/debugger" "debugger") " might permit interactive selection of a " (:term "glossary/restart" "restart") " from among the " (:term "glossary/active" "active") " " (:term "glossary/restart" "restarts") ", and it might perform additional " (:term "glossary/implementation-defined" "implementation-defined") " services for the purposes of debugging."))))
(:entry "glossary/declaration" :names ("declaration") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/global declaration" "global declaration") " or " (:term "glossary/local declaration" "local declaration") "."))))
(:entry "glossary/declaration identifier" :names ("declaration identifier") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " one of the " (:term "glossary/symbol" "symbols") " " (:ref "declaration/declaration" "declaration") ", " (:ref "declaration/dynamic-extent" "dynamic-extent") ", " (:ref "declaration/ftype" "ftype") ", " (:ref "special-operator/function" "function") ", " (:ref "declaration/ignore" "ignore") ", " (:ref "declaration/inline" "inline") ", " (:ref "declaration/inline" "notinline") ", " (:ref "declaration/optimize" "optimize") ", " (:ref "declaration/special" "special") ", or " (:ref "declaration/type" "type") "; or a " (:term "glossary/symbol" "symbol") " which is the " (:term "glossary/name" "name") " of a " (:term "glossary/type" "type") "; or a " (:term "glossary/symbol" "symbol") " which has been " (:term "glossary/declare" "declared") " to be a " (:term "glossary/declaration identifier" "declaration identifier") " by using a " (:ref "declaration/declaration" "declaration") " " (:term "glossary/declaration" "declaration") "."))))
(:entry "glossary/declaration specifier" :names ("declaration specifier") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " an " (:term "glossary/expression" "expression") " that can appear at top level of a " (:ref "symbol/declare" "declare") " expression or a " (:ref "macro/declaim" "declaim") " form, or as the argument to " (:ref "function/proclaim" "proclaim") ", and which has a " (:term "glossary/car" "car") " which is a " (:term "glossary/declaration identifier" "declaration identifier") ", and which has a " (:term "glossary/cdr" "cdr") " that is data interpreted according to rules specific to the " (:term "glossary/declaration identifier" "declaration identifier") "."))))
(:entry "glossary/declare" :names ("declare") :kind :glossary-term :kind-name "Glossary Term" :summary "v." :sections (("Definition" (:p (:i "v.") " " " to " (:term "glossary/establish" "establish") " a " (:term "glossary/declaration" "declaration") ". " "See " (:code "") "declare" ", " (:ref "macro/declaim" "declaim") ", or " (:ref "function/proclaim" "proclaim") "."))))
(:entry "glossary/decline" :names ("decline") :kind :glossary-term :kind-name "Glossary Term" :summary "v." :sections (("Definition" (:p (:i "v.") " " "(of a " (:term "glossary/handler" "handler") ") to return normally without having " (:term "glossary/handle" "handled") " the " (:term "glossary/condition" "condition") " being " (:term "glossary/signal" "signaled") ", permitting the signaling process to continue as if the " (:term "glossary/handler" "handler") " had not been present."))))
(:entry "glossary/decoded time" :names ("decoded time") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " " (:term "glossary/absolute" "absolute") " " (:term "glossary/time" "time") ", represented as an ordered series of nine " (:term "glossary/object" "objects") " which, taken together, form a description of a point in calendar time, accurate to the nearest second (except that " (:term "glossary/leap seconds" "leap seconds") " are ignored). " "See " (:secref "DecodedTime" "Section 25.1.4.1 (Decoded Time)") "."))))
(:entry "glossary/default method" :names ("default method") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/method" "method") " having no " (:term "glossary/parameter specializer" "parameter specializers") " other than " "the " (:term "glossary/class" "class") " " (:ref "system-class/t" "t") ". Such a " (:term "glossary/method" "method") " is always an " (:term "glossary/applicable method" "applicable method") " but might be " (:term "glossary/shadow" "shadowed") (:sense "2") " by a more specific " (:term "glossary/method" "method") "."))))
(:entry "glossary/defaulted initialization argument list" :names ("defaulted initialization argument list") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/list" "list") " of alternating initialization argument " (:term "glossary/name" "names") " and " (:term "glossary/value" "values") " in which unsupplied initialization arguments are defaulted, used in the protocol for initializing and reinitializing " (:term "glossary/instance" "instances") " of " (:term "glossary/class" "classes") "."))))
(:entry "glossary/define-method-combination arguments lambda list" :names ("define-method-combination arguments lambda list") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/lambda list" "lambda list") " used by the " (:code ":arguments") " option to " (:ref "macro/define-method-combination" "define-method-combination") ". " "See " (:secref "DefMethCombArgsLambdaLists" "Section 3.4.10 (Define-method-combination Arguments Lambda Lists)") "."))))
(:entry "glossary/define-modify-macro lambda list" :names ("define-modify-macro lambda list") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/lambda list" "lambda list") " used by " (:ref "macro/define-modify-macro" "define-modify-macro") ". " "See " (:secref "DefineModifyMacroLambdaLists" "Section 3.4.9 (Define-modify-macro Lambda Lists)") "."))))
(:entry "glossary/defined name" :names ("defined name") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/symbol" "symbol") " the meaning of which is defined by " "Common Lisp" "."))))
(:entry "glossary/defining form" :names ("defining form") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/form" "form") " that has the side-effect of " (:term "glossary/establish" "establishing") " a definition. " "“" (:ref "macro/defun" "defun") " and " (:ref "macro/defparameter" "defparameter") " are defining forms.”"))))
(:entry "glossary/defsetf lambda list" :names ("defsetf lambda list") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/lambda list" "lambda list") " that is like an " (:term "glossary/ordinary lambda list" "ordinary lambda list") " except that it does not permit " (:code "&aux") " and that it permits use of " (:code "&environment") ". " "See " (:secref "DefsetfLambdaLists" "Section 3.4.7 (Defsetf Lambda Lists)") "."))))
(:entry "glossary/deftype lambda list" :names ("deftype lambda list") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/lambda list" "lambda list") " that is like a " (:term "glossary/macro lambda list" "macro lambda list") " except that the default " (:term "glossary/value" "value") " for unsupplied " (:term "glossary/optional parameter" "optional parameters") " and " (:term "glossary/keyword parameter" "keyword parameters") " is the " (:term "glossary/symbol" "symbol") " " (:ref "variable/*" "*") " (rather than " (:ref "constant-variable/nil" "nil") "). " "See " (:secref "DeftypeLambdaLists" "Section 3.4.8 (Deftype Lambda Lists)") "."))))
(:entry "glossary/denormalized" :names ("denormalized") :kind :glossary-term :kind-name "Glossary Term" :summary "adj., ANSI, IEEE (of a float) conforming to the description of “denormalized” as described by IEEE Standard for Binary Floating-Point Arithmetic." :sections (("Definition" (:p (:i "adj.") ", " (:i "ANSI") ", " (:i "IEEE") " " "(of a " (:term "glossary/float" "float") ") conforming to the description of “denormalized” as described by " "IEEE Standard for Binary Floating-Point Arithmetic" ". For example, in an " (:term "glossary/implementation" "implementation") " where the minimum possible exponent was " (:code "-7") " but where " (:code "0.001") " was a valid mantissa, the number " (:code "1.0e-10") " might be representable as " (:code "0.001e-7") " internally even if the " (:term "glossary/normalized" "normalized") " representation would call for it to be represented instead as " (:code "1.0e-10") " or " (:code "0.1e-9") ". By their nature, " (:term "glossary/denormalized" "denormalized") " " (:term "glossary/float" "floats") " generally have less precision than " (:term "glossary/normalized" "normalized") " " (:term "glossary/float" "floats") "."))))
(:entry "glossary/derived type" :names ("derived type") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/type specifier" "type specifier") " which is defined in terms of an expansion into another " (:term "glossary/type specifier" "type specifier") ". " (:ref "macro/deftype" "deftype") " defines " (:term "glossary/derived type" "derived types") ", and there may be other " (:term "glossary/implementation-defined" "implementation-defined") " " (:term "glossary/operator" "operators") " which do so as well."))))
(:entry "glossary/derived type specifier" :names ("derived type specifier") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/type specifier" "type specifier") " for a " (:term "glossary/derived type" "derived type") "."))))
(:entry "glossary/designator" :names ("designator") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " an " (:term "glossary/object" "object") " that denotes another " (:term "glossary/object" "object") ". In the dictionary entry for an " (:term "glossary/operator" "operator") " if a " (:term "glossary/parameter" "parameter") " is described as a " (:term "glossary/designator" "designator") " for a " (:term "glossary/type" "type") ", the description of the " (:term "glossary/operator" "operator") " is written in a way that assumes that appropriate coercion to that " (:term "glossary/type" "type") " has already occurred; that is, that the " (:term "glossary/parameter" "parameter") " is already of the denoted " (:term "glossary/type" "type") ". For more detailed information, " "see " (:secref "Designators" "Section 1.4.1.5 (Designators)") "."))))
(:entry "glossary/destructive" :names ("destructive") :kind :glossary-term :kind-name "Glossary Term" :summary "adj." :sections (("Definition" (:p (:i "adj.") " " "(of an " (:term "glossary/operator" "operator") ") capable of modifying some program-visible aspect of one or more " (:term "glossary/object" "objects") " that are either explicit " (:term "glossary/argument" "arguments") " to the " (:term "glossary/operator" "operator") " or that can be obtained directly or indirectly from the " (:term "glossary/global environment" "global environment") " by the " (:term "glossary/operator" "operator") "."))))
(:entry "glossary/destructuring lambda list" :names ("destructuring lambda list") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " an " (:term "glossary/extended lambda list" "extended lambda list") " used in " (:ref "macro/destructuring-bind" "destructuring-bind") " and nested within " (:term "glossary/macro lambda list" "macro lambda lists") ". " "See " (:secref "DestructuringLambdaLists" "Section 3.4.5 (Destructuring Lambda Lists)") "."))))
(:entry "glossary/different" :names ("different") :kind :glossary-term :kind-name "Glossary Term" :summary "adj." :sections (("Definition" (:p (:i "adj.") " " " not the " (:term "glossary/same" "same") " " "“The strings " (:code "\"FOO\"") " and " (:code "\"foo\"") " are different under " (:ref "function/equal" "equal") " but not under " (:ref "function/equalp" "equalp") ".”"))))
(:entry "glossary/digit" :names ("digit") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " "(in a " (:term "glossary/radix" "radix") ") a " (:term "glossary/character" "character") " that is among the possible digits (" (:code "0") " to " (:code "9") ", " (:code "A") " to " (:code "Z") ", and " (:code "a") " to " (:code "z") ") and that is defined to have an associated numeric weight as a digit in that " (:term "glossary/radix" "radix") ". " "See " (:secref "Digits" "Section 13.1.4.6 (Digits in a Radix)") "."))))
(:entry "glossary/dimension" :names ("dimension") :kind :glossary-term :kind-name "Glossary Term" :summary "a non-negative integer indicating the number of objects an array can hold along one axis." :sections (("Definition" (:p (:i "n.")) (:list (:item (:label "1.") (:p "a non-negative " (:term "glossary/integer" "integer") " indicating the number of " (:term "glossary/object" "objects") " an " (:term "glossary/array" "array") " can hold along one axis. If the " (:term "glossary/array" "array") " is a " (:term "glossary/vector" "vector") " with a " (:term "glossary/fill pointer" "fill pointer") ", the " (:term "glossary/fill pointer" "fill pointer") " is ignored. " "“The second dimension of that array is 7.”")) (:item (:label "2.") (:p "an axis of an array. " "“This array has six dimensions.”"))))))
(:entry "glossary/direct instance" :names ("direct instance") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " "(of a " (:term "glossary/class" "class") " " (:math "C") ") an " (:term "glossary/object" "object") " whose " (:term "glossary/class" "class") " is " (:math "C") " itself, rather than some " (:term "glossary/subclass" "subclass") " of " (:math "C") ". " "“The function " (:ref "standard-generic-function/make-instance" "make-instance") " always returns a direct instance of the class which is (or is named by) its first argument.”"))))
(:entry "glossary/direct subclass" :names ("direct subclass") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " "(of a " (:term "glossary/class" "class") " " (:math "C" (:sub "1")) ") a " (:term "glossary/class" "class") " " (:math "C" (:sub "2")) ", such that " (:math "C" (:sub "1")) " is a " (:term "glossary/direct superclass" "direct superclass") " of " (:math "C" (:sub "2")) "."))))
(:entry "glossary/direct superclass" :names ("direct superclass") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " "(of a " (:term "glossary/class" "class") " " (:math "C" (:sub "1")) ") a " (:term "glossary/class" "class") " " (:math "C" (:sub "2")) " which was explicitly designated as a " (:term "glossary/superclass" "superclass") " of " (:math "C" (:sub "1")) " in the definition of " (:math "C" (:sub "1")) "."))))
(:entry "glossary/disestablish" :names ("disestablish") :kind :glossary-term :kind-name "Glossary Term" :summary "v.t." :sections (("Definition" (:p (:i "v.t.") " " " to withdraw the " (:term nil "establishment") " of an " (:term "glossary/object" "object") ", a " (:term "glossary/binding" "binding") ", an " (:term "glossary/exit point" "exit point") ", a " (:term "glossary/tag" "tag") ", a " (:term "glossary/handler" "handler") ", a " (:term "glossary/restart" "restart") ", or an " (:term "glossary/environment" "environment") "."))))
(:entry "glossary/disjoint" :names ("disjoint") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " "(of " (:term "glossary/type" "types") ") having no " (:term "glossary/element" "elements") " in common."))))
(:entry "glossary/dispatching macro character" :names ("dispatching macro character") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/macro character" "macro character") " that has an associated table that specifies the " (:term "glossary/function" "function") " to be called for each " (:term "glossary/character" "character") " that is seen following the " (:term "glossary/dispatching macro character" "dispatching macro character") ". " "See the " (:term "glossary/function" "function") " " (:ref "function/make-dispatch-macro-character" "make-dispatch-macro-character") "."))))
(:entry "glossary/displaced array" :names ("displaced array") :kind :glossary-term :kind-name "Glossary Term" :summary "an array which has no storage of its own, but which is instead indirected to the storage of another array, called its target, at a specified offset, in such a way that any attempt to access the…" :sections (("Definition" (:p (:i "n.")) (:p "an " (:term "glossary/array" "array") " which has no storage of its own, but which is instead indirected to the storage of another " (:term "glossary/array" "array") ", called its " (:term "glossary/target" "target") ", at a specified offset, in such a way that any attempt to " (:term "glossary/access" "access") " the " (:term "glossary/displaced array" "displaced array") " implicitly references the " (:term "glossary/target" "target") " " (:term "glossary/array" "array") "."))))
(:entry "glossary/distinct" :names ("distinct") :kind :glossary-term :kind-name "Glossary Term" :summary "adj." :sections (("Definition" (:p (:i "adj.") " " " not " (:term "glossary/identical" "identical") "."))))
(:entry "glossary/documentation string" :names ("documentation string") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " "(in a defining " (:term "glossary/form" "form") ") A " (:term "glossary/literal" "literal") " " (:term "glossary/string" "string") " which because of the context in which it appears (rather than because of some intrinsically observable aspect of the " (:term "glossary/string" "string") ") is taken as documentation. In some cases, the " (:term "glossary/documentation string" "documentation string") " is saved in such a way that it can later be obtained by supplying either an " (:term "glossary/object" "object") ", or by supplying a " (:term "glossary/name" "name") " and a “kind” to " "the " (:term "glossary/function" "function") " " (:ref "standard-generic-function/documentation" "documentation") ". " "“The body of code in a " (:ref "macro/defmacro" "defmacro") " form can be preceded by a documentation string of kind " (:ref "special-operator/function" "function") ".”"))))
(:entry "glossary/dot" :names ("dot") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " the " (:term "glossary/standard character" "standard character") " that is variously called “full stop,” “period,” or “dot” (" (:code ".") "). " "See " (:secref "StdCharsThree" "Figure~2--5") "."))))
(:entry "glossary/dotted list" :names ("dotted list") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/list" "list") " which has a terminating " (:term "glossary/atom" "atom") " that is not " (:ref "constant-variable/nil" "nil") ". (An " (:term "glossary/atom" "atom") " by itself is not a " (:term "glossary/dotted list" "dotted list") ", however.)"))))
(:entry "glossary/dotted pair" :names ("dotted pair") :kind :glossary-term :kind-name "Glossary Term" :summary "a cons whose cdr is a non-list." :sections (("Definition" (:p (:i "n.")) (:list (:item (:label "1.") (:p "a " (:term "glossary/cons" "cons") " whose " (:term "glossary/cdr" "cdr") " is a " (:term "glossary/non-list" "non-list") ".")) (:item (:label "2.") (:p "any " (:term "glossary/cons" "cons") ", used to emphasize the use of the " (:term "glossary/cons" "cons") " as a symmetric data pair."))))))
(:entry "glossary/double float" :names ("double float") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " an " (:term "glossary/object" "object") " " "of " (:term "glossary/type" "type") " " (:ref "type/short-float" "double-float") "."))))
(:entry "glossary/double-quote" :names ("double-quote") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " the " (:term "glossary/standard character" "standard character") " that is variously called “quotation mark” or “double quote” (" (:code "\"") "). " "See " (:secref "StdCharsThree" "Figure~2--5") "."))))
(:entry "glossary/dynamic binding" :names ("dynamic binding") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/binding" "binding") " in a " (:term "glossary/dynamic environment" "dynamic environment") "."))))
(:entry "glossary/dynamic environment" :names ("dynamic environment") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " that part of an " (:term "glossary/environment" "environment") " that contains " (:term "glossary/binding" "bindings") " with " (:term "glossary/dynamic extent" "dynamic extent") ". A " (:term "glossary/dynamic environment" "dynamic environment") " contains,") (:p "among other things: " (:term "glossary/exit point" "exit points") " established by " (:ref "special-operator/unwind-protect" "unwind-protect") ", and " (:term "glossary/binding" "bindings") " of " (:term "glossary/dynamic variable" "dynamic variables") ", " (:term "glossary/exit point" "exit points") " established by " (:ref "special-operator/catch" "catch") ", " (:term "glossary/condition handler" "condition handlers") ", and " (:term "glossary/restart" "restarts") "."))))
(:entry "glossary/dynamic extent" :names ("dynamic extent") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " an " (:term "glossary/extent" "extent") " whose duration is bounded by points of " (:term nil "establishment") " and " (:term nil "disestablishment") " within the execution of a particular " (:term "glossary/form" "form") ". " "See " (:term "glossary/indefinite extent" "indefinite extent") ". " "“Dynamic variable bindings have dynamic extent.”"))))
(:entry "glossary/dynamic scope" :names ("dynamic scope") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " " (:term "glossary/indefinite scope" "indefinite scope") " along with " (:term "glossary/dynamic extent" "dynamic extent") "."))))
(:entry "glossary/dynamic variable" :names ("dynamic variable") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/variable" "variable") " the " (:term "glossary/binding" "binding") " for which is in the " (:term "glossary/dynamic environment" "dynamic environment") ". " "See " (:code "") "special" "."))))
(:entry "glossary/echo stream" :names ("echo stream") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/stream" "stream") " " "of " (:term "glossary/type" "type") " " (:ref "system-class/echo-stream" "echo-stream") "."))))
(:entry "glossary/effective method" :names ("effective method") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " the combination of " (:term "glossary/applicable method" "applicable methods") " that are executed when a " (:term "glossary/generic function" "generic function") " is invoked with a particular sequence of " (:term "glossary/argument" "arguments") "."))))
(:entry "glossary/element" :names ("element") :kind :glossary-term :kind-name "Glossary Term" :summary "(of a list) an object that is the car of one of the conses that comprise the list." :sections (("Definition" (:p (:i "n.")) (:list (:item (:label "1.") (:p "(of a " (:term "glossary/list" "list") ") an " (:term "glossary/object" "object") " that is the " (:term "glossary/car" "car") " of one of the " (:term "glossary/cons" "conses") " that comprise the " (:term "glossary/list" "list") ".")) (:item (:label "2.") (:p "(of an " (:term "glossary/array" "array") ") an " (:term "glossary/object" "object") " that is stored in the " (:term "glossary/array" "array") ".")) (:item (:label "3.") (:p "(of a " (:term "glossary/sequence" "sequence") ") an " (:term "glossary/object" "object") " that is an " (:term "glossary/element" "element") " of the " (:term "glossary/list" "list") " or " (:term "glossary/array" "array") " that is the " (:term "glossary/sequence" "sequence") ".")) (:item (:label "4.") (:p "(of a " (:term "glossary/type" "type") ") an " (:term "glossary/object" "object") " that is a member of the set of " (:term "glossary/object" "objects") " designated by the " (:term "glossary/type" "type") ".")) (:item (:label "5.") (:p "(of an " (:term "glossary/input" "input") " " (:term "glossary/stream" "stream") ") a " (:term "glossary/character" "character") " or " (:term "glossary/number" "number") " (as appropriate to the " (:term "glossary/element type" "element type") " of the " (:term "glossary/stream" "stream") ") that is among the ordered series of " (:term "glossary/object" "objects") " that can be read from the " (:term "glossary/stream" "stream") " (using " (:ref "function/read-char" "read-char") " or " (:ref "function/read-byte" "read-byte") ", as appropriate to the " (:term "glossary/stream" "stream") ").")) (:item (:label "6.") (:p "(of an " (:term "glossary/output" "output") " " (:term "glossary/stream" "stream") ") a " (:term "glossary/character" "character") " or " (:term "glossary/number" "number") " (as appropriate to the " (:term "glossary/element type" "element type") " of the " (:term "glossary/stream" "stream") ") that is among the ordered series of " (:term "glossary/object" "objects") " that has been or will be written to the " (:term "glossary/stream" "stream") " (using " (:ref "function/write-char" "write-char") " or " (:ref "function/write-byte" "write-byte") ", as appropriate to the " (:term "glossary/stream" "stream") ").")) (:item (:label "7.") (:p "(of a " (:term "glossary/class" "class") ") a " (:term "glossary/generalized instance" "generalized instance") " of the " (:term "glossary/class" "class") "."))))))
(:entry "glossary/element type" :names ("element type") :kind :glossary-term :kind-name "Glossary Term" :summary "(of an array) the array element type of the array." :sections (("Definition" (:p (:i "n.")) (:list (:item (:label "1.") (:p "(of an " (:term "glossary/array" "array") ") the " (:term "glossary/array element type" "array element type") " of the " (:term "glossary/array" "array") ".")) (:item (:label "2.") (:p "(of a " (:term "glossary/stream" "stream") ") the " (:term "glossary/stream element type" "stream element type") " of the " (:term "glossary/stream" "stream") "."))))))
(:entry "glossary/em" :names ("em") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " (:i "Trad.") " " " a context-dependent unit of measure commonly used in typesetting, equal to the displayed width of of a letter “M” in the current font. (The letter “M” is traditionally chosen because it is typically represented by the widest " (:term "glossary/glyph" "glyph") " in the font, and other characters’ widths are typically fractions of an " (:term "glossary/em" "em") ". In implementations providing non-Roman characters with wider characters than “M,” it is permissible for another character to be the " (:term "glossary/implementation-defined" "implementation-defined") " reference character for this measure, and for “M” to be only a fraction of an " (:term "glossary/em" "em") " wide.) In a fixed width font, a line with " (:i "n") " characters is " (:i "n") " " (:term "glossary/em" "ems") " wide; in a variable width font, " (:i "n") " " (:term "glossary/em" "ems") " is the expected upper bound on the width of such a line."))))
(:entry "glossary/empty list" :names ("empty list") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " the " (:term "glossary/list" "list") " containing no " (:term "glossary/element" "elements") ". " "See " (:term "glossary/()" "()") "."))))
(:entry "glossary/empty type" :names ("empty type") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " the " (:term "glossary/type" "type") " that contains no " (:term "glossary/element" "elements") ", and that is a " (:term "glossary/subtype" "subtype") " of all " (:term "glossary/type" "types") " (including itself). " "See " (:term "glossary/nil" "nil") "."))))
(:entry "glossary/end of file" :names ("end of file") :kind :glossary-term :kind-name "Glossary Term" :summary "the point in an input stream beyond which there is no further data." :sections (("Definition" (:p (:i "n.")) (:list (:item (:label "1.") (:p "the point in an " (:term "glossary/input" "input") " " (:term "glossary/stream" "stream") " beyond which there is no further data. Whether or not there is such a point on an " (:term "glossary/interactive stream" "interactive stream") " is " (:term "glossary/implementation-defined" "implementation-defined") ".")) (:item (:label "2.") (:p "a " (:term "glossary/situation" "situation") " that occurs upon an attempt to obtain data from an " (:term nil "input stream") " that is at the " (:term "glossary/end of file" "end of file") (:sense "1") "."))))))
(:entry "glossary/end of line" :names ("end of line") :kind :glossary-term :kind-name "Glossary Term" :sections (("Definition" (:p (:i "n.")))))
(:entry "glossary/environment" :names ("environment") :kind :glossary-term :kind-name "Glossary Term" :summary "a set of bindings." :sections (("Definition" (:p (:i "n.")) (:list (:item (:label "1.") (:p "a set of " (:term "glossary/binding" "bindings") ". " "See " (:secref "IntroToEnvs" "Section 3.1.1 (Introduction to Environments)") ".")) (:item (:label "2.") (:p "an " (:term "glossary/environment object" "environment object") ". " "“" (:ref "function/macroexpand" "macroexpand") " takes an optional environment argument.”"))))))
(:entry "glossary/environment object" :names ("environment object") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " an " (:term "glossary/object" "object") " representing a set of " (:term "glossary/lexical binding" "lexical bindings") ", used in the processing of a " (:term "glossary/form" "form") " to provide meanings for " (:term "glossary/name" "names") " within that " (:term "glossary/form" "form") ". " "“" (:ref "function/macroexpand" "macroexpand") " takes an optional environment argument.”" " (The " (:term "glossary/object" "object") " " (:ref "constant-variable/nil" "nil") " " "when used as an " (:term "glossary/environment object" "environment object") " denotes the " (:term "glossary/null lexical environment" "null lexical environment") "; the " (:term "glossary/value" "values") " of " (:term "glossary/environment parameter" "environment parameters") " to " (:term "glossary/macro function" "macro functions") " are " (:term "glossary/object" "objects") " of " (:term "glossary/implementation-dependent" "implementation-dependent") " nature which represent the " (:term "glossary/environment" "environment") (:sense "1") " in which the corresponding " (:term "glossary/macro form" "macro form") " is to be expanded.) " "See " (:secref "EnvObjs" "Section 3.1.1.4 (Environment Objects)") "."))))
(:entry "glossary/environment parameter" :names ("environment parameter") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " A " (:term "glossary/parameter" "parameter") " in a " (:term "glossary/defining form" "defining form") " " (:math "f") " for which there is no corresponding " (:term "glossary/argument" "argument") "; instead, this " (:term "glossary/parameter" "parameter") " receives as its value an " (:term "glossary/environment" "environment") " " (:term "glossary/object" "object") " which corresponds to the " (:term "glossary/lexical environment" "lexical environment") " in which the " (:term "glossary/defining form" "defining form") " " (:math "f") " appeared."))))
(:entry "glossary/error" :names ("error") :kind :glossary-term :kind-name "Glossary Term" :summary "(only in the phrase “is an error”) a situation in which the semantics of a program are not specified, and in which the consequences are undefined." :sections (("Definition" (:p (:i "n.")) (:list (:item (:label "1.") (:p "(only in the phrase “is an error”) a " (:term "glossary/situation" "situation") " in which the semantics of a program are not specified, and in which the consequences are undefined.")) (:item (:label "2.") (:p "a " (:term "glossary/condition" "condition") " which represents an " (:term "glossary/error" "error") " " (:term "glossary/situation" "situation") ". " "See " (:secref "ErrorTerms" "Section 1.4.2 (Error Terminology)") ".")) (:item (:label "3.") (:p "an " (:term "glossary/object" "object") " " "of " (:term "glossary/type" "type") " " (:ref "condition-type/error" "error") "."))))))
(:entry "glossary/error output" :names ("error output") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " the " (:term "glossary/output" "output") " " (:term "glossary/stream" "stream") " which is the " (:term "glossary/value" "value") " of the " (:term "glossary/dynamic variable" "dynamic variable") " " (:ref "variable/*debug-io*" "*error-output*") "."))))
(:entry "glossary/escape" :names ("escape") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") ", " (:i "adj.")) (:list (:item (:label "1.") (:p (:i "n.") " " "a " (:term "glossary/single escape" "single escape") " or a " (:term "glossary/multiple escape" "multiple escape") ".")) (:item (:label "2.") (:p (:i "adj.") " " (:term "glossary/single escape" "single escape") " or " (:term "glossary/multiple escape" "multiple escape") "."))))))
(:entry "glossary/establish" :names ("establish") :kind :glossary-term :kind-name "Glossary Term" :summary "v.t." :sections (("Definition" (:p (:i "v.t.") " " " to build or bring into being a " (:term "glossary/binding" "binding") ", a " (:term "glossary/declaration" "declaration") ", an " (:term "glossary/exit point" "exit point") ", a " (:term "glossary/tag" "tag") ", a " (:term "glossary/handler" "handler") ", a " (:term "glossary/restart" "restart") ", or an " (:term "glossary/environment" "environment") ". " "“" (:ref "special-operator/let" "let") " establishes lexical bindings.”") (:p (:i "v.t.")))))
(:entry "glossary/evaluate" :names ("evaluate") :kind :glossary-term :kind-name "Glossary Term" :summary "v.t." :sections (("Definition" (:p (:i "v.t.") " " "(a " (:term "glossary/form" "form") " or an " (:term "glossary/implicit progn" "implicit progn") ") to " (:term "glossary/execute" "execute") " the " (:term "glossary/code" "code") " represented by the " (:term "glossary/form" "form") " (or the series of " (:term "glossary/form" "forms") " making up the " (:term "glossary/implicit progn" "implicit progn") ") by applying the rules of " (:term "glossary/evaluation" "evaluation") ", returning zero or more values."))))
(:entry "glossary/evaluation" :names ("evaluation") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a model whereby " (:term "glossary/form" "forms") " are " (:term "glossary/execute" "executed") ", returning zero or more values. Such execution might be implemented directly in one step by an interpreter or in two steps by first " (:term "glossary/compile" "compiling") " the " (:term "glossary/form" "form") " and then " (:term "glossary/execute" "executing") " the " (:term "glossary/compile" "compiled") " " (:term "glossary/code" "code") "; this choice is dependent both on context and the nature of the " (:term "glossary/implementation" "implementation") ", but in any case is not in general detectable by any program. The evaluation model is designed in such a way that a " (:term "glossary/conforming implementation" "conforming implementation") " might legitimately have only a compiler and no interpreter, or vice versa. " "See " (:secref "EvaluationModel" "Section 3.1.2 (The Evaluation Model)") "."))))
(:entry "glossary/evaluation environment" :names ("evaluation environment") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/run-time environment" "run-time environment") " in which macro expanders and code specified by " (:ref "special-operator/eval-when" "eval-when") " to be evaluated are evaluated. All evaluations initiated by the " (:term "glossary/compiler" "compiler") " take place in the " (:term "glossary/evaluation environment" "evaluation environment") "."))))
(:entry "glossary/execute" :names ("execute") :kind :glossary-term :kind-name "Glossary Term" :summary "v.t." :sections (("Definition" (:p (:i "v.t.") " " (:i "Trad.") " " "(" (:term "glossary/code" "code") ") to perform the imperative actions represented by the " (:term "glossary/code" "code") "."))))
(:entry "glossary/execution time" :names ("execution time") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " the duration of time that " (:term "glossary/compiled code" "compiled code") " is being " (:term "glossary/execute" "executed") "."))))
(:entry "glossary/exhaustive partition" :names ("exhaustive partition") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " "(of a " (:term "glossary/type" "type") ") a set of " (:term "glossary/pairwise" "pairwise") " " (:term "glossary/disjoint" "disjoint") " " (:term "glossary/type" "types") " that form an " (:term "glossary/exhaustive union" "exhaustive union") "."))))
(:entry "glossary/exhaustive union" :names ("exhaustive union") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " "(of a " (:term "glossary/type" "type") ") a set of " (:term "glossary/subtype" "subtypes") " of the " (:term "glossary/type" "type") ", whose union contains all " (:term "glossary/element" "elements") " of that " (:term "glossary/type" "type") "."))))
(:entry "glossary/exit point" :names ("exit point") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a point in a " (:term "glossary/control form" "control form")) (:p "from which (" (:i "e.g.") ", " (:ref "special-operator/block" "block") "), through which (" (:i "e.g.") ", " (:ref "special-operator/unwind-protect" "unwind-protect") "), or to which (" (:i "e.g.") ", " (:ref "special-operator/tagbody" "tagbody") ") control and possibly " (:term "glossary/value" "values") " can be transferred both actively by using another " (:term "glossary/control form" "control form") " and passively through the normal control and data flow of " (:term "glossary/evaluation" "evaluation") ". " "“" (:ref "special-operator/catch" "catch") " and " (:ref "special-operator/block" "block") " establish bindings for exit points to which " (:ref "special-operator/throw" "throw") " and " (:ref "special-operator/return-from" "return-from") ", respectively, can transfer control and values; " (:ref "special-operator/tagbody" "tagbody") " establishes a binding for an exit point with lexical extent to which " (:ref "special-operator/go" "go") " can transfer control; and " (:ref "special-operator/unwind-protect" "unwind-protect") " establishes an exit point through which control might be transferred by operators such as " (:ref "special-operator/throw" "throw") ", " (:ref "special-operator/return-from" "return-from") ", and " (:ref "special-operator/go" "go") ".”"))))
(:entry "glossary/explicit return" :names ("explicit return") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " the act of transferring control (and possibly " (:term "glossary/value" "values") ") to a " (:term "glossary/block" "block") " by using " (:ref "special-operator/return-from" "return-from") " (or " (:ref "macro/return" "return") ")."))))
(:entry "glossary/explicit use" :names ("explicit use") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " "(of a " (:term "glossary/variable" "variable") " " (:math "V") " in a " (:term "glossary/form" "form") " " (:math "F") ") a reference to " (:math "V") " that is directly apparent in the normal semantics of " (:math "F") "; " (:i "i.e.") ", " "that does not expose any undocumented details of the " (:term "glossary/macro expansion" "macro expansion") " of the " (:term "glossary/form" "form") " itself. References to " (:math "V") " exposed by expanding " (:term "glossary/subform" "subforms") " of " (:math "F") " are, however, considered to be " (:term "glossary/explicit use" "explicit uses") " of " (:math "V") "."))))
(:entry "glossary/exponent marker" :names ("exponent marker") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a character that is used in the textual notation for a " (:term "glossary/float" "float") " to separate the mantissa from the exponent. The characters defined as " (:term "glossary/exponent marker" "exponent markers") " in the " (:term "glossary/standard readtable" "standard readtable") " are shown in " "the next figure" ". For more information, " "see " (:secref "CharacterSyntax" "Section 2.1 (Character Syntax)") ". " "“The exponent marker ‘d’ in ‘3.0d7’ indicates that this number is to be represented as a double float.”") (:table :caption ("Exponent Markers") :header (("Marker") ("Meaning")) :rows ((((:code "D") " or " (:code "d")) ((:ref "type/short-float" "double-float"))) (((:code "E") " or " (:code "e")) ((:ref "system-class/float" "float") " (see " (:ref "variable/*read-default-float-format*" "*read-default-float-format*") ")")) (((:code "F") " or " (:code "f")) ((:ref "type/short-float" "single-float"))) (((:code "L") " or " (:code "l")) ((:ref "type/short-float" "long-float"))) (((:code "S") " or " (:code "s")) ((:ref "type/short-float" "short-float"))))))))
(:entry "glossary/export" :names ("export") :kind :glossary-term :kind-name "Glossary Term" :summary "v.t." :sections (("Definition" (:p (:i "v.t.") " " "(a " (:term "glossary/symbol" "symbol") " in a " (:term "glossary/package" "package") ") to add the " (:term "glossary/symbol" "symbol") " to the list of " (:term "glossary/external symbol" "external symbols") " of the " (:term "glossary/package" "package") "."))))
(:entry "glossary/exported" :names ("exported") :kind :glossary-term :kind-name "Glossary Term" :summary "adj." :sections (("Definition" (:p (:i "adj.") " " "(of a " (:term "glossary/symbol" "symbol") " in a " (:term "glossary/package" "package") ") being an " (:term "glossary/external symbol" "external symbol") " of the " (:term "glossary/package" "package") "."))))
(:entry "glossary/expressed adjustability" :names ("expressed adjustability") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " "(of an " (:term "glossary/array" "array") ") a " (:term "glossary/generalized boolean" "generalized boolean") " that is conceptually (but not necessarily actually) associated with the " (:term "glossary/array" "array") ", representing whether the " (:term "glossary/array" "array") " is " (:term "glossary/expressly adjustable" "expressly adjustable") ". " "See also " (:term "glossary/actual adjustability" "actual adjustability") "."))))
(:entry "glossary/expressed array element type" :names ("expressed array element type") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " "(of an " (:term "glossary/array" "array") ") the " (:term "glossary/type" "type") " which is the " (:term "glossary/array element type" "array element type") " implied by a " (:term "glossary/type declaration" "type declaration") " for the " (:term "glossary/array" "array") ", or which is the requested " (:term "glossary/array element type" "array element type") " at its time of creation, prior to any selection of an " (:term "glossary/upgraded array element type" "upgraded array element type") ". (" "Common Lisp" " " "does not provide a way of detecting this " (:term "glossary/type" "type") " directly at run time, but an " (:term "glossary/implementation" "implementation") " is permitted to make assumptions about the " (:term "glossary/array" "array") "’s contents and the operations which may be performed on the " (:term "glossary/array" "array") " when this " (:term "glossary/type" "type") " is noted during code analysis, even if those assumptions would not be valid in general for the " (:term "glossary/upgraded array element type" "upgraded array element type") " of the " (:term "glossary/expressed array element type" "expressed array element type") ".)"))))
(:entry "glossary/expressed complex part type" :names ("expressed complex part type") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " "(of a " (:term "glossary/complex" "complex") ") the " (:term "glossary/type" "type") " which is implied as the " (:term "glossary/complex part type" "complex part type") " by a " (:term "glossary/type declaration" "type declaration") " for the " (:term "glossary/complex" "complex") ", or which is the requested " (:term "glossary/complex part type" "complex part type") " at its time of creation, prior to any selection of an " (:term "glossary/upgraded complex part type" "upgraded complex part type") ". (" "Common Lisp" " " "does not provide a way of detecting this " (:term "glossary/type" "type") " directly at run time, but an " (:term "glossary/implementation" "implementation") " is permitted to make assumptions about the operations which may be performed on the " (:term "glossary/complex" "complex") " when this " (:term "glossary/type" "type") " is noted during code analysis, even if those assumptions would not be valid in general for the " (:term "glossary/upgraded complex part type" "upgraded complex part type") " of the " (:term "glossary/expressed complex part type" "expressed complex part type") ".)"))))
(:entry "glossary/expression" :names ("expression") :kind :glossary-term :kind-name "Glossary Term" :summary "an object, often used to emphasize the use of the object to encode or represent information in a specialized format, such as program text." :sections (("Definition" (:p (:i "n.")) (:list (:item (:label "1.") (:p "an " (:term "glossary/object" "object") ", often used to emphasize the use of the " (:term "glossary/object" "object") " to encode or represent information in a specialized format, such as program text. " "“The second expression in a " (:ref "special-operator/let" "let") " form is a list of bindings.”")) (:item (:label "2.") (:p "the textual notation used to notate an " (:term "glossary/object" "object") " in a source file. " "“The expression " (:code "'sample") " is equivalent to " (:code "(quote sample)") ".”"))))))
(:entry "glossary/expressly adjustable" :names ("expressly adjustable") :kind :glossary-term :kind-name "Glossary Term" :summary "adj." :sections (("Definition" (:p (:i "adj.") " " "(of an " (:term "glossary/array" "array") ") being " (:term "glossary/actually adjustable" "actually adjustable") " by virtue of an explicit request for this characteristic having been made at the time of its creation. All " (:term "glossary/array" "arrays") " that are " (:term "glossary/expressly adjustable" "expressly adjustable") " are " (:term "glossary/actually adjustable" "actually adjustable") ", but not necessarily vice versa."))))
(:entry "glossary/extended character" :names ("extended character") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/character" "character") " " " " "of " (:term "glossary/type" "type") " " (:ref "type/extended-char" "extended-char") ": " " a " (:term "glossary/character" "character") " that is not a " (:term "glossary/base character" "base character") "."))))
(:entry "glossary/extended function designator" :names ("extended function designator") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/designator" "designator") " for a " (:term "glossary/function" "function") "; that is, an " (:term "glossary/object" "object") " that denotes a " (:term "glossary/function" "function") " and that is one of: a " (:term "glossary/function name" "function name") " (denoting the " (:term "glossary/function" "function") " it names in the " (:term "glossary/global environment" "global environment") "), or a " (:term "glossary/function" "function") " (denoting itself). The consequences are undefined if a " (:term "glossary/function name" "function name") " is used as an " (:term "glossary/extended function designator" "extended function designator") " but it does not have a global definition as a " (:term "glossary/function" "function") ", or if it is a " (:term "glossary/symbol" "symbol") " that has a global definition as a " (:term "glossary/macro" "macro") " or a " (:term "glossary/special form" "special form") ". " "See also " (:term "glossary/function designator" "function designator") "."))))
(:entry "glossary/extended lambda list" :names ("extended lambda list") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a list resembling an " (:term "glossary/ordinary lambda list" "ordinary lambda list") " in form and purpose, but offering additional syntax or functionality not available in an " (:term "glossary/ordinary lambda list" "ordinary lambda list") ". " "“" (:ref "macro/defmacro" "defmacro") " uses extended lambda lists.”"))))
(:entry "glossary/extension" :names ("extension") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a facility in an " (:term "glossary/implementation" "implementation") " of " "Common Lisp" " " " that is not specified by this standard."))))
(:entry "glossary/extent" :names ("extent") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " the interval of time during which a " (:term "glossary/reference" "reference") " to an " (:term "glossary/object" "object") ", a " (:term "glossary/binding" "binding") ", an " (:term "glossary/exit point" "exit point") ", a " (:term "glossary/tag" "tag") ", a " (:term "glossary/handler" "handler") ", a " (:term "glossary/restart" "restart") ", or an " (:term "glossary/environment" "environment") " is defined."))))
(:entry "glossary/external file format" :names ("external file format") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " an " (:term "glossary/object" "object") " of " (:term "glossary/implementation-dependent" "implementation-dependent") " nature which determines one of possibly several " (:term "glossary/implementation-dependent" "implementation-dependent") " ways in which " (:term "glossary/character" "characters") " are encoded externally in a " (:term "glossary/character" "character") " " (:term "glossary/file" "file") "."))))
(:entry "glossary/external file format designator" :names ("external file format designator") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/designator" "designator") " for an " (:term "glossary/external file format" "external file format") "; that is, an " (:term "glossary/object" "object") " that denotes an " (:term "glossary/external file format" "external file format") " and that is one of: the " (:term "glossary/symbol" "symbol") " " (:code ":default") " (denoting an " (:term "glossary/implementation-dependent" "implementation-dependent") " default " (:term "glossary/external file format" "external file format") " that can accomodate at least the " (:term "glossary/base character" "base characters") "), some other " (:term "glossary/object" "object") " defined by the " (:term "glossary/implementation" "implementation") " to be an " (:term "glossary/external file format designator" "external file format designator") " (denoting an " (:term "glossary/implementation-defined" "implementation-defined") " " (:term "glossary/external file format" "external file format") "), or some other " (:term "glossary/object" "object") " defined by the " (:term "glossary/implementation" "implementation") " to be an " (:term "glossary/external file format" "external file format") " (denoting itself)."))))
(:entry "glossary/external symbol" :names ("external symbol") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " "(of a " (:term "glossary/package" "package") ") a " (:term "glossary/symbol" "symbol") " that is part of the ‘external interface’ to the " (:term "glossary/package" "package") " and that are " (:term "glossary/inherit" "inherited") (:sense "3") " by any other " (:term "glossary/package" "package") " that " (:term "glossary/use" "uses") " the " (:term "glossary/package" "package") ". When using the " (:term "glossary/lisp reader" "Lisp reader") ", if a " (:term "glossary/package prefix" "package prefix") " is used, the " (:term "glossary/name" "name") " of an " (:term "glossary/external symbol" "external symbol") " is separated from the " (:term "glossary/package" "package") " " (:term "glossary/name" "name") " by a single " (:term "glossary/package marker" "package marker") " while the " (:term "glossary/name" "name") " of an " (:term "glossary/internal symbol" "internal symbol") " is separated from the " (:term "glossary/package" "package") " " (:term "glossary/name" "name") " by a double " (:term "glossary/package marker" "package marker") "; " "see " (:secref "SymbolTokens" "Section 2.3.4 (Symbols as Tokens)") "."))))
(:entry "glossary/externalizable object" :names ("externalizable object") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " an " (:term "glossary/object" "object") " that can be used as a " (:term "glossary/literal" "literal") " " (:term "glossary/object" "object") " in " (:term "glossary/code" "code") " to be processed by the " (:term "glossary/file compiler" "file compiler") "."))))
(:entry "glossary/false" :names ("false") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " the " (:term "glossary/symbol" "symbol") " " (:ref "constant-variable/nil" "nil") ", used to represent the failure of a " (:term "glossary/predicate" "predicate") " test."))))
(:entry "glossary/fbound" :names ("fbound") :kind :glossary-term :kind-name "Glossary Term" :summary "[width 1pt height 2pt depth 2ptefwidth 1pt height 2pt depth 2ptbaund] adj." :sections (("Definition" (:p (:math "[" (:b (:math) (:math) "width 1pt height 2pt depth 2pt" (:math) (:math) "ef" (:math) "width 1pt height 2pt depth 2pt" (:math) "ba" "und") "]") " " (:i "adj.") " " " (of a " (:term "glossary/function name" "function name") ") " (:term "glossary/bound" "bound") " in the " (:term "glossary/function" "function") " " (:term "glossary/namespace" "namespace") ". (The " (:term "glossary/name" "names") " of " (:term "glossary/macro" "macros") " and " (:term "glossary/special operator" "special operators") " are " (:term "glossary/fbound" "fbound") ", but the nature and " (:term "glossary/type" "type") " of the " (:term "glossary/object" "object") " which is their " (:term "glossary/value" "value") " is " (:term "glossary/implementation-dependent" "implementation-dependent") ". " " Further, defining a " (:term "glossary/setf expander" "setf expander") " " (:param "F") " does not cause the " (:term "glossary/setf function" "setf function") " " (:code "(setf " (:param "F") ")") " to become defined; as such, if there is a such a definition of a " (:term "glossary/setf expander" "setf expander") " " (:param "F") ", the " (:term "glossary/function" "function") " " (:code "(setf " (:param "F") ")") " can be " (:term "glossary/fbound" "fbound") " if and only if, by design or coincidence, a function binding for " (:code "(setf " (:param "F") ")") " has been independently established.) " " " "See the " (:term "glossary/function" "functions") " " (:ref "function/fboundp" "fboundp") " and " (:ref "accessor/symbol-function" "symbol-function") "."))))
(:entry "glossary/feature" :names ("feature") :kind :glossary-term :kind-name "Glossary Term" :summary "an aspect or attribute of Common Lisp, of the implementation, or of the environment." :sections (("Definition" (:p (:i "n.")) (:list (:item (:label "1.") (:p "an aspect or attribute of " "Common Lisp" ", of the " (:term "glossary/implementation" "implementation") ", or of the " (:term "glossary/environment" "environment") ".")) (:item (:label "2.") (:p "a " (:term "glossary/symbol" "symbol") " that names a " (:term "glossary/feature" "feature") (:sense "1") ". " "See " (:secref "Features" "Section 24.1.2 (Features)") ". " "“The " (:code ":ansi-cl") " feature is present in all conforming implementations.”"))))))
(:entry "glossary/feature expression" :names ("feature expression") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " A boolean combination of " (:term "glossary/feature" "features") " used by the " (:code "#" "+") " and " (:code "#" "-") " " (:term "glossary/reader macro" "reader macros") " in order to direct conditional " (:term "glossary/read" "reading") " of " (:term "glossary/expression" "expressions") " by the " (:term "glossary/lisp reader" "Lisp reader") ". " "See " (:secref "FeatureExpressions" "Section 24.1.2.1 (Feature Expressions)") "."))))
(:entry "glossary/features list" :names ("features list") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " the " (:term "glossary/list" "list") " that is " "the " (:term "glossary/value" "value") " of " (:ref "variable/*features*" "*features*") "."))))
(:entry "glossary/file" :names ("file") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a named entry in a " (:term "glossary/file system" "file system") ", having an " (:term "glossary/implementation-defined" "implementation-defined") " nature."))))
(:entry "glossary/file compiler" :names ("file compiler") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " any " (:term "glossary/compiler" "compiler") " which " (:term "glossary/compile" "compiles") " " (:term "glossary/source code" "source code") " contained in a " (:term "glossary/file" "file") ", producing a " (:term "glossary/compiled file" "compiled file") " as output. The " (:ref "function/compile-file" "compile-file") " function is the only interface to such a " (:term "glossary/compiler" "compiler") " provided by " "Common Lisp" ", but there might be other, " (:term "glossary/implementation-defined" "implementation-defined") " mechanisms for invoking the " (:term "glossary/file compiler" "file compiler") "."))))
(:entry "glossary/file position" :names ("file position") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " "(in a " (:term "glossary/stream" "stream") ") a non-negative " (:term "glossary/integer" "integer") " that represents a position in the " (:term "glossary/stream" "stream") ". Not all " (:term "glossary/stream" "streams") " are able to represent the notion of " (:term "glossary/file position" "file position") "; in the description of any " (:term "glossary/operator" "operator") " which manipulates " (:term "glossary/file position" "file positions") ", the behavior for " (:term "glossary/stream" "streams") " that don’t have this notion must be explicitly stated. For " (:term "glossary/binary" "binary") " " (:term "glossary/stream" "streams") ", the " (:term "glossary/file position" "file position") " represents the number of preceding " (:term "glossary/byte" "bytes") " in the " (:term "glossary/stream" "stream") ". For " (:term "glossary/character" "character") " " (:term "glossary/stream" "streams") ", the constraint is more relaxed: " (:term "glossary/file position" "file positions") " must increase monotonically, the amount of the increase between " (:term "glossary/file position" "file positions") " corresponding to any two successive characters in the " (:term "glossary/stream" "stream") " is " (:term "glossary/implementation-dependent" "implementation-dependent") "."))))
(:entry "glossary/file position designator" :names ("file position designator") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " "(in a " (:term "glossary/stream" "stream") ") a " (:term "glossary/designator" "designator") " for a " (:term "glossary/file position" "file position") " in that " (:term "glossary/stream" "stream") "; that is, the symbol " (:code ":start") " (denoting " (:code "0") ", the first " (:term "glossary/file position" "file position") " in that " (:term "glossary/stream" "stream") "), the symbol " (:code ":end") " (denoting the last " (:term "glossary/file position" "file position") " in that " (:term "glossary/stream" "stream") "; " (:i "i.e.") ", " "the position following the last " (:term "glossary/element" "element") " of the " (:term "glossary/stream" "stream") "), or a " (:term "glossary/file position" "file position") " (denoting itself)."))))
(:entry "glossary/file stream" :names ("file stream") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " an " (:term "glossary/object" "object") " " "of " (:term "glossary/type" "type") " " (:ref "system-class/file-stream" "file-stream") "."))))
(:entry "glossary/file system" :names ("file system") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a facility which permits aggregations of data to be stored in named " (:term "glossary/file" "files") " on some medium that is external to the " (:term "glossary/lisp image" "Lisp image") " and that therefore persists from " (:term "glossary/session" "session") " to " (:term "glossary/session" "session") "."))))
(:entry "glossary/filename" :names ("filename") :kind :glossary-term :kind-name "Glossary Term" :summary "a handle, not necessarily ever directly represented as an object, that can be used to refer to a file in a file system." :sections (("Definition" (:p (:i "n.")) (:p "a handle, not necessarily ever directly represented as an " (:term "glossary/object" "object") ", that can be used to refer to a " (:term "glossary/file" "file") " in a " (:term "glossary/file system" "file system") ". " (:term "glossary/pathname" "Pathnames") " and " (:term "glossary/namestring" "namestrings") " are two kinds of " (:term "glossary/object" "objects") " that substitute for " (:term "glossary/filename" "filenames") " in " "Common Lisp" "."))))
(:entry "glossary/fill pointer" :names ("fill pointer") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " "(of a " (:term "glossary/vector" "vector") ") an " (:term "glossary/integer" "integer") " associated with a " (:term "glossary/vector" "vector") " that represents the index above which no " (:term "glossary/element" "elements") " are " (:term "glossary/active" "active") ". (A " (:term "glossary/fill pointer" "fill pointer") " is a non-negative " (:term "glossary/integer" "integer") " no larger than the total number of " (:term "glossary/element" "elements") " in the " (:term "glossary/vector" "vector") ". Not all " (:term "glossary/vector" "vectors") " have " (:term "glossary/fill pointer" "fill pointers") ".)"))))
(:entry "glossary/finite" :names ("finite") :kind :glossary-term :kind-name "Glossary Term" :summary "adj." :sections (("Definition" (:p (:i "adj.") " " "(of a " (:term "glossary/type" "type") ") having a finite number of " (:term "glossary/element" "elements") ". " "“The type specifier " (:code "(integer 0 5)") " denotes a finite type, but the type specifiers " (:ref "system-class/integer" "integer") " and " (:code "(integer 0)") " do not.”"))))
(:entry "glossary/fixnum" :names ("fixnum") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " an " (:term "glossary/integer" "integer") " " "of " (:term "glossary/type" "type") " " (:ref "type/fixnum" "fixnum") "."))))
(:entry "glossary/float" :names ("float") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " an " (:term "glossary/object" "object") " " "of " (:term "glossary/type" "type") " " (:ref "system-class/float" "float") "."))))
(:entry "glossary/for-value" :names ("for-value") :kind :glossary-term :kind-name "Glossary Term" :summary "adj." :sections (("Definition" (:p (:i "adj.") " " "(of a " (:term "glossary/reference" "reference") " to a " (:term "glossary/binding" "binding") ") being a " (:term "glossary/reference" "reference") " that " (:term "glossary/read" "reads") (:sense "1") " the " (:term "glossary/value" "value") " of the " (:term "glossary/binding" "binding") "."))))
(:entry "glossary/form" :names ("form") :kind :glossary-term :kind-name "Glossary Term" :summary "any object meant to be evaluated." :sections (("Definition" (:p (:i "n.")) (:list (:item (:label "1.") (:p "any " (:term "glossary/object" "object") " meant to be " (:term "glossary/evaluate" "evaluated") ".")) (:item (:label "2.") (:p "a " (:term "glossary/symbol" "symbol") ", a " (:term "glossary/compound form" "compound form") ", or a " (:term "glossary/self-evaluating object" "self-evaluating object") ".")) (:item (:label "3.") (:p "(for an " (:term "glossary/operator" "operator") ", as in “" (:math "⟨" "⟨") "operator" (:math "⟩" "⟩") " " (:term "glossary/form" "form") "”) a " (:term "glossary/compound form" "compound form") " having that " (:term "glossary/operator" "operator") " as its first element. " "“A " (:ref "special-operator/quote" "quote") " form is a constant form.”"))))))
(:entry "glossary/formal argument" :names ("formal argument") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " (:i "Trad.") " " " a " (:term "glossary/parameter" "parameter") "."))))
(:entry "glossary/formal parameter" :names ("formal parameter") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " (:i "Trad.") " " " a " (:term "glossary/parameter" "parameter") "."))))
(:entry "glossary/format" :names ("format") :kind :glossary-term :kind-name "Glossary Term" :summary "v.t." :sections (("Definition" (:p (:i "v.t.") " " "(a " (:term "glossary/format control" "format control") " and " (:term "glossary/format argument" "format arguments") ") to perform output as if by " (:ref "function/format" "format") ", using the " (:term "glossary/format string" "format string") " and " (:term "glossary/format argument" "format arguments") "."))))
(:entry "glossary/format argument" :names ("format argument") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " an " (:term "glossary/object" "object") " which is used as data by functions such as " (:ref "function/format" "format") " which interpret " (:term "glossary/format control" "format controls") "."))))
(:entry "glossary/format control" :names ("format control") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/format string" "format string") ", or a " (:term "glossary/function" "function") " that obeys the " (:term "glossary/argument" "argument") " conventions for a " (:term "glossary/function" "function") " returned by " "the " (:ref "macro/formatter" "formatter") " " (:term "glossary/macro" "macro") ". " "See " (:secref "CompilingFormatStrings" "Section 22.2.1.3 ({}Compiling Format Strings)") "."))))
(:entry "glossary/format directive" :names ("format directive") :kind :glossary-term :kind-name "Glossary Term" :summary "a sequence of characters in a format string which is introduced by a tilde, and which is specially interpreted by code which processes format strings to mean that some special operation should be…" :sections (("Definition" (:p (:i "n.")) (:list (:item (:label "1.") (:p "a sequence of " (:term "glossary/character" "characters") " in a " (:term "glossary/format string" "format string") " which is introduced by a " (:term "glossary/tilde" "tilde") ", and which is specially interpreted by " (:term "glossary/code" "code") " which processes " (:term "glossary/format string" "format strings") " to mean that some special operation should be performed, possibly involving data supplied by the " (:term "glossary/format argument" "format arguments") " that accompanied the " (:term "glossary/format string" "format string") ". " "See the " (:term "glossary/function" "function") " " (:ref "function/format" "format") ". " "“In " (:code "\"~D base 10 = ~8R\"") ", the character sequences ‘" (:code "~D") "’ and ‘" (:code "~8R") "’ are format directives.”")) (:item (:label "2.") (:p "the conceptual category of all " (:term "glossary/format directive" "format directives") (:sense "1") " which use the same dispatch character. " "“Both " (:code "\"~3d\"") " and " (:code "\"~3,'0D\"") " are valid uses of the ‘" (:code "~D") "’ format directive.”"))))))
(:entry "glossary/format string" :names ("format string") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/string" "string") " which can contain both ordinary text and " (:term "glossary/format directive" "format directives") ", and which is used in conjunction with " (:term "glossary/format argument" "format arguments") " to describe how text output should be formatted by certain functions, such as " (:ref "function/format" "format") "."))))
(:entry "glossary/free declaration" :names ("free declaration") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a declaration that is not a " (:term "glossary/bound declaration" "bound declaration") ". " "See " (:code "") "declare" "."))))
(:entry "glossary/fresh" :names ("fresh") :kind :glossary-term :kind-name "Glossary Term" :summary "(of an object yielded by a function) having been newly-allocated by that function." :sections (("Definition" (:p (:i "adj.")) (:list (:item (:label "1.") (:p "(of an " (:term "glossary/object" "object") " " (:term "glossary/yield" "yielded") " by a " (:term "glossary/function" "function") ") having been newly-allocated by that " (:term "glossary/function" "function") ". (The caller of a " (:term "glossary/function" "function") " that returns a " (:term "glossary/fresh" "fresh") " " (:term "glossary/object" "object") " may freely modify the " (:term "glossary/object" "object") " without fear that such modification will compromise the future correct behavior of that " (:term "glossary/function" "function") ".)")) (:item (:label "2.") (:p "(of a " (:term "glossary/binding" "binding") " for a " (:term "glossary/name" "name") ") newly-allocated; not shared with other " (:term "glossary/binding" "bindings") " for that " (:term "glossary/name" "name") "."))))))
(:entry "glossary/freshline" :names ("freshline") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a conceptual operation on a " (:term "glossary/stream" "stream") ", implemented by " "the " (:term "glossary/function" "function") " " (:ref "function/terpri" "fresh-line") " and by the " (:term "glossary/format directive" "format directive") " " (:code "~" "&") ", which advances the display position to the beginning of the next line (as if a " (:term "glossary/newline" "newline") " had been typed, or " "the " (:term "glossary/function" "function") " " (:ref "function/terpri" "terpri") " had been called) unless the " (:term "glossary/stream" "stream") " is already known to be positioned at the beginning of a line. Unlike " (:term "glossary/newline" "newline") ", " (:term "glossary/freshline" "freshline") " is not a " (:term "glossary/character" "character") "."))))
(:entry "glossary/funbound" :names ("funbound") :kind :glossary-term :kind-name "Glossary Term" :summary "[width 1pt height 2pt depth 2ptefunbaund] n." :sections (("Definition" (:p (:math "[" (:b (:math) (:math) "width 1pt height 2pt depth 2pt" (:math) (:math) "ef" "unba" "und") "]") " " (:i "n.") " " "(of a " (:term "glossary/function name" "function name") ") not " (:term "glossary/fbound" "fbound") "."))))
(:entry "glossary/function" :names ("function") :kind :glossary-term :kind-name "Glossary Term" :summary "an object representing code, which can be called with zero or more arguments, and which produces zero or more values." :sections (("Definition" (:p (:i "n.")) (:list (:item (:label "1.") (:p "an " (:term "glossary/object" "object") " representing code, which can be " (:term "glossary/call" "called") " with zero or more " (:term "glossary/argument" "arguments") ", and which produces zero or more " (:term "glossary/value" "values") ".")) (:item (:label "2.") (:p "an " (:term "glossary/object" "object") " " "of " (:term "glossary/type" "type") " " (:ref "system-class/function" "function") "."))))))
(:entry "glossary/function block name" :names ("function block name") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " "(of a " (:term "glossary/function name" "function name") ") The " (:term "glossary/symbol" "symbol") " that would be used as the name of an " (:term "glossary/implicit block" "implicit block") " which surrounds the body of a " (:term "glossary/function" "function") " having that " (:term "glossary/function name" "function name") ". If the " (:term "glossary/function name" "function name") " is a " (:term "glossary/symbol" "symbol") ", its " (:term "glossary/function block name" "function block name") " is the " (:term "glossary/function name" "function name") " itself. If the " (:term "glossary/function name" "function name") " is a " (:term "glossary/list" "list") " whose " (:term "glossary/car" "car") " is " (:ref "macro/setf" "setf") " and whose " (:term "glossary/cadr" "cadr") " is a " (:term "glossary/symbol" "symbol") ", its " (:term "glossary/function block name" "function block name") " is the " (:term "glossary/symbol" "symbol") " that is the " (:term "glossary/cadr" "cadr") " of the " (:term "glossary/function name" "function name") ". An " (:term "glossary/implementation" "implementation") " which supports additional kinds of " (:term "glossary/function name" "function names") " must specify for each how the corresponding " (:term "glossary/function block name" "function block name") " is computed."))))
(:entry "glossary/function cell" :names ("function cell") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " (:i "Trad.") " " "(of a " (:term "glossary/symbol" "symbol") ") The " (:term "glossary/place" "place") " which holds the " (:term nil "definition") " of the global " (:term "glossary/function" "function") " " (:term "glossary/binding" "binding") ", if any, named by that " (:term "glossary/symbol" "symbol") ", and which is " (:term "glossary/access" "accessed") " by " (:ref "accessor/symbol-function" "symbol-function") ". " "See " (:term "glossary/cell" "cell") "."))))
(:entry "glossary/function designator" :names ("function designator") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/designator" "designator") " for a " (:term "glossary/function" "function") "; that is, an " (:term "glossary/object" "object") " that denotes a " (:term "glossary/function" "function") " and that is one of: a " (:term "glossary/symbol" "symbol") " (denoting the " (:term "glossary/function" "function") " named by that " (:term "glossary/symbol" "symbol") " in the " (:term "glossary/global environment" "global environment") "), or a " (:term "glossary/function" "function") " (denoting itself). The consequences are undefined if a " (:term "glossary/symbol" "symbol") " is used as a " (:term "glossary/function designator" "function designator") " but it does not have a global definition as a " (:term "glossary/function" "function") ", or it has a global definition as a " (:term "glossary/macro" "macro") " or a " (:term "glossary/special form" "special form") ". " "See also " (:term "glossary/extended function designator" "extended function designator") "."))))
(:entry "glossary/function form" :names ("function form") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/form" "form") " that is a " (:term "glossary/list" "list") " and that has a first element which is the " (:term "glossary/name" "name") " of a " (:term "glossary/function" "function") " to be called on " (:term "glossary/argument" "arguments") " which are the result of " (:term "glossary/evaluate" "evaluating") " subsequent elements of the " (:term "glossary/function form" "function form") "."))))
(:entry "glossary/function name" :names ("function name") :kind :glossary-term :kind-name "Glossary Term" :summary "(in an environment) A symbol or a list (setf symbol) that is the name of a function in that environment." :sections (("Definition" (:p (:i "n.")) (:list (:item (:label "1.") (:p "(in an " (:term "glossary/environment" "environment") ") A " (:term "glossary/symbol" "symbol") " or a " (:term "glossary/list" "list") " " (:code "(setf " (:i "symbol") ")") " that is the " (:term "glossary/name" "name") " of a " (:term "glossary/function" "function") " in that " (:term "glossary/environment" "environment") ".")) (:item (:label "2.") (:p "A " (:term "glossary/symbol" "symbol") " or a " (:term "glossary/list" "list") " " (:code "(setf " (:i "symbol") ")") "."))))))
(:entry "glossary/functional evaluation" :names ("functional evaluation") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " the process of extracting a " (:term "glossary/functional value" "functional value") " from a " (:term "glossary/function name" "function name")) (:p "or a " (:term "glossary/lambda expression" "lambda expression") ". The evaluator performs " (:term "glossary/functional evaluation" "functional evaluation") " implicitly when it encounters a " (:term "glossary/function name" "function name")) (:p "or a " (:term "glossary/lambda expression" "lambda expression") " in the " (:term "glossary/car" "car") " of a " (:term "glossary/compound form" "compound form") ", or explicitly when it encounters a " (:ref "special-operator/function" "function") " " (:term "glossary/special form" "special form") ". Neither a use of a " (:term "glossary/symbol" "symbol") " as a " (:term "glossary/function designator" "function designator") " nor a use of " "the " (:term "glossary/function" "function") " " (:ref "accessor/symbol-function" "symbol-function") " to extract the " (:term "glossary/functional value" "functional value") " of a " (:term "glossary/symbol" "symbol") " is considered a " (:term "glossary/functional evaluation" "functional evaluation") "."))))
(:entry "glossary/functional value" :names ("functional value") :kind :glossary-term :kind-name "Glossary Term" :summary "(of a function name N in an environment E) The value of the binding named N in the function namespace for environment E;" :sections (("Definition" (:p (:i "n.")) (:list (:item (:label "1.") (:p "(of a " (:term "glossary/function name" "function name") " " (:math "N") " in an " (:term "glossary/environment" "environment") " " (:math "E") ") The " (:term "glossary/value" "value") " of the " (:term "glossary/binding" "binding") " named " (:math "N") " in the " (:term "glossary/function" "function") " " (:term "glossary/namespace" "namespace") " for " (:term "glossary/environment" "environment") " " (:math "E") ";") (:p "that is, the contents of the " (:term "glossary/function cell" "function cell") " named " (:math "N") " in " (:term "glossary/environment" "environment") " " (:math "E") ".")) (:item (:label "2.") (:p "(of an " (:term "glossary/fbound" "fbound") " " (:term "glossary/symbol" "symbol") " " (:math "S") ") the contents of the " (:term "glossary/symbol" "symbol") "’s " (:term "glossary/function cell" "function cell") "; that is, the " (:term "glossary/value" "value") " of the " (:term "glossary/binding" "binding") " named " (:math "S") " in the " (:term "glossary/function" "function") " " (:term "glossary/namespace" "namespace") " of the " (:term "glossary/global environment" "global environment") ". (A " (:term "glossary/name" "name") " that is a " (:term "glossary/macro name" "macro name") " in the " (:term "glossary/global environment" "global environment") " or is a " (:term "glossary/special operator" "special operator") " might or might not be " (:term "glossary/fbound" "fbound") ".") (:p "But if " (:math "S") " is such a " (:term "glossary/name" "name") " and is " (:term "glossary/fbound" "fbound") ", the specific nature of its " (:term "glossary/functional value" "functional value") " is " (:term "glossary/implementation-dependent" "implementation-dependent") "; in particular, it might or might not be a " (:term "glossary/function" "function") ".)"))))))
(:entry "glossary/further compilation" :names ("further compilation") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " " (:term "glossary/implementation-dependent" "implementation-dependent") " compilation beyond " (:term "glossary/minimal compilation" "minimal compilation") ". Further compilation is permitted to take place at " (:term "glossary/run time" "run time") ". " "“Block compilation and generation of machine-specific instructions are examples of further compilation.”"))))
(:entry "glossary/general" :names ("general") :kind :glossary-term :kind-name "Glossary Term" :summary "adj." :sections (("Definition" (:p (:i "adj.") " " "(of an " (:term "glossary/array" "array") ") having " (:term "glossary/element type" "element type") " " (:ref "system-class/t" "t") ", and consequently able to have any " (:term "glossary/object" "object") " as an " (:term "glossary/element" "element") "."))))
(:entry "glossary/generalized boolean" :names ("generalized boolean") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " an " (:term "glossary/object" "object") " used as a truth value, where the symbol " (:ref "constant-variable/nil" "nil") " " " represents " (:term "glossary/false" "false") " and all other " (:term "glossary/object" "objects") " represent " (:term "glossary/true" "true") ". " "See " (:term "glossary/boolean" "boolean") "."))))
(:entry "glossary/generalized instance" :names ("generalized instance") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " "(of a " (:term "glossary/class" "class") ") an " (:term "glossary/object" "object") " the " (:term "glossary/class" "class") " of which is either that " (:term "glossary/class" "class") " itself, or some subclass of that " (:term "glossary/class" "class") ". (Because of the correspondence between types and classes, the term “generalized instance of " (:math "X") "” implies “object of type " (:math "X") "” and in cases where " (:math "X") " is a " (:term "glossary/class" "class") " (or " (:term nil "class name") ") the reverse is also true. The former terminology emphasizes the view of " (:math "X") " as a " (:term "glossary/class" "class") " while the latter emphasizes the view of " (:math "X") " as a " (:term "glossary/type specifier" "type specifier") ".)"))))
(:entry "glossary/generalized reference" :names ("generalized reference") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a reference to a location storing an " (:term "glossary/object" "object") " as if to a " (:term "glossary/variable" "variable") ". (Such a reference can be either to " (:term "glossary/read" "read") " or " (:term "glossary/write" "write") " the location.) " "See " (:secref "GeneralizedReference" "Section 5.1 (Generalized Reference)") ". See also " (:term "glossary/place" "place") "."))))
(:entry "glossary/generalized synonym stream" :names ("generalized synonym stream") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " "(with a " (:term "glossary/synonym stream symbol" "synonym stream symbol") ")") (:list (:item (:label "1.") (:p "(to a " (:term "glossary/stream" "stream") ") a " (:term "glossary/synonym stream" "synonym stream") " to the " (:term "glossary/stream" "stream") ", or a " (:term "glossary/composite stream" "composite stream") " which has as a target a " (:term "glossary/generalized synonym stream" "generalized synonym stream") " to the " (:term "glossary/stream" "stream") ".")) (:item (:label "2.") (:p "(to a " (:term "glossary/symbol" "symbol") ") a " (:term "glossary/synonym stream" "synonym stream") " to the " (:term "glossary/symbol" "symbol") ", or a " (:term "glossary/composite stream" "composite stream") " which has as a target a " (:term "glossary/generalized synonym stream" "generalized synonym stream") " to the " (:term "glossary/symbol" "symbol") "."))))))
(:entry "glossary/generic function" :names ("generic function") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/function" "function") " whose behavior depends on the " (:term "glossary/class" "classes") " or identities of the arguments supplied to it and whose parts include, among other things, a set of " (:term "glossary/method" "methods") ", a " (:term "glossary/lambda list" "lambda list") ", and a " (:term "glossary/method combination" "method combination") " type."))))
(:entry "glossary/generic function lambda list" :names ("generic function lambda list") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " A " (:term "glossary/lambda list" "lambda list") " that is used to describe data flow into a " (:term "glossary/generic function" "generic function") ". " "See " (:secref "GFLambdaLists" "Section 3.4.2 (Generic Function Lambda Lists)") "."))))
(:entry "glossary/gensym" :names ("gensym") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " (:i "Trad.") " " " an " (:term "glossary/uninterned" "uninterned") " " (:term "glossary/symbol" "symbol") ". " "See the " (:term "glossary/function" "function") " " (:ref "function/gensym" "gensym") "."))))
(:entry "glossary/global declaration" :names ("global declaration") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/form" "form") " that makes certain kinds of information about code globally available; that is, a " (:ref "function/proclaim" "proclaim") " " (:term "glossary/form" "form") " or a " (:ref "macro/declaim" "declaim") " " (:term "glossary/form" "form") "."))))
(:entry "glossary/global environment" :names ("global environment") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " that part of an " (:term "glossary/environment" "environment") " that contains " (:term "glossary/binding" "bindings") " with " (:term "glossary/indefinite scope" "indefinite scope") " and " (:term "glossary/indefinite extent" "indefinite extent") "."))))
(:entry "glossary/global variable" :names ("global variable") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/dynamic variable" "dynamic variable") " or a " (:term "glossary/constant variable" "constant variable") "."))))
(:entry "glossary/glyph" :names ("glyph") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a visual representation. " "“Graphic characters have associated glyphs.”"))))
(:entry "glossary/go" :names ("go") :kind :glossary-term :kind-name "Glossary Term" :summary "v." :sections (("Definition" (:p (:i "v.") " " " to transfer control to a " (:term "glossary/go point" "go point") ". " "See the " (:term "glossary/special operator" "special operator") " " (:ref "special-operator/go" "go") "."))))
(:entry "glossary/go point" :names ("go point") :kind :glossary-term :kind-name "Glossary Term" :summary "one of possibly several exit points that are established by tagbody (or other abstractions, such as prog, which are built from tagbody)." :sections (("Definition" (:p "one of possibly several " (:term "glossary/exit point" "exit points") " that are " (:term "glossary/establish" "established") " by " (:ref "special-operator/tagbody" "tagbody") " (or other abstractions, such as " (:ref "macro/prog" "prog") ", which are built from " (:ref "special-operator/tagbody" "tagbody") ")."))))
(:entry "glossary/go tag" :names ("go tag") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " the " (:term "glossary/symbol" "symbol") " or " (:term "glossary/integer" "integer") " that, within the " (:term "glossary/lexical scope" "lexical scope") " of a " (:ref "special-operator/tagbody" "tagbody") " " (:term "glossary/form" "form") ", names an " (:term "glossary/exit point" "exit point") " " (:term "glossary/establish" "established") " by that " (:ref "special-operator/tagbody" "tagbody") " " (:term "glossary/form" "form") "."))))
(:entry "glossary/graphic" :names ("graphic") :kind :glossary-term :kind-name "Glossary Term" :summary "adj." :sections (("Definition" (:p (:i "adj.") " " "(of a " (:term "glossary/character" "character") ") being a “printing” or “displayable” " (:term "glossary/character" "character") " that has a standard visual representation as a single " (:term "glossary/glyph" "glyph") ", such as " (:code "A") " or " (:code "*") " or " (:code "=") ". " (:term "glossary/space" "Space") " is defined to be " (:term "glossary/graphic" "graphic") ". Of the " (:term "glossary/standard character" "standard characters") ", all but " (:term "glossary/newline" "newline") " are " (:term "glossary/graphic" "graphic") ". " "See " (:term "glossary/non-graphic" "non-graphic") "."))))
(:entry "glossary/handle" :names ("handle") :kind :glossary-term :kind-name "Glossary Term" :summary "v." :sections (("Definition" (:p (:i "v.") " " "(of a " (:term "glossary/condition" "condition") " being " (:term "glossary/signal" "signaled") ") to perform a non-local transfer of control, terminating the ongoing " (:term "glossary/signal" "signaling") " of the " (:term "glossary/condition" "condition") "."))))
(:entry "glossary/handler" :names ("handler") :kind :glossary-term :kind-name "Glossary Term" :summary "a condition handler." :sections (("Definition" (:p (:i "n.")) (:p "a " (:term "glossary/condition handler" "condition handler") "."))))
(:entry "glossary/hash table" :names ("hash table") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " an " (:term "glossary/object" "object") " " "of " (:term "glossary/type" "type") " " (:ref "system-class/hash-table" "hash-table") ", which provides a mapping from " (:term "glossary/key" "keys") " to " (:term "glossary/value" "values") "."))))
(:entry "glossary/home package" :names ("home package") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " "(of a " (:term "glossary/symbol" "symbol") ") the " (:term "glossary/package" "package") ", if any, which is contents of the " (:term "glossary/package cell" "package cell") " of the " (:term "glossary/symbol" "symbol") ", and which dictates how the " (:term "glossary/lisp printer" "Lisp printer") " prints the " (:term "glossary/symbol" "symbol") " when it is not " (:term "glossary/accessible" "accessible") " in the " (:term "glossary/current package" "current package") ". (" (:term "glossary/symbol" "Symbols") " which have " (:ref "constant-variable/nil" "nil") " " "in their " (:term "glossary/package cell" "package cell") " are said to have no " (:term "glossary/home package" "home package") ", and also to be " (:term "glossary/apparently uninterned" "apparently uninterned") ".)"))))
(:entry "glossary/i/o customization variable" :names ("I/O customization variable") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " one of the " (:term "glossary/stream variable" "stream variables") " in " "the next figure" ", or some other (" (:term "glossary/implementation-defined" "implementation-defined") ") " (:term "glossary/stream variable" "stream variable") " that is defined by the " (:term "glossary/implementation" "implementation") " to be an " (:term "glossary/i/o customization variable" "I/O customization variable") ".") (:table :caption ("Standardized I/O Customization Variables") :rows ((("*debug-io*") ("*error-io*") ("query-io*")) (("*standard-input*") ("*standard-output*") ("*trace-output*")))))))
(:entry "glossary/identical" :names ("identical") :kind :glossary-term :kind-name "Glossary Term" :summary "adj." :sections (("Definition" (:p (:i "adj.") " " " the " (:term "glossary/same" "same") " under " (:ref "function/eq" "eq") "."))))
(:entry "glossary/identifier" :names ("identifier") :kind :glossary-term :kind-name "Glossary Term" :summary "a symbol used to identify or to distinguish names." :sections (("Definition" (:p (:i "n.")) (:list (:item (:label "1.") (:p "a " (:term "glossary/symbol" "symbol") " used to identify or to distinguish " (:term "glossary/name" "names") ".")) (:item (:label "2.") (:p "a " (:term "glossary/string" "string") " used the same way."))))))
(:entry "glossary/immutable" :names ("immutable") :kind :glossary-term :kind-name "Glossary Term" :summary "adj." :sections (("Definition" (:p (:i "adj.") " " " not subject to change, either because no " (:term "glossary/operator" "operator") " is provided which is capable of effecting such change or because some constraint exists which prohibits the use of an " (:term "glossary/operator" "operator") " that might otherwise be capable of effecting such a change. Except as explicitly indicated otherwise, " (:term "glossary/implementation" "implementations") " are not required to detect attempts to modify " (:term "glossary/immutable" "immutable") " " (:term "glossary/object" "objects") " or " (:term "glossary/cell" "cells") "; the consequences of attempting to make such modification are undefined. " "“Numbers are immutable.”"))))
(:entry "glossary/implementation" :names ("implementation") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a system, mechanism, or body of " (:term "glossary/code" "code") " that implements the semantics of " "Common Lisp" "."))))
(:entry "glossary/implementation limit" :names ("implementation limit") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a restriction imposed by an " (:term "glossary/implementation" "implementation") "."))))
(:entry "glossary/implementation-defined" :names ("implementation-defined") :kind :glossary-term :kind-name "Glossary Term" :summary "adj." :sections (("Definition" (:p (:i "adj.") " " " " (:term "glossary/implementation-dependent" "implementation-dependent") ", but required by this specification to be defined by each " (:term "glossary/conforming implementation" "conforming implementation") " and to be documented by the corresponding implementor."))))
(:entry "glossary/implementation-dependent" :names ("implementation-dependent") :kind :glossary-term :kind-name "Glossary Term" :summary "adj." :sections (("Definition" (:p (:i "adj.") " " " describing a behavior or aspect of " "Common Lisp" " " "which has been deliberately left unspecified, that might be defined in some " (:term "glossary/conforming implementation" "conforming implementations") " but not in others, and whose details may differ between " (:term "glossary/implementation" "implementations") ".") (:p "A " (:term "glossary/conforming implementation" "conforming implementation") " is encouraged (but not required) to document its treatment of each item in this specification which is marked " (:term "glossary/implementation-dependent" "implementation-dependent") ", although in some cases such documentation might simply identify the item as “undefined.”"))))
(:entry "glossary/implementation-independent" :names ("implementation-independent") :kind :glossary-term :kind-name "Glossary Term" :summary "adj." :sections (("Definition" (:p (:i "adj.") " " " used to identify or emphasize a behavior or aspect of " "Common Lisp" " " "which does not vary between " (:term "glossary/conforming implementation" "conforming implementations") "."))))
(:entry "glossary/implicit block" :names ("implicit block") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/block" "block") " introduced by a " (:term "glossary/macro form" "macro form") " rather than by an explicit " (:ref "special-operator/block" "block") " " (:term "glossary/form" "form") "."))))
(:entry "glossary/implicit compilation" :names ("implicit compilation") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " " (:term "glossary/compilation" "compilation") " performed during " (:term "glossary/evaluation" "evaluation") "."))))
(:entry "glossary/implicit progn" :names ("implicit progn") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " an ordered set of adjacent " (:term "glossary/form" "forms") " appearing in another " (:term "glossary/form" "form") ", and defined by their context in that " (:term "glossary/form" "form") " to be executed as if within a " (:ref "special-operator/progn" "progn") "."))))
(:entry "glossary/implicit tagbody" :names ("implicit tagbody") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " an ordered set of adjacent " (:term "glossary/form" "forms") " and/or " (:term "glossary/tag" "tags") " appearing in another " (:term "glossary/form" "form") ", and defined by their context in that " (:term "glossary/form" "form") " to be executed as if within a " (:ref "special-operator/tagbody" "tagbody") "."))))
(:entry "glossary/import" :names ("import") :kind :glossary-term :kind-name "Glossary Term" :summary "v.t." :sections (("Definition" (:p (:i "v.t.") " " "(a " (:term "glossary/symbol" "symbol") " into a " (:term "glossary/package" "package") ") to make the " (:term "glossary/symbol" "symbol") " be " (:term "glossary/present" "present") " in the " (:term "glossary/package" "package") "."))))
(:entry "glossary/improper list" :names ("improper list") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/list" "list") " which is not a " (:term "glossary/proper list" "proper list") ": a " (:term "glossary/circular list" "circular list") " or a " (:term "glossary/dotted list" "dotted list") "."))))
(:entry "glossary/inaccessible" :names ("inaccessible") :kind :glossary-term :kind-name "Glossary Term" :summary "adj." :sections (("Definition" (:p (:i "adj.") " " " not " (:term "glossary/accessible" "accessible") "."))))
(:entry "glossary/indefinite extent" :names ("indefinite extent") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " an " (:term "glossary/extent" "extent") " whose duration is unlimited. " "“Most Common Lisp objects have indefinite extent.”"))))
(:entry "glossary/indefinite scope" :names ("indefinite scope") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " " (:term "glossary/scope" "scope") " that is unlimited."))))
(:entry "glossary/indicator" :names ("indicator") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/property indicator" "property indicator") "."))))
(:entry "glossary/indirect instance" :names ("indirect instance") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " "(of a " (:term "glossary/class" "class") " " (:math "C" (:sub "1")) ") an " (:term "glossary/object" "object") " of " (:term "glossary/class" "class") " " (:math "C" (:sub "2")) ", where " (:math "C" (:sub "2")) " is a " (:term "glossary/subclass" "subclass") " of " (:math "C" (:sub "1")) ". " "“An integer is an indirect instance of the class " (:ref "system-class/number" "number") ".”"))))
(:entry "glossary/inherit" :names ("inherit") :kind :glossary-term :kind-name "Glossary Term" :summary "to receive or acquire a quality, trait, or characteristic;" :sections (("Definition" (:p (:i "v.t.")) (:list (:item (:label "1.") (:p "to receive or acquire a quality, trait, or characteristic; to gain access to a feature defined elsewhere.")) (:item (:label "2.") (:p "(a " (:term "glossary/class" "class") ") to acquire the structure and behavior defined by a " (:term "glossary/superclass" "superclass") ".")) (:item (:label "3.") (:p "(a " (:term "glossary/package" "package") ") to make " (:term "glossary/symbol" "symbols") " " (:term "glossary/exported" "exported") " by another " (:term "glossary/package" "package") " " (:term "glossary/accessible" "accessible") " by using " (:ref "function/use-package" "use-package") "."))))))
(:entry "glossary/initial pprint dispatch table" :names ("initial pprint dispatch table") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " " "the " (:term "glossary/value" "value") " of " (:ref "variable/*print-pprint-dispatch*" "*print-pprint-dispatch*") " at the time the " (:term "glossary/lisp image" "Lisp image") " is started."))))
(:entry "glossary/initial readtable" :names ("initial readtable") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " " "the " (:term "glossary/value" "value") " of " (:ref "variable/*readtable*" "*readtable*") " at the time the " (:term "glossary/lisp image" "Lisp image") " is started."))))
(:entry "glossary/initialization argument list" :names ("initialization argument list") :kind :glossary-term :kind-name "Glossary Term" :summary "a property list of initialization argument names and values used in the protocol for initializing and reinitializing instances of classes." :sections (("Definition" (:p (:i "n.")) (:p "a " (:term "glossary/property list" "property list") " of initialization argument " (:term "glossary/name" "names") " and " (:term "glossary/value" "values") " used in the protocol for initializing and reinitializing " (:term "glossary/instance" "instances") " of " (:term "glossary/class" "classes") ". " "See " (:secref "ObjectCreationAndInit" "Section 7.1 (Object Creation and Initialization)") "."))))
(:entry "glossary/initialization form" :names ("initialization form") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/form" "form") " used to supply the initial " (:term "glossary/value" "value") " for a " (:term "glossary/slot" "slot") " or " (:term "glossary/variable" "variable") ". " "“The initialization form for a slot in a " (:ref "macro/defclass" "defclass") " form is introduced by the keyword " (:code ":initform") ".”"))))
(:entry "glossary/input" :names ("input") :kind :glossary-term :kind-name "Glossary Term" :summary "adj." :sections (("Definition" (:p (:i "adj.") " " "(of a " (:term "glossary/stream" "stream") ") supporting input operations (" (:i "i.e.") ", " "being a “data source”). An " (:term "glossary/input" "input") " " (:term "glossary/stream" "stream") " might also be an " (:term "glossary/output" "output") " " (:term "glossary/stream" "stream") ", in which case it is sometimes called a " (:term "glossary/bidirectional" "bidirectional") " " (:term "glossary/stream" "stream") ". " "See the " (:term "glossary/function" "function") " " (:ref "function/input-stream-p" "input-stream-p") "."))))
(:entry "glossary/instance" :names ("instance") :kind :glossary-term :kind-name "Glossary Term" :summary "a direct instance." :sections (("Definition" (:p (:i "n.")) (:list (:item (:label "1.") (:p "a " (:term "glossary/direct instance" "direct instance") ".")) (:item (:label "2.") (:p "a " (:term "glossary/generalized instance" "generalized instance") ".")) (:item (:label "3.") (:p "an " (:term "glossary/indirect instance" "indirect instance") "."))))))
(:entry "glossary/integer" :names ("integer") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " an " (:term "glossary/object" "object") " " "of " (:term "glossary/type" "type") " " (:ref "system-class/integer" "integer") ", which represents a mathematical integer."))))
(:entry "glossary/interactive stream" :names ("interactive stream") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/stream" "stream") " on which it makes sense to perform interactive querying. " "See " (:secref "InteractiveStreams" "Section 21.1.1.1.3 (Interactive Streams)") "."))))
(:entry "glossary/intern" :names ("intern") :kind :glossary-term :kind-name "Glossary Term" :summary "(a string in a package) to look up the string in the package, returning either a symbol with that name which was already accessible in the package or a newly created internal symbol of the package…" :sections (("Definition" (:p (:i "v.t.")) (:list (:item (:label "1.") (:p "(a " (:term "glossary/string" "string") " in a " (:term "glossary/package" "package") ") to look up the " (:term "glossary/string" "string") " in the " (:term "glossary/package" "package") ", returning either a " (:term "glossary/symbol" "symbol") " with that " (:term "glossary/name" "name") " which was already " (:term "glossary/accessible" "accessible") " in the " (:term "glossary/package" "package") " or a newly created " (:term "glossary/internal symbol" "internal symbol") " of the " (:term "glossary/package" "package") " with that " (:term "glossary/name" "name") ".")) (:item (:label "2.") (:p (:i "Idiom.") " " "generally, to observe a protocol whereby objects which are equivalent or have equivalent names under some predicate defined by the protocol are mapped to a single canonical object."))))))
(:entry "glossary/internal symbol" :names ("internal symbol") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " "(of a " (:term "glossary/package" "package") ") a symbol which is " (:term "glossary/accessible" "accessible") " in the " (:term "glossary/package" "package") ", but which is not an " (:term "glossary/external symbol" "external symbol") " of the " (:term "glossary/package" "package") "."))))
(:entry "glossary/internal time" :names ("internal time") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " " (:term "glossary/time" "time") ", represented as an " (:term "glossary/integer" "integer") " number of " (:term "glossary/internal time unit" "internal time units") ". " (:term "glossary/absolute" "Absolute") " " (:term "glossary/internal time" "internal time") " is measured as an offset from an arbitrarily chosen, " (:term "glossary/implementation-dependent" "implementation-dependent") " base. " "See " (:secref "InternalTime" "Section 25.1.4.3 (Internal Time)") "."))))
(:entry "glossary/internal time unit" :names ("internal time unit") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a unit of time equal to " (:math "1/n") " of a second, for some " (:term "glossary/implementation-defined" "implementation-defined") " " (:term "glossary/integer" "integer") " value of " (:math "n") ". " "See the " (:term "glossary/variable" "variable") " " (:ref "constant-variable/internal-time-units-per-second" "internal-time-units-per-second") "."))))
(:entry "glossary/interned" :names ("interned") :kind :glossary-term :kind-name "Glossary Term" :summary "(of a symbol) accessible3 in any package." :sections (("Definition" (:p (:i "adj.") " " (:i "Trad.")) (:list (:item (:label "1.") (:p "(of a " (:term "glossary/symbol" "symbol") ") " (:term "glossary/accessible" "accessible") (:sense "3") " in any " (:term "glossary/package" "package") ".")) (:item (:label "2.") (:p "(of a " (:term "glossary/symbol" "symbol") " in a specific " (:term "glossary/package" "package") ") " (:term "glossary/present" "present") " in that " (:term "glossary/package" "package") "."))))))
(:entry "glossary/interpreted function" :names ("interpreted function") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/function" "function") " that is not a " (:term "glossary/compiled function" "compiled function") ". (It is possible for there to be a " (:term "glossary/conforming implementation" "conforming implementation") " which has no " (:term "glossary/interpreted function" "interpreted functions") ", but a " (:term "glossary/conforming program" "conforming program") " must not assume that all " (:term "glossary/function" "functions") " are " (:term "glossary/compiled function" "compiled functions") ".)"))))
(:entry "glossary/interpreted implementation" :names ("interpreted implementation") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " an " (:term "glossary/implementation" "implementation") " that uses an execution strategy for " (:term "glossary/interpreted function" "interpreted functions") " that does not involve a one-time semantic analysis pre-pass, and instead uses “lazy” (and sometimes repetitious) semantic analysis of " (:term "glossary/form" "forms") " as they are encountered during execution."))))
(:entry "glossary/interval designator" :names ("interval designator") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " "(of " (:term "glossary/type" "type") " " (:math "T") ") an ordered pair of " (:term "glossary/object" "objects") " that describe a " (:term "glossary/subtype" "subtype") " of " (:math "T") " by delimiting an interval on the real number line. " "See " (:secref "IntervalDesignators" "Section 12.1.6 (Interval Designators)") "."))))
(:entry "glossary/invalid" :names ("invalid") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") ", " (:i "adj.")) (:list (:item (:label "1.") (:p (:i "n.") " " " a possible " (:term "glossary/constituent trait" "constituent trait") " of a " (:term "glossary/character" "character") " which if present signifies that the " (:term "glossary/character" "character") " cannot ever appear in a " (:term "glossary/token" "token") " except under the control of a " (:term "glossary/single escape" "single escape") " " (:term "glossary/character" "character") ". For details, " "see " (:secref "ConstituentChars" "Section 2.1.4.1 (Constituent Characters)") ".")) (:item (:label "2.") (:p (:i "adj.") " " "(of a " (:term "glossary/character" "character") ") being a " (:term "glossary/character" "character") " that has " (:term "glossary/syntax type" "syntax type") " " (:term "glossary/constituent" "constituent") " in the " (:term "glossary/current readtable" "current readtable") " and that has the " (:term "glossary/constituent trait" "constituent trait") " " (:term "glossary/invalid" "invalid") (:sense "1") ". " "See " (:secref "ConstituentTraitsOfStdChars" "Figure~2--8") "."))))))
(:entry "glossary/iteration form" :names ("iteration form") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/compound form" "compound form") " whose " (:term "glossary/operator" "operator") " is named in " "the next figure" ", or a " (:term "glossary/compound form" "compound form") " that has an " (:term "glossary/implementation-defined" "implementation-defined") " " (:term "glossary/operator" "operator") " and that is defined by the " (:term "glossary/implementation" "implementation") " to be an " (:term "glossary/iteration form" "iteration form") ".") (:table :caption ("Standardized Iteration Forms") :rows ((("do") ("do-external-symbols") ("dotimes")) (("do*") ("do-symbols") ("loop")) (("do-all-symbols") ("dolist") nil))))))
(:entry "glossary/iteration variable" :names ("iteration variable") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/variable" "variable") " " (:math "V") ", the " (:term "glossary/binding" "binding") " for which was created by an " (:term "glossary/explicit use" "explicit use") " of " (:math "V") " in an " (:term "glossary/iteration form" "iteration form") "."))))
(:entry "glossary/key" :names ("key") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " an " (:term "glossary/object" "object") " used for selection during retrieval. " "See " (:term "glossary/association list" "association list") ", " (:term "glossary/property list" "property list") ", and " (:term "glossary/hash table" "hash table") ". Also, " "see " (:secref "SequenceConcepts" "Section 17.1 (Sequence Concepts)") "."))))
(:entry "glossary/keyword" :names ("keyword") :kind :glossary-term :kind-name "Glossary Term" :summary "a symbol the home package of which is the KEYWORD package." :sections (("Definition" (:p (:i "n.")) (:list (:item (:label "1.") (:p "a " (:term "glossary/symbol" "symbol") " the " (:term "glossary/home package" "home package") " of which is " "the " (:ref "type/keyword" "KEYWORD") " " (:term "glossary/package" "package") ".")) (:item (:label "2.") (:p "any " (:term "glossary/symbol" "symbol") ", usually but not necessarily in " "the " (:ref "type/keyword" "KEYWORD") " " (:term "glossary/package" "package") ", that is used as an identifying marker in keyword-style argument passing. " "See " (:code "") "lambda" ".")) (:item (:label "3.") (:p (:i "Idiom.") " " "a " (:term "glossary/lambda list keyword" "lambda list keyword") "."))))))
(:entry "glossary/keyword parameter" :names ("keyword parameter") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " A " (:term "glossary/parameter" "parameter") " for which a corresponding keyword " (:term "glossary/argument" "argument") " is optional. (There is no such thing as a required keyword " (:term "glossary/argument" "argument") ".) If the " (:term "glossary/argument" "argument") " is not supplied, a default value is used. " "See also " (:term "glossary/supplied-p parameter" "supplied-p parameter") "."))))
(:entry "glossary/keyword/value pair" :names ("keyword/value pair") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " two successive " (:term "glossary/element" "elements") " (a " (:term "glossary/keyword" "keyword") " and a " (:term "glossary/value" "value") ", respectively) of a " (:term "glossary/property list" "property list") "."))))
(:entry "glossary/lambda combination" :names ("lambda combination") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " (:i "Trad.") " " " a " (:term "glossary/lambda form" "lambda form") "."))))
(:entry "glossary/lambda expression" :names ("lambda expression") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/list" "list") " which can be used in place of a " (:term "glossary/function name" "function name") " in certain contexts to denote a " (:term "glossary/function" "function") " by directly describing its behavior rather than indirectly by referring to the name of an " (:term "glossary/establish" "established") " " (:term "glossary/function" "function") "; its name derives from the fact that its first element is the " (:term "glossary/symbol" "symbol") " " (:code "lambda") ". " "See " (:code "") "lambda" "."))))
(:entry "glossary/lambda form" :names ("lambda form") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/form" "form") " that is a " (:term "glossary/list" "list") " and that has a first element which is a " (:term "glossary/lambda expression" "lambda expression") " representing a " (:term "glossary/function" "function") " to be called on " (:term "glossary/argument" "arguments") " which are the result of " (:term "glossary/evaluate" "evaluating") " subsequent elements of the " (:term "glossary/lambda form" "lambda form") "."))))
(:entry "glossary/lambda list" :names ("lambda list") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/list" "list") " that specifies a set of " (:term "glossary/parameter" "parameters") " (sometimes called " (:term "glossary/lambda variable" "lambda variables") ") and a protocol for receiving " (:term "glossary/value" "values") " for those " (:term "glossary/parameter" "parameters") "; that is, an " (:term "glossary/ordinary lambda list" "ordinary lambda list") ", an " (:term "glossary/extended lambda list" "extended lambda list") ", or a " (:term "glossary/modified lambda list" "modified lambda list") "."))))
(:entry "glossary/lambda list keyword" :names ("lambda list keyword") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/symbol" "symbol") " whose " (:term "glossary/name" "name") " begins with " (:term "glossary/ampersand" "ampersand") " and that is specially recognized in a " (:term "glossary/lambda list" "lambda list") ". Note that no " (:term "glossary/standardized" "standardized") " " (:term "glossary/lambda list keyword" "lambda list keyword") " is in " "the " (:ref "type/keyword" "KEYWORD") " " (:term "glossary/package" "package") "."))))
(:entry "glossary/lambda variable" :names ("lambda variable") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/formal parameter" "formal parameter") ", used to emphasize the " (:term "glossary/variable" "variable") "’s relation to the " (:term "glossary/lambda list" "lambda list") " that " (:term "glossary/establish" "established") " it."))))
(:entry "glossary/leaf" :names ("leaf") :kind :glossary-term :kind-name "Glossary Term" :summary "an atom in a tree1." :sections (("Definition" (:p (:i "n.")) (:list (:item (:label "1.") (:p "an " (:term "glossary/atom" "atom") " in a " (:term "glossary/tree" "tree") (:sense "1") ".")) (:item (:label "2.") (:p "a terminal node of a " (:term "glossary/tree" "tree") (:sense "2") "."))))))
(:entry "glossary/leap seconds" :names ("leap seconds") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " additional one-second intervals of time that are occasionally inserted into the true calendar by official timekeepers as a correction similar to “leap years.” All " "Common Lisp" " " (:term "glossary/time" "time") " representations ignore " (:term "glossary/leap seconds" "leap seconds") "; every day is assumed to be exactly 86400 seconds long."))))
(:entry "glossary/left-parenthesis" :names ("left-parenthesis") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " the " (:term "glossary/standard character" "standard character") " “" (:code "(") "”, that is variously called “left parenthesis” or “open parenthesis” " "See " (:secref "StdCharsThree" "Figure~2--5") "."))))
(:entry "glossary/length" :names ("length") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " "(of a " (:term "glossary/sequence" "sequence") ") the number of " (:term "glossary/element" "elements") " in the " (:term "glossary/sequence" "sequence") ". (Note that if the " (:term "glossary/sequence" "sequence") " is a " (:term "glossary/vector" "vector") " with a " (:term "glossary/fill pointer" "fill pointer") ", its " (:term "glossary/length" "length") " is the same as the " (:term "glossary/fill pointer" "fill pointer") " even though the total allocated size of the " (:term "glossary/vector" "vector") " might be larger.)"))))
(:entry "glossary/lexical binding" :names ("lexical binding") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/binding" "binding") " in a " (:term "glossary/lexical environment" "lexical environment") "."))))
(:entry "glossary/lexical closure" :names ("lexical closure") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/function" "function") " that, when invoked on " (:term "glossary/argument" "arguments") ", executes the body of a " (:term "glossary/lambda expression" "lambda expression") " in the " (:term "glossary/lexical environment" "lexical environment") " that was captured at the time of the creation of the " (:term "glossary/lexical closure" "lexical closure") ", augmented by " (:term "glossary/binding" "bindings") " of the " (:term "glossary/function" "function") "’s " (:term "glossary/parameter" "parameters") " to the corresponding " (:term "glossary/argument" "arguments") "."))))
(:entry "glossary/lexical environment" :names ("lexical environment") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " that part of the " (:term "glossary/environment" "environment") " that contains " (:term "glossary/binding" "bindings") " whose names have " (:term "glossary/lexical scope" "lexical scope") ". A " (:term "glossary/lexical environment" "lexical environment") " contains, among other things:") (:p "ordinary " (:term "glossary/binding" "bindings") " of " (:term "glossary/variable" "variable") " " (:term "glossary/name" "names") " to " (:term "glossary/value" "values") ", lexically " (:term "glossary/establish" "established") " " (:term "glossary/binding" "bindings") " of " (:term "glossary/function name" "function names") " to " (:term "glossary/function" "functions") ", " (:term "glossary/macro" "macros") ", " (:term "glossary/symbol macro" "symbol macros") ", " (:term "glossary/block" "blocks") ", " (:term "glossary/tag" "tags") ", and " (:term "glossary/local declaration" "local declarations") " (" "see " (:code "") "declare" ")."))))
(:entry "glossary/lexical scope" :names ("lexical scope") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " " (:term "glossary/scope" "scope") " that is limited to a spatial or textual region within the establishing " (:term "glossary/form" "form") ".") (:p "“The names of parameters to a function normally are lexically scoped.”"))))
(:entry "glossary/lexical variable" :names ("lexical variable") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/variable" "variable") " the " (:term "glossary/binding" "binding") " for which is in the " (:term "glossary/lexical environment" "lexical environment") "."))))
(:entry "glossary/lisp image" :names ("Lisp image") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a running instantiation of a " "Common Lisp" " " (:term "glossary/implementation" "implementation") ". A " (:term "glossary/lisp image" "Lisp image") " is characterized by a single address space in which any " (:term "glossary/object" "object") " can directly refer to any another in conformance with this specification, and by a single, common, " (:term "glossary/global environment" "global environment") ". (External operating systems sometimes call this a “core image,” “fork,” “incarnation,” “job,” or “process.” Note however, that the issue of a “process” in such an operating system is technically orthogonal to the issue of a " (:term "glossary/lisp image" "Lisp image") " being defined here. Depending on the operating system, a single “process” might have multiple " (:term "glossary/lisp image" "Lisp images") ", and multiple “processes” might reside in a single " (:term "glossary/lisp image" "Lisp image") ". Hence, it is the idea of a fully shared address space for direct reference among all " (:term "glossary/object" "objects") " which is the defining characteristic. Note, too, that two “processes” which have a communication area that permits the sharing of some but not all " (:term "glossary/object" "objects") " are considered to be distinct " (:term "glossary/lisp image" "Lisp images") ".)"))))
(:entry "glossary/lisp printer" :names ("Lisp printer") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " (:i "Trad.") " " " the procedure that prints the character representation of an " (:term "glossary/object" "object") " onto a " (:term "glossary/stream" "stream") ". (This procedure is implemented by " "the " (:term "glossary/function" "function") " " (:ref "function/write" "write") ".)"))))
(:entry "glossary/lisp read-eval-print loop" :names ("Lisp read-eval-print loop") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " (:i "Trad.") " " " an endless loop that " (:term "glossary/read" "reads") (:sense "2") " a " (:term "glossary/form" "form") ", " (:term "glossary/evaluate" "evaluates") " it, and prints (" (:i "i.e.") ", " (:term "glossary/write" "writes") (:sense "2") ") the results. In many " (:term "glossary/implementation" "implementations") ", the default mode of interaction with " "Common Lisp" " " "during program development is through such a loop."))))
(:entry "glossary/lisp reader" :names ("Lisp reader") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " (:i "Trad.") " " " the procedure that parses character representations of " (:term "glossary/object" "objects") " from a " (:term "glossary/stream" "stream") ", producing " (:term "glossary/object" "objects") ". (This procedure is implemented by " "the " (:term "glossary/function" "function") " " (:ref "function/read" "read") ".)"))))
(:entry "glossary/list" :names ("list") :kind :glossary-term :kind-name "Glossary Term" :summary "a chain of conses in which the car of each cons is an element of the list, and the cdr of each cons is either the next link in the chain or a terminating atom." :sections (("Definition" (:p (:i "n.")) (:list (:item (:label "1.") (:p "a chain of " (:term "glossary/cons" "conses") " in which the " (:term "glossary/car" "car") " of each " (:term "glossary/cons" "cons") " is an " (:term "glossary/element" "element") " of the " (:term "glossary/list" "list") ", and the " (:term "glossary/cdr" "cdr") " of each " (:term "glossary/cons" "cons") " is either the next link in the chain or a terminating " (:term "glossary/atom" "atom") ". " "See also " (:term "glossary/proper list" "proper list") ", " (:term "glossary/dotted list" "dotted list") ", or " (:term "glossary/circular list" "circular list") ".")) (:item (:label "2.") (:p "the " (:term "glossary/type" "type") " that is the union of " (:ref "system-class/null" "null") " and " (:ref "system-class/cons" "cons") "."))))))
(:entry "glossary/list designator" :names ("list designator") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/designator" "designator") " for a " (:term "glossary/list" "list") " of " (:term "glossary/object" "objects") "; that is, an " (:term "glossary/object" "object") " that denotes a " (:term "glossary/list" "list") " and that is one of: a " (:term "glossary/non-nil" "non-nil") " " (:term "glossary/atom" "atom") " (denoting a " (:term "glossary/singleton" "singleton") " " (:term "glossary/list" "list") " whose " (:term "glossary/element" "element") " is that " (:term "glossary/non-nil" "non-nil") " " (:term "glossary/atom" "atom") ") or a " (:term "glossary/proper list" "proper list") " (denoting itself)."))))
(:entry "glossary/list structure" :names ("list structure") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " "(of a " (:term "glossary/list" "list") ") the set of " (:term "glossary/cons" "conses") " that make up the " (:term "glossary/list" "list") ". Note that while the " (:term "glossary/car" "car") (:sense "1b") " component of each such " (:term "glossary/cons" "cons") " is part of the " (:term "glossary/list structure" "list structure") ", the " (:term "glossary/object" "objects") " that are " (:term "glossary/element" "elements") " of the " (:term "glossary/list" "list") " (" (:i "i.e.") ", " "the " (:term "glossary/object" "objects") " that are the " (:term "glossary/car" "cars") (:sense "2") " of each " (:term "glossary/cons" "cons") " in the " (:term "glossary/list" "list") ") are not themselves part of its " (:term "glossary/list structure" "list structure") ", even if they are " (:term "glossary/cons" "conses") ", except in the (" (:term "glossary/circular" "circular") (:sense "2") ") case where the " (:term "glossary/list" "list") " actually contains one of its " (:term "glossary/tail" "tails") " as an " (:term "glossary/element" "element") ". (The " (:term "glossary/list structure" "list structure") " of a " (:term "glossary/list" "list") " is sometimes redundantly referred to as its “top-level list structure” in order to emphasize that any " (:term "glossary/cons" "conses") " that are " (:term "glossary/element" "elements") " of the " (:term "glossary/list" "list") " are not involved.)"))))
(:entry "glossary/literal" :names ("literal") :kind :glossary-term :kind-name "Glossary Term" :summary "adj." :sections (("Definition" (:p (:i "adj.") " " "(of an " (:term "glossary/object" "object") ") referenced directly in a program rather than being computed by the program; that is, appearing as data in a " (:ref "special-operator/quote" "quote") " " (:term "glossary/form" "form") ", or, if the " (:term "glossary/object" "object") " is a " (:term "glossary/self-evaluating object" "self-evaluating object") ", appearing as unquoted data. " "“In the form " (:code "(cons \"one\" '(\"two\"))") ", the expressions " (:code "\"one\"") ", " (:code "(\"two\")") ", and " (:code "\"two\"") " are literal objects.”"))))
(:entry "glossary/load" :names ("load") :kind :glossary-term :kind-name "Glossary Term" :summary "v.t." :sections (("Definition" (:p (:i "v.t.") " " "(a " (:term "glossary/file" "file") ") to cause the " (:term "glossary/code" "code") " contained in the " (:term "glossary/file" "file") " to be " (:term "glossary/execute" "executed") ". " "See the " (:term "glossary/function" "function") " " (:ref "function/load" "load") "."))))
(:entry "glossary/load time" :names ("load time") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " the duration of time that the loader is " (:term "glossary/load" "loading") " " (:term "glossary/compiled code" "compiled code") "."))))
(:entry "glossary/load time value" :names ("load time value") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " an " (:term "glossary/object" "object") " referred to in " (:term "glossary/code" "code") " by a " (:ref "special-operator/load-time-value" "load-time-value") " " (:term "glossary/form" "form") ". The " (:term "glossary/value" "value") " of such a " (:term "glossary/form" "form") " is some specific " (:term "glossary/object" "object") " which can only be computed in the run-time " (:term "glossary/environment" "environment") ". In the case of " (:term "glossary/file" "file") " " (:term "glossary/compilation" "compilation") ", the " (:term "glossary/value" "value") " is computed once as part of the process of " (:term "glossary/load" "loading") " the " (:term "glossary/compiled file" "compiled file") ", and not again. " "See the " (:term "glossary/special operator" "special operator") " " (:ref "special-operator/load-time-value" "load-time-value") "."))))
(:entry "glossary/loader" :names ("loader") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a facility that is part of Lisp and that " (:term "glossary/load" "loads") " a " (:term "glossary/file" "file") ". " "See the " (:term "glossary/function" "function") " " (:ref "function/load" "load") "."))))
(:entry "glossary/local declaration" :names ("local declaration") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " an " (:term "glossary/expression" "expression") " which may appear only in specially designated positions of certain " (:term "glossary/form" "forms") ", and which provides information about the code contained within the containing " (:term "glossary/form" "form") "; that is, a " (:ref "symbol/declare" "declare") " " (:term "glossary/expression" "expression") "."))))
(:entry "glossary/local precedence order" :names ("local precedence order") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " "(of a " (:term "glossary/class" "class") ") a " (:term "glossary/list" "list") " consisting of the " (:term "glossary/class" "class") " followed by its " (:term "glossary/direct superclass" "direct superclasses") " in the order mentioned in the defining " (:term "glossary/form" "form") " for the " (:term "glossary/class" "class") "."))))
(:entry "glossary/local slot" :names ("local slot") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " "(of a " (:term "glossary/class" "class") ") a " (:term "glossary/slot" "slot") " " (:term "glossary/accessible" "accessible") " in only one " (:term "glossary/instance" "instance") ", namely the " (:term "glossary/instance" "instance") " in which the " (:term "glossary/slot" "slot") " is allocated.") (:p (:i "n.")))))
(:entry "glossary/logical block" :names ("logical block") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a conceptual grouping of related output used by the " (:term "glossary/pretty printer" "pretty printer") ". " "See the " (:term "glossary/macro" "macro") " " (:ref "macro/pprint-logical-block" "pprint-logical-block") " and " (:secref "DynamicControlofOutput" "Section 22.2.1.1 (Dynamic Control of the Arrangement of Output)") "."))))
(:entry "glossary/logical host" :names ("logical host") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " an " (:term "glossary/object" "object") " of " (:term "glossary/implementation-dependent" "implementation-dependent") " nature that is used as the representation of a “host” in a " (:term "glossary/logical pathname" "logical pathname") ", and that has an associated set of translation rules for converting " (:term "glossary/logical pathname" "logical pathnames") " belonging to that host into " (:term "glossary/physical pathname" "physical pathnames") ". " "See " (:secref "LogicalPathnames" "Section 19.3 (Logical Pathnames)") "."))))
(:entry "glossary/logical host designator" :names ("logical host designator") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/designator" "designator") " for a " (:term "glossary/logical host" "logical host") "; that is, an " (:term "glossary/object" "object") " that denotes a " (:term "glossary/logical host" "logical host") " and that is one of: a " (:term "glossary/string" "string") " (denoting the " (:term "glossary/logical host" "logical host") " that it names), or a " (:term "glossary/logical host" "logical host") " (denoting itself). (Note that because the representation of a " (:term "glossary/logical host" "logical host") " is " (:term "glossary/implementation-dependent" "implementation-dependent") ", it is possible that an " (:term "glossary/implementation" "implementation") " might represent a " (:term "glossary/logical host" "logical host") " as the " (:term "glossary/string" "string") " that names it.)"))))
(:entry "glossary/logical pathname" :names ("logical pathname") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " an " (:term "glossary/object" "object") " " "of " (:term "glossary/type" "type") " " (:ref "system-class/logical-pathname" "logical-pathname") "."))))
(:entry "glossary/long float" :names ("long float") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " an " (:term "glossary/object" "object") " " "of " (:term "glossary/type" "type") " " (:ref "type/short-float" "long-float") "."))))
(:entry "glossary/loop keyword" :names ("loop keyword") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " (:i "Trad.") " " " a symbol that is a specially recognized part of the syntax of an extended " (:ref "macro/loop" "loop") " " (:term "glossary/form" "form") ". Such symbols are recognized by their " (:term "glossary/name" "name") " (using " (:ref "function/string=" "string=") "), not by their identity; as such, they may be in any package. A " (:term "glossary/loop keyword" "loop keyword") " is not a " (:term "glossary/keyword" "keyword") "."))))
(:entry "glossary/lowercase" :names ("lowercase") :kind :glossary-term :kind-name "Glossary Term" :summary "adj." :sections (("Definition" (:p (:i "adj.") " " "(of a " (:term "glossary/character" "character") ") being among " (:term "glossary/standard character" "standard characters") " corresponding to the small letters " (:code "a") " through " (:code "z") ", or being some other " (:term "glossary/implementation-defined" "implementation-defined") " " (:term "glossary/character" "character") " that is defined by the " (:term "glossary/implementation" "implementation") " to be " (:term "glossary/lowercase" "lowercase") ". " "See " (:secref "CharactersWithCase" "Section 13.1.4.3 (Characters With Case)") "."))))
(:entry "glossary/macro" :names ("macro") :kind :glossary-term :kind-name "Glossary Term" :summary "a macro function." :sections (("Definition" (:p (:i "n.")) (:list (:item (:label "1.") (:p "a " (:term "glossary/macro form" "macro form"))) (:item (:label "2.") (:p "a " (:term "glossary/macro function" "macro function") ".")) (:item (:label "3.") (:p "a " (:term "glossary/macro name" "macro name") "."))))))
(:entry "glossary/macro character" :names ("macro character") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/character" "character") " which, when encountered by the " (:term "glossary/lisp reader" "Lisp reader") " in its main dispatch loop, introduces a " (:term "glossary/reader macro" "reader macro") (:sense "1") ". (" (:term "glossary/macro character" "Macro characters") " have nothing to do with " (:term "glossary/macro" "macros") ".)"))))
(:entry "glossary/macro expansion" :names ("macro expansion") :kind :glossary-term :kind-name "Glossary Term" :summary "the process of translating a macro form into another form." :sections (("Definition" (:p (:i "n.")) (:list (:item (:label "1.") (:p "the process of translating a " (:term "glossary/macro form" "macro form") " into another " (:term "glossary/form" "form") ".")) (:item (:label "2.") (:p "the " (:term "glossary/form" "form") " resulting from this process."))))))
(:entry "glossary/macro form" :names ("macro form") :kind :glossary-term :kind-name "Glossary Term" :summary "a form that stands for another form (e.g., for the purposes of abstraction, information hiding, or syntactic convenience);" :sections (("Definition" (:p (:i "n.")) (:p "a " (:term "glossary/form" "form") " that stands for another " (:term "glossary/form" "form") " (" (:i "e.g.") ", " "for the purposes of abstraction, information hiding, or syntactic convenience); that is, either a " (:term "glossary/compound form" "compound form") " whose first element is a " (:term "glossary/macro name" "macro name") ", or a " (:term "glossary/form" "form") " that is a " (:term "glossary/symbol" "symbol") " that names a " (:term "glossary/symbol macro" "symbol macro") "."))))
(:entry "glossary/macro function" :names ("macro function") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/function" "function") " of two arguments, a " (:term "glossary/form" "form") " and an " (:term "glossary/environment" "environment") ", that implements " (:term "glossary/macro expansion" "macro expansion") " by producing a " (:term "glossary/form" "form") " to be evaluated in place of the original argument " (:term "glossary/form" "form") "."))))
(:entry "glossary/macro lambda list" :names ("macro lambda list") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " an " (:term "glossary/extended lambda list" "extended lambda list") " used in " (:term "glossary/form" "forms") " that " (:term "glossary/establish" "establish") " " (:term "glossary/macro" "macro") " definitions, such as " (:ref "macro/defmacro" "defmacro") " and " (:ref "special-operator/flet" "macrolet") ". " "See " (:secref "MacroLambdaLists" "Section 3.4.4 (Macro Lambda Lists)") "."))))
(:entry "glossary/macro name" :names ("macro name") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/name" "name") " for which " (:ref "accessor/macro-function" "macro-function") " returns " (:term "glossary/true" "true") " and which when used as the first element of a " (:term "glossary/compound form" "compound form") " identifies that " (:term "glossary/form" "form") " as a " (:term "glossary/macro form" "macro form") "."))))
(:entry "glossary/macroexpand hook" :names ("macroexpand hook") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " the " (:term "glossary/function" "function") " that is " "the " (:term "glossary/value" "value") " of " (:ref "variable/*macroexpand-hook*" "*macroexpand-hook*") "."))))
(:entry "glossary/mapping" :names ("mapping") :kind :glossary-term :kind-name "Glossary Term" :summary "a type of iteration in which a function is successively applied to objects taken from corresponding entries in collections such as sequences or hash tables." :sections (("Definition" (:p (:i "n.")) (:list (:item (:label "1.") (:p "a type of iteration in which a " (:term "glossary/function" "function") " is successively applied to " (:term "glossary/object" "objects") " taken from corresponding entries in collections such as " (:term "glossary/sequence" "sequences") " or " (:term "glossary/hash table" "hash tables") ".")) (:item (:label "2.") (:p (:i "Math.") " " "a relation between two sets in which each element of the first set (the “domain”) is assigned one element of the second set (the “range”)."))))))
(:entry "glossary/metaclass" :names ("metaclass") :kind :glossary-term :kind-name "Glossary Term" :summary "a class whose instances are classes." :sections (("Definition" (:p (:i "n.")) (:list (:item (:label "1.") (:p "a " (:term "glossary/class" "class") " whose instances are " (:term "glossary/class" "classes") ".")) (:item (:label "2.") (:p "(of an " (:term "glossary/object" "object") ") the " (:term "glossary/class" "class") " of the " (:term "glossary/class" "class") " of the " (:term "glossary/object" "object") "."))))))
(:entry "glossary/metaobject protocol" :names ("Metaobject Protocol") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " one of many possible descriptions of how a " (:term "glossary/conforming implementation" "conforming implementation") " might implement various aspects of the " "object system" ". This description is beyond the scope of this document, and no " (:term "glossary/conforming implementation" "conforming implementation") " is required to adhere to it except as noted explicitly in this specification. Nevertheless, its existence helps to establish normative practice, and implementors with no reason to diverge from it are encouraged to consider making their " (:term "glossary/implementation" "implementation") " adhere to it where possible. It is described in detail in " "The Art of the Metaobject Protocol" "."))))
(:entry "glossary/method" :names ("method") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " an " (:term "glossary/object" "object") " that is part of a " (:term "glossary/generic function" "generic function") " and which provides information about how that " (:term "glossary/generic function" "generic function") " should behave when its " (:term "glossary/argument" "arguments") " are " (:term "glossary/object" "objects") " of certain " (:term "glossary/class" "classes") " or with certain identities."))))
(:entry "glossary/method combination" :names ("method combination") :kind :glossary-term :kind-name "Glossary Term" :summary "generally, the composition of a set of methods to produce an effective method for a generic function." :sections (("Definition" (:p (:i "n.")) (:list (:item (:label "1.") (:p "generally, the composition of a set of " (:term "glossary/method" "methods") " to produce an " (:term "glossary/effective method" "effective method") " for a " (:term "glossary/generic function" "generic function") ".")) (:item (:label "2.") (:p "an object " "of " (:term "glossary/type" "type") " " (:ref "system-class/method-combination" "method-combination") ", which represents the details of how the " (:term "glossary/method combination" "method combination") (:sense "1") " for one or more specific " (:term "glossary/generic function" "generic functions") " is to be performed."))))))
(:entry "glossary/method-defining form" :names ("method-defining form") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/form" "form") " that defines a " (:term "glossary/method" "method") " for a " (:term "glossary/generic function" "generic function") ", whether explicitly or implicitly. " "See " (:secref "IntroToGFs" "Section 7.6.1 (Introduction to Generic Functions)") "."))))
(:entry "glossary/method-defining operator" :names ("method-defining operator") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " an " (:term "glossary/operator" "operator") " corresponding to a " (:term nil "method-defining") " " (:term "glossary/form" "form") ". " "See " (:secref "StdMethDefOps" "Figure~7--1") "."))))
(:entry "glossary/minimal compilation" :names ("minimal compilation") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " actions the " (:term "glossary/compiler" "compiler") " must take at compile time. " "See " (:secref "CompilationSemantics" "Section 3.2.2 (Compilation Semantics)") "."))))
(:entry "glossary/modified lambda list" :names ("modified lambda list") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a list resembling an " (:term "glossary/ordinary lambda list" "ordinary lambda list") " in form and purpose, but which deviates in syntax or functionality from the definition of an " (:term "glossary/ordinary lambda list" "ordinary lambda list") ". " "See " (:term "glossary/ordinary lambda list" "ordinary lambda list") ". " "“" (:ref "macro/deftype" "deftype") " uses a modified lambda list.”"))))
(:entry "glossary/most recent" :names ("most recent") :kind :glossary-term :kind-name "Glossary Term" :summary "adj." :sections (("Definition" (:p (:i "adj.") " " " innermost; that is, having been " (:term "glossary/establish" "established") " (and not yet " (:term "glossary/disestablish" "disestablished") ")") (:p "more recently than any other of its kind."))))
(:entry "glossary/multiple escape" :names ("multiple escape") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") ", " (:i "adj.")) (:list (:item (:label "1.") (:p (:i "n.") " " "the " (:term "glossary/syntax type" "syntax type") " of a " (:term "glossary/character" "character") " that is used in pairs to indicate that the enclosed " (:term "glossary/character" "characters") " are to be treated as " (:term "glossary/alphabetic" "alphabetic") (:sense "2") " " (:term "glossary/character" "characters") " with their " (:term "glossary/case" "case") " preserved. For details, " "see " (:secref "MultipleEscapeChar" "Section 2.1.4.5 ({}Multiple Escape Characters)") ".")) (:item (:label "2.") (:p (:i "adj.") " " "(of a " (:term "glossary/character" "character") ") having the " (:term "glossary/multiple escape" "multiple escape") " " (:term "glossary/syntax type" "syntax type") ".")) (:item (:label "3.") (:p (:i "n.") " " "a " (:term "glossary/multiple escape" "multiple escape") (:sense "2") " " (:term "glossary/character" "character") ". (In the " (:term "glossary/standard readtable" "standard readtable") ", " (:term "glossary/vertical-bar" "vertical-bar") " is a " (:term "glossary/multiple escape" "multiple escape") " " (:term "glossary/character" "character") ".)"))))))
(:entry "glossary/multiple values" :names ("multiple values") :kind :glossary-term :kind-name "Glossary Term" :summary "more than one value." :sections (("Definition" (:p (:i "n.")) (:list (:item (:label "1.") (:p "more than one " (:term "glossary/value" "value") ". " "“The function " (:ref "function/floor" "truncate") " returns multiple values.”")) (:item (:label "2.") (:p "a variable number of " (:term "glossary/value" "values") ", possibly including zero or one. " "“The function " (:ref "accessor/values" "values") " returns multiple values.”")) (:item (:label "3.") (:p "a fixed number of values other than one. " "“The macro " (:ref "macro/multiple-value-bind" "multiple-value-bind") " is among the few operators in " "Common Lisp" " " "which can detect and manipulate multiple values.”"))))))
(:entry "glossary/name" :names ("name") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") ", " (:i "v.t.")) (:list (:item (:label "1.") (:p (:i "n.") " " "an " (:term "glossary/identifier" "identifier") " by which an " (:term "glossary/object" "object") ", a " (:term "glossary/binding" "binding") ", or an " (:term "glossary/exit point" "exit point")) (:p "is referred to by association using a " (:term "glossary/binding" "binding") ".")) (:item (:label "2.") (:p (:i "v.t.") " " "to give a " (:term "glossary/name" "name") " to.")) (:item (:label "3.") (:p (:i "n.") " " "(of an " (:term "glossary/object" "object") " having a name component) the " (:term "glossary/object" "object") " which is that component. " "“The string which is a symbol’s name is returned by " (:ref "function/symbol-name" "symbol-name") ".”")) (:item (:label "4.") (:p (:i "n.") " " "(of a " (:term "glossary/pathname" "pathname") ") a. the name component, returned by " (:ref "function/pathname-host" "pathname-name") ". b. the entire namestring, returned by " (:ref "function/namestring" "namestring") ".")) (:item (:label "5.") (:p (:i "n.") " " "(of a " (:term "glossary/character" "character") ") a " (:term "glossary/string" "string") " that names the " (:term "glossary/character" "character") " and that has " (:term "glossary/length" "length") " greater than one. (All " (:term "glossary/non-graphic" "non-graphic") " " (:term "glossary/character" "characters") " are required to have " (:term "glossary/name" "names") " unless they have some " (:term "glossary/implementation-defined" "implementation-defined") " " (:term "glossary/attribute" "attribute") " which is not " (:term "glossary/null" "null") ". Whether or not other " (:term "glossary/character" "characters") " have " (:term "glossary/name" "names") " is " (:term "glossary/implementation-dependent" "implementation-dependent") ".)"))))))
(:entry "glossary/named constant" :names ("named constant") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/variable" "variable") " that is defined by " "Common Lisp" ", by the " (:term "glossary/implementation" "implementation") ", or by user code (" "see the " (:term "glossary/macro" "macro") " " (:ref "macro/defconstant" "defconstant") ") to always " (:term "glossary/yield" "yield") " the same " (:term "glossary/value" "value") " when " (:term "glossary/evaluate" "evaluated") ". " "“The value of a named constant may not be changed by assignment or by binding.”"))))
(:entry "glossary/namespace" :names ("namespace") :kind :glossary-term :kind-name "Glossary Term" :summary "bindings whose denotations are restricted to a particular kind." :sections (("Definition" (:p (:i "n.")) (:list (:item (:label "1.") (:p (:term "glossary/binding" "bindings") " whose denotations are restricted to a particular kind. " "“The bindings of names to tags is the tag namespace.”")) (:item (:label "2.") (:p "any " (:term "glossary/mapping" "mapping") " whose domain is a set of " (:term "glossary/name" "names") ". " "“A package defines a namespace.”"))))))
(:entry "glossary/namestring" :names ("namestring") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/string" "string") " that represents a " (:term "glossary/filename" "filename") " using either the " (:term "glossary/standardized" "standardized") " notation for naming " (:term "glossary/logical pathname" "logical pathnames") " described in " (:secref "LogPathNamestrings" "Section 19.3.1 (Syntax of Logical Pathname Namestrings)") ", or some " (:term "glossary/implementation-defined" "implementation-defined") " notation for naming a " (:term "glossary/physical pathname" "physical pathname") "."))))
(:entry "glossary/newline" :names ("newline") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " the " (:term "glossary/standard character" "standard character") " " "⟨" (:i "Newline") "⟩" ", notated for the " (:term "glossary/lisp reader" "Lisp reader") " as " (:code "#" "\\" "Newline") "."))))
(:entry "glossary/next method" :names ("next method") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " the next " (:term "glossary/method" "method") " to be invoked with respect to a given " (:term "glossary/method" "method") " for a particular set of arguments or argument " (:term "glossary/class" "classes") ".") (:p "See " (:secref "ApplyMethCombToSortedMethods" "Section 7.6.6.1.3 (Applying method combination to the sorted list of applicable methods)") "."))))
(:entry "glossary/nickname" :names ("nickname") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " "(of a " (:term "glossary/package" "package") ") one of possibly several " (:term "glossary/name" "names") " that can be used to refer to the " (:term "glossary/package" "package") " but that is not the primary " (:term "glossary/name" "name") " of the " (:term "glossary/package" "package") "."))))
(:entry "glossary/nil" :names ("nil") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " the " (:term "glossary/object" "object") " that is at once the " (:term "glossary/symbol" "symbol") " named " (:code "\"NIL\"") " in " "the " (:code "COMMON-LISP") " " (:term "glossary/package" "package") ", the " (:term "glossary/empty list" "empty list") ", the " (:term "glossary/boolean" "boolean") " (or " (:term "glossary/generalized boolean" "generalized boolean") ") representing " (:term "glossary/false" "false") ", and the " (:term "glossary/name" "name") " of the " (:term "glossary/empty type" "empty type") "."))))
(:entry "glossary/non-atomic" :names ("non-atomic") :kind :glossary-term :kind-name "Glossary Term" :summary "adj." :sections (("Definition" (:p (:i "adj.") " " " being other than an " (:term "glossary/atom" "atom") "; " (:i "i.e.") ", " "being a " (:term "glossary/cons" "cons") "."))))
(:entry "glossary/non-constant variable" :names ("non-constant variable") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/variable" "variable") " that is not a " (:term "glossary/constant variable" "constant variable") "."))))
(:entry "glossary/non-correctable" :names ("non-correctable") :kind :glossary-term :kind-name "Glossary Term" :summary "adj." :sections (("Definition" (:p (:i "adj.") " " "(of an " (:term "glossary/error" "error") ") not intentionally " (:term "glossary/correctable" "correctable") ". (Because of the dynamic nature of " (:term "glossary/restart" "restarts") ", it is neither possible nor generally useful to completely prohibit an " (:term "glossary/error" "error") " from being " (:term "glossary/correctable" "correctable") ". This term is used in order to express an intent that no special effort should be made by " (:term "glossary/code" "code") " signaling an " (:term "glossary/error" "error") " to make that " (:term "glossary/error" "error") " " (:term "glossary/correctable" "correctable") "; however, there is no actual requirement on " (:term "glossary/conforming program" "conforming programs") " or " (:term "glossary/conforming implementation" "conforming implementations") " imposed by this term.)"))))
(:entry "glossary/non-empty" :names ("non-empty") :kind :glossary-term :kind-name "Glossary Term" :summary "adj." :sections (("Definition" (:p (:i "adj.") " " " having at least one " (:term "glossary/element" "element") "."))))
(:entry "glossary/non-eq" :names ("non-eq") :kind :glossary-term :kind-name "Glossary Term" :sections (("Definition" (:p (:i "adj.")))))
(:entry "glossary/non-generic function" :names ("non-generic function") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/function" "function") " that is not a " (:term "glossary/generic function" "generic function") "."))))
(:entry "glossary/non-graphic" :names ("non-graphic") :kind :glossary-term :kind-name "Glossary Term" :summary "adj." :sections (("Definition" (:p (:i "adj.") " " "(of a " (:term "glossary/character" "character") ") not " (:term "glossary/graphic" "graphic") ". " "See " (:secref "GraphicChars" "Section 13.1.4.1 (Graphic Characters)") "."))))
(:entry "glossary/non-list" :names ("non-list") :kind :glossary-term :kind-name "Glossary Term" :summary "n., adj." :sections (("Definition" (:p (:i "n.") ", " (:i "adj.") " " " other than a " (:term "glossary/list" "list") "; " (:i "i.e.") ", " "a " (:term "glossary/non-nil" "non-nil") " " (:term "glossary/atom" "atom") "."))))
(:entry "glossary/non-local exit" :names ("non-local exit") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a transfer of control (and sometimes " (:term "glossary/value" "values") ") to an " (:term "glossary/exit point" "exit point") " for reasons other than a " (:term "glossary/normal return" "normal return") ". " "“The operators " (:ref "special-operator/go" "go") ", " (:ref "special-operator/throw" "throw") ", and " (:ref "special-operator/return-from" "return-from") " cause a non-local exit.”"))))
(:entry "glossary/non-nil" :names ("non-nil") :kind :glossary-term :kind-name "Glossary Term" :summary "n., adj." :sections (("Definition" (:p (:i "n.") ", " (:i "adj.") " " " not " (:ref "constant-variable/nil" "nil") ". Technically, any " (:term "glossary/object" "object") " which is not " (:ref "constant-variable/nil" "nil") " " "can be referred to as " (:term "glossary/true" "true") ", but that would tend to imply a unique view of the " (:term "glossary/object" "object") " as a " (:term "glossary/generalized boolean" "generalized boolean") ". Referring to such an " (:term "glossary/object" "object") " as " (:term "glossary/non-nil" "non-nil") " avoids this implication."))))
(:entry "glossary/non-null lexical environment" :names ("non-null lexical environment") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/lexical environment" "lexical environment") " that has additional information not present in the " (:term "glossary/global environment" "global environment") ", such as one or more " (:term "glossary/binding" "bindings") "."))))
(:entry "glossary/non-simple" :names ("non-simple") :kind :glossary-term :kind-name "Glossary Term" :summary "adj." :sections (("Definition" (:p (:i "adj.") " " " not " (:term "glossary/simple" "simple") "."))))
(:entry "glossary/non-terminating" :names ("non-terminating") :kind :glossary-term :kind-name "Glossary Term" :summary "adj." :sections (("Definition" (:p (:i "adj.") " " "(of a " (:term "glossary/macro character" "macro character") ") being such that it is treated as a constituent " (:term "glossary/character" "character") " when it appears in the middle of an extended token. " "See " (:secref "ReaderAlgorithm" "Section 2.2 (Reader Algorithm)") "."))))
(:entry "glossary/non-top-level form" :names ("non-top-level form") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/form" "form") " that, by virtue of its position as a " (:term "glossary/subform" "subform") " of another " (:term "glossary/form" "form") ", is not a " (:term "glossary/top level form" "top level form") ". " "See " (:secref "TopLevelForms" "Section 3.2.3.1 (Processing of Top Level Forms)") "."))))
(:entry "glossary/normal return" :names ("normal return") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " the natural transfer of control and " (:term "glossary/value" "values") " which occurs after the complete " (:term nil "execution") " of a " (:term "glossary/form" "form") "."))))
(:entry "glossary/normalized" :names ("normalized") :kind :glossary-term :kind-name "Glossary Term" :summary "adj., ANSI, IEEE (of a float) conforming to the description of “normalized” as described by IEEE Standard for Binary Floating-Point Arithmetic." :sections (("Definition" (:p (:i "adj.") ", " (:i "ANSI") ", " (:i "IEEE") " " "(of a " (:term "glossary/float" "float") ") conforming to the description of “normalized” as described by " "IEEE Standard for Binary Floating-Point Arithmetic" ". " "See " (:term "glossary/denormalized" "denormalized") "."))))
(:entry "glossary/null" :names ("null") :kind :glossary-term :kind-name "Glossary Term" :summary "adj." :sections (("Definition" (:p (:i "adj.") ", " (:i "n.")) (:list (:item (:label "1.") (:p (:i "adj.") " " " a. (of a " (:term "glossary/list" "list") ") having no " (:term "glossary/element" "elements") ": empty. " "See " (:term "glossary/empty list" "empty list") ". b. (of a " (:term "glossary/string" "string") ") having a " (:term "glossary/length" "length") " of zero. (It is common, both within this document and in observed spoken behavior, to refer to an empty string by an apparent definite reference, as in “the " (:term "glossary/null" "null") " " (:term "glossary/string" "string") "” even though no attempt is made to " (:term "glossary/intern" "intern") (:sense "2") " null strings. The phrase “a " (:term "glossary/null" "null") " " (:term "glossary/string" "string") "” is technically more correct, but is generally considered awkward by most Lisp programmers. As such, the phrase “the " (:term "glossary/null" "null") " " (:term "glossary/string" "string") "” should be treated as an indefinite reference in all cases except for anaphoric references.) c. (of an " (:term "glossary/implementation-defined" "implementation-defined") " " (:term "glossary/attribute" "attribute") " of a " (:term "glossary/character" "character") ") An " (:term "glossary/object" "object") " to which the value of that " (:term "glossary/attribute" "attribute") " defaults if no specific value was requested.")) (:item (:label "2.") (:p (:i "n.") " " "an " (:term "glossary/object" "object") " " "of " (:term "glossary/type" "type") " " (:ref "system-class/null" "null") " (the only such " (:term "glossary/object" "object") " being " (:ref "constant-variable/nil" "nil") ")."))))))
(:entry "glossary/null lexical environment" :names ("null lexical environment") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " the " (:term "glossary/lexical environment" "lexical environment") " which has no " (:term "glossary/binding" "bindings") "."))))
(:entry "glossary/number" :names ("number") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " an " (:term "glossary/object" "object") " " "of " (:term "glossary/type" "type") " " (:ref "system-class/number" "number") "."))))
(:entry "glossary/numeric" :names ("numeric") :kind :glossary-term :kind-name "Glossary Term" :summary "adj." :sections (("Definition" (:p (:i "adj.") " " "(of a " (:term "glossary/character" "character") ") being one of the " (:term "glossary/standard character" "standard characters") " " (:code "0") " through " (:term nil "9") ", or being some other " (:term "glossary/graphic" "graphic") " " (:term "glossary/character" "character") " defined by the " (:term "glossary/implementation" "implementation") " to be " (:term "glossary/numeric" "numeric") "."))))
(:entry "glossary/object" :names ("object") :kind :glossary-term :kind-name "Glossary Term" :summary "any Lisp datum." :sections (("Definition" (:p (:i "n.")) (:list (:item (:label "1.") (:p "any Lisp datum. " "“The function " (:ref "function/cons" "cons") " creates an object which refers to two other objects.”")) (:item (:label "2.") (:p "(immediately following the name of a " (:term "glossary/type" "type") ") an " (:term "glossary/object" "object") " which is of that " (:term "glossary/type" "type") ", used to emphasize that the " (:term "glossary/object" "object") " is not just a " (:term "glossary/name" "name") " for an object of that " (:term "glossary/type" "type") " but really an " (:term "glossary/element" "element") " of the " (:term "glossary/type" "type") " in cases where " (:term "glossary/object" "objects") " of that " (:term "glossary/type" "type") " (such as " (:ref "system-class/function" "function") " or " (:ref "system-class/class" "class") ") are commonly referred to by " (:term "glossary/name" "name") ". " "“The function " (:ref "accessor/symbol-function" "symbol-function") " takes a function name and returns a function object.”"))))))
(:entry "glossary/object-traversing" :names ("object-traversing") :kind :glossary-term :kind-name "Glossary Term" :summary "adj." :sections (("Definition" (:p (:i "adj.") " " " operating in succession on components of an " (:term "glossary/object" "object") ". " "“The operators " (:ref "function/mapc" "mapcar") ", " (:ref "function/maphash" "maphash") ", " (:ref "macro/with-package-iterator" "with-package-iterator") " and " (:ref "function/count" "count") " perform object-traversing operations.”"))))
(:entry "glossary/open" :names ("open") :kind :glossary-term :kind-name "Glossary Term" :summary "adj., v.t." :sections (("Definition" (:p (:i "adj.") ", " (:i "v.t.") " " "(a " (:term "glossary/file" "file") ")") (:list (:item (:label "1.") (:p (:i "v.t.") " " "to create and return a " (:term "glossary/stream" "stream") " to the " (:term "glossary/file" "file") ".")) (:item (:label "2.") (:p (:i "adj.") " " "(of a " (:term "glossary/stream" "stream") ") having been " (:term "glossary/open" "opened") (:sense "1") ", but not yet " (:term "glossary/closed" "closed") "."))))))
(:entry "glossary/operator" :names ("operator") :kind :glossary-term :kind-name "Glossary Term" :summary "a function, macro, or special operator." :sections (("Definition" (:p (:i "n.")) (:list (:item (:label "1.") (:p "a " (:term "glossary/function" "function") ", " (:term "glossary/macro" "macro") ", or " (:term "glossary/special operator" "special operator") ".")) (:item (:label "2.") (:p "a " (:term "glossary/symbol" "symbol") " that names such a " (:term "glossary/function" "function") ", " (:term "glossary/macro" "macro") ", or " (:term "glossary/special operator" "special operator") ".")) (:item (:label "3.") (:p "(in a " (:ref "special-operator/function" "function") " " (:term "glossary/special form" "special form") ") the " (:term "glossary/cadr" "cadr") " of the " (:ref "special-operator/function" "function") " " (:term "glossary/special form" "special form") ", which might be either an " (:term "glossary/operator" "operator") (:sense "2") " or a " (:term "glossary/lambda expression" "lambda expression") ".")) (:item (:label "4.") (:p "(of a " (:term "glossary/compound form" "compound form") ") the " (:term "glossary/car" "car") " of the " (:term "glossary/compound form" "compound form") ", which might be either an " (:term "glossary/operator" "operator") (:sense "2")) (:p "or a " (:term "glossary/lambda expression" "lambda expression") ", and which is never " (:code "(setf " (:term "glossary/symbol" "symbol") ")") "."))))))
(:entry "glossary/optimize quality" :names ("optimize quality") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " one of several aspects of a program that might be optimizable by certain compilers. Since optimizing one such quality might conflict with optimizing another, relative priorities for qualities can be established in an " (:ref "declaration/optimize" "optimize") " " (:term "glossary/declaration" "declaration") ". The " (:term "glossary/standardized" "standardized") " " (:term "glossary/optimize quality" "optimize qualities") " are " (:code "compilation-speed") " (speed of the compilation process), " " " (:code "debug") " (ease of debugging), " (:code "safety") " (run-time error checking), " (:code "space") " (both code size and run-time space), and " (:code "speed") " (of the object code). " (:term "glossary/implementation" "Implementations") " may define additional " (:term "glossary/optimize quality" "optimize qualities") "."))))
(:entry "glossary/optional parameter" :names ("optional parameter") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " A " (:term "glossary/parameter" "parameter") " for which a corresponding positional " (:term "glossary/argument" "argument") " is optional. If the " (:term "glossary/argument" "argument") " is not supplied, a default value is used. " "See also " (:term "glossary/supplied-p parameter" "supplied-p parameter") "."))))
(:entry "glossary/ordinary function" :names ("ordinary function") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/function" "function") " that is not a " (:term "glossary/generic function" "generic function") "."))))
(:entry "glossary/ordinary lambda list" :names ("ordinary lambda list") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " the kind of " (:term "glossary/lambda list" "lambda list") " used by " (:ref "symbol/lambda" "lambda") ". " "See " (:term "glossary/modified lambda list" "modified lambda list") " and " (:term "glossary/extended lambda list" "extended lambda list") ". " "“" (:ref "macro/defun" "defun") " uses an ordinary lambda list.”"))))
(:entry "glossary/otherwise inaccessible part" :names ("otherwise inaccessible part") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " "(of an " (:term "glossary/object" "object") ", " (:math "O" (:sub "1")) ") an " (:term "glossary/object" "object") ", " (:math "O" (:sub "2")) ", which would be made " (:term "glossary/inaccessible" "inaccessible") " if " (:math "O" (:sub "1")) " were made " (:term "glossary/inaccessible" "inaccessible") ". (Every " (:term "glossary/object" "object") " is an " (:term "glossary/otherwise inaccessible part" "otherwise inaccessible part") " of itself.)"))))
(:entry "glossary/output" :names ("output") :kind :glossary-term :kind-name "Glossary Term" :summary "adj." :sections (("Definition" (:p (:i "adj.") " " "(of a " (:term "glossary/stream" "stream") ") supporting output operations (" (:i "i.e.") ", " "being a “data sink”). An " (:term "glossary/output" "output") " " (:term "glossary/stream" "stream") " might also be an " (:term "glossary/input" "input") " " (:term "glossary/stream" "stream") ", in which case it is sometimes called a " (:term "glossary/bidirectional" "bidirectional") " " (:term "glossary/stream" "stream") ". " "See the " (:term "glossary/function" "function") " " (:ref "function/input-stream-p" "output-stream-p") "."))))
(:entry "glossary/package" :names ("package") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " an " (:term "glossary/object" "object") " " "of " (:term "glossary/type" "type") " " (:ref "system-class/package" "package") "."))))
(:entry "glossary/package cell" :names ("package cell") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " (:i "Trad.") " " "(of a " (:term "glossary/symbol" "symbol") ") The " (:term "glossary/place" "place") " in a " (:term "glossary/symbol" "symbol") " that holds one of possibly several " (:term "glossary/package" "packages") " in which the " (:term "glossary/symbol" "symbol") " is " (:term "glossary/interned" "interned") ", called the " (:term "glossary/home package" "home package") ", or which holds " (:ref "constant-variable/nil" "nil") " " "if no such " (:term "glossary/package" "package") " exists or is known. " "See the " (:term "glossary/function" "function") " " (:ref "function/symbol-package" "symbol-package") "."))))
(:entry "glossary/package designator" :names ("package designator") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/designator" "designator") " for a " (:term "glossary/package" "package") "; that is, an " (:term "glossary/object" "object") " that denotes a " (:term "glossary/package" "package") " and that is one of: a " (:term "glossary/string designator" "string designator") " (denoting the " (:term "glossary/package" "package") " that has the " (:term "glossary/string" "string") " that it designates as its " (:term "glossary/name" "name") " or as one of its " (:term "glossary/nickname" "nicknames") "), or a " (:term "glossary/package" "package") " (denoting itself)."))))
(:entry "glossary/package marker" :names ("package marker") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a character which is used in the textual notation for a symbol to separate the package name from the symbol name, and which is " (:term "glossary/colon" "colon") " in the " (:term "glossary/standard readtable" "standard readtable") ". " "See " (:secref "CharacterSyntax" "Section 2.1 (Character Syntax)") "."))))
(:entry "glossary/package name designator" :names ("package name designator") :kind :glossary-term :kind-name "Glossary Term" :sections (("Definition" (:p (:i "n.")))))
(:entry "glossary/package prefix" :names ("package prefix") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a notation preceding the " (:term "glossary/name" "name") " of a " (:term "glossary/symbol" "symbol") " in text that is processed by the " (:term "glossary/lisp reader" "Lisp reader") ", which uses a " (:term "glossary/package" "package") " " (:term "glossary/name" "name") " followed by one or more " (:term "glossary/package marker" "package markers") ", and which indicates that the symbol is looked up in the indicated " (:term "glossary/package" "package") "."))))
(:entry "glossary/package registry" :names ("package registry") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " A mapping of " (:term "glossary/name" "names") " to " (:term "glossary/package" "package") " " (:term "glossary/object" "objects") ". It is possible for there to be a " (:term "glossary/package" "package") " " (:term "glossary/object" "object") " which is not in this mapping; such a " (:term "glossary/package" "package") " is called an " (:term "glossary/unregistered package" "unregistered package") ". " (:term "glossary/operator" "Operators") " such as " (:ref "function/find-package" "find-package") " consult this mapping in order to find a " (:term "glossary/package" "package") " from its " (:term "glossary/name" "name") ". " (:term "glossary/operator" "Operators") " such as " (:ref "macro/do-symbols" "do-all-symbols") ", " (:ref "function/find-all-symbols" "find-all-symbols") ", and " (:ref "function/list-all-packages" "list-all-packages") " operate only on " (:term "glossary/package" "packages") " that exist in the " (:term "glossary/package registry" "package registry") "."))))
(:entry "glossary/pairwise" :names ("pairwise") :kind :glossary-term :kind-name "Glossary Term" :summary "adv." :sections (("Definition" (:p (:i "adv.") " " "(of an adjective on a set) applying individually to all possible pairings of elements of the set. " "“The types " (:math "A") ", " (:math "B") ", and " (:math "C") " are pairwise disjoint if " (:math "A") " and " (:math "B") " are disjoint, " (:math "B") " and " (:math "C") " are disjoint, and " (:math "A") " and " (:math "C") " are disjoint.”"))))
(:entry "glossary/parallel" :names ("parallel") :kind :glossary-term :kind-name "Glossary Term" :summary "adj." :sections (("Definition" (:p (:i "adj.") " " (:i "Trad.") " " "(of " (:term "glossary/binding" "binding") " or " (:term nil "assignment") ") done in the style of " (:ref "macro/psetq" "psetq") ", " (:ref "special-operator/let" "let") ", or " (:ref "macro/do" "do") "; that is, first evaluating all of the " (:term "glossary/form" "forms") " that produce " (:term "glossary/value" "values") ", and only then " (:term "glossary/assign" "assigning") " or " (:term "glossary/binding" "binding") " the " (:term "glossary/variable" "variables") " (or " (:term "glossary/place" "places") "). Note that this does not imply traditional computational “parallelism” since the " (:term "glossary/form" "forms") " that produce " (:term "glossary/value" "values") " are evaluated " (:term "glossary/sequentially" "sequentially") ". " "See " (:term "glossary/sequential" "sequential") "."))))
(:entry "glossary/parameter" :names ("parameter") :kind :glossary-term :kind-name "Glossary Term" :summary "(of a function) a variable in the definition of a function which takes on the value of a corresponding argument (or of a list of corresponding arguments) to that function when it is called, or…" :sections (("Definition" (:p (:i "n.")) (:list (:item (:label "1.") (:p "(of a " (:term "glossary/function" "function") ") a " (:term "glossary/variable" "variable") " in the definition of a " (:term "glossary/function" "function") " which takes on the " (:term "glossary/value" "value") " of a corresponding " (:term "glossary/argument" "argument") " (or of a " (:term "glossary/list" "list") " of corresponding arguments) to that " (:term "glossary/function" "function") " when it is called, or which in some cases is given a default value because there is no corresponding " (:term "glossary/argument" "argument") ".")) (:item (:label "2.") (:p "(of a " (:term "glossary/format directive" "format directive") ")") (:p "an " (:term "glossary/object" "object") " received as data flow by a " (:term "glossary/format directive" "format directive") " due to a prefix notation within the " (:term "glossary/format string" "format string") " at the " (:term "glossary/format directive" "format directive") "’s point of use. " "See " (:secref "FormattedOutput" "Section 22.3 (Formatted Output)") ". " "“In " (:code "\"~3,'0D\"") ", the number " (:code "3") " and the character " (:code "#" "\\" "0") " are parameters to the " (:code "~D") " format directive.”"))))))
(:entry "glossary/parameter specializer" :names ("parameter specializer") :kind :glossary-term :kind-name "Glossary Term" :summary "(of a method) an expression which constrains the method to be applicable only to argument sequences in which the corresponding argument matches the parameter specializer." :sections (("Definition" (:p (:i "n.")) (:list (:item (:label "1.") (:p "(of a " (:term "glossary/method" "method") ") an " (:term "glossary/expression" "expression") " which constrains the " (:term "glossary/method" "method") " to be applicable only to " (:term "glossary/argument" "argument") " sequences in which the corresponding " (:term "glossary/argument" "argument") " matches the " (:term "glossary/parameter specializer" "parameter specializer") ".")) (:item (:label "2.") (:p "a " (:term "glossary/class" "class") ", or a " (:term "glossary/list" "list") " " (:code "(eql " (:term "glossary/object" "object") ")") "."))))))
(:entry "glossary/parameter specializer name" :names ("parameter specializer name") :kind :glossary-term :kind-name "Glossary Term" :summary "(of a method definition) an expression used in code to name a parameter specializer." :sections (("Definition" (:p (:i "n.")) (:list (:item (:label "1.") (:p "(of a " (:term "glossary/method" "method") " definition) an expression used in code to name a " (:term "glossary/parameter specializer" "parameter specializer") ". " "See " (:secref "IntroToMethods" "Section 7.6.2 (Introduction to Methods)") ".")) (:item (:label "2.") (:p "a " (:term "glossary/class" "class") ", " " a " (:term "glossary/symbol" "symbol") " naming a " (:term "glossary/class" "class") ", " " or a " (:term "glossary/list" "list") " " (:code "(eql " (:term "glossary/form" "form") ")") "."))))))
(:entry "glossary/pathname" :names ("pathname") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " an " (:term "glossary/object" "object") " " "of " (:term "glossary/type" "type") " " (:ref "system-class/pathname" "pathname") ", which is a structured representation of the name of a " (:term "glossary/file" "file") ". A " (:term "glossary/pathname" "pathname") " has six components: a “host,” a “device,” a “directory,” a “name,” a “type,” and a “version.”"))))
(:entry "glossary/pathname designator" :names ("pathname designator") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/designator" "designator") " for a " (:term "glossary/pathname" "pathname") "; that is, an " (:term "glossary/object" "object") " that denotes a " (:term "glossary/pathname" "pathname") " and that is one of: " " a " (:term "glossary/pathname" "pathname") " " (:term "glossary/namestring" "namestring")) (:p "(denoting the corresponding " (:term "glossary/pathname" "pathname") "), " " " " a " (:term "glossary/stream associated with a file" "stream associated with a file")) (:p "(denoting the " (:term "glossary/pathname" "pathname") " used to open the " (:term "glossary/file" "file") "; this may be, but is not required to be, the actual name of the " (:term "glossary/file" "file") "), or a " (:term "glossary/pathname" "pathname") " (denoting itself). " "See " (:secref "OpenAndClosedStreams" "Section 21.1.1.1.2 (Open and Closed Streams)") "."))))
(:entry "glossary/pervasive" :names ("pervasive") :kind :glossary-term :kind-name "Glossary Term" :sections (("Definition" (:p (:i "n.")))))
(:entry "glossary/physical pathname" :names ("physical pathname") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/pathname" "pathname") " that is not a " (:term "glossary/logical pathname" "logical pathname") ".") (:p (:note "KMP: Still need to reconcile some confusion in the uses of “generalized reference” and “place.” I think one was supposed to refer to the abstract concept, and the other to an object (a form), but the usages have become blurred.")))))
(:entry "glossary/place" :names ("place") :kind :glossary-term :kind-name "Glossary Term" :summary "a form which is suitable for use as a generalized reference." :sections (("Definition" (:p (:i "n.")) (:list (:item (:label "1.") (:p "a " (:term "glossary/form" "form") " which is suitable for use as a " (:term "glossary/generalized reference" "generalized reference") ".")) (:item (:label "2.") (:p "the conceptual location referred to by such a " (:term "glossary/place" "place") (:sense "1") "."))))))
(:entry "glossary/plist" :names ("plist") :kind :glossary-term :kind-name "Glossary Term" :summary "[width 1pt height 2pt depth 2ptpewidth 1pt height 2pt depth 2ptlist] n." :sections (("Definition" (:p (:math "[" (:b (:math) (:math) "width 1pt height 2pt depth 2pt" (:math) (:math) "p" "e" (:math) "width 1pt height 2pt depth 2pt" (:math) "list") "]") " " (:i "n.") " " " a " (:term "glossary/property list" "property list") "."))))
(:entry "glossary/portable" :names ("portable") :kind :glossary-term :kind-name "Glossary Term" :summary "adj." :sections (("Definition" (:p (:i "adj.") " " "(of " (:term "glossary/code" "code") ") required to produce equivalent results and observable side effects in all " (:term "glossary/conforming implementation" "conforming implementations") "."))))
(:entry "glossary/potential copy" :names ("potential copy") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " "(of an " (:term "glossary/object" "object") " " (:math "O" (:sub "1")) " subject to constriants) an " (:term "glossary/object" "object") " " (:math "O" (:sub "2")) " that if the specified constraints are satisfied by " (:math "O" (:sub "1")) " without any modification might or might not be " (:term "glossary/identical" "identical") " to " (:math "O" (:sub "1")) ", or else that must be a " (:term "glossary/fresh" "fresh") " " (:term "glossary/object" "object") " that resembles a " (:term "glossary/copy" "copy") " of " (:math "O" (:sub "1")) " except that it has been modified as necessary to satisfy the constraints."))))
(:entry "glossary/potential number" :names ("potential number") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " A textual notation that might be parsed by the " (:term "glossary/lisp reader" "Lisp reader") " in some " (:term "glossary/conforming implementation" "conforming implementation") " as a " (:term "glossary/number" "number") " but is not required to be parsed as a " (:term "glossary/number" "number") ". No " (:term "glossary/object" "object") " is a " (:term "glossary/potential number" "potential number") "—either an " (:term "glossary/object" "object") " is a " (:term "glossary/number" "number") " or it is not. " "See " (:secref "PotentialNumbersAsTokens" "Section 2.3.1.1 (Potential Numbers as Tokens)") "."))))
(:entry "glossary/pprint dispatch table" :names ("pprint dispatch table") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " an " (:term "glossary/object" "object") " that can be " "the " (:term "glossary/value" "value") " of " (:ref "variable/*print-pprint-dispatch*" "*print-pprint-dispatch*") " and hence can control how " (:term "glossary/object" "objects") " are printed when " (:ref "variable/*print-pretty*" "*print-pretty*") " is " (:term "glossary/true" "true") ". " "See " (:secref "PPrintDispatchTables" "Section 22.2.1.4 ({}Pretty Print Dispatch Tables)") "."))))
(:entry "glossary/predicate" :names ("predicate") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/function" "function") " that returns a " (:term "glossary/generalized boolean" "generalized boolean") " as its first value."))))
(:entry "glossary/present" :names ("present") :kind :glossary-term :kind-name "Glossary Term" :summary "(of a feature in a Lisp image) a state of being that is in effect if and only if the symbol naming the feature is an element of the features list." :sections (("Definition" (:p (:i "n.")) (:list (:item (:label "1.") (:p "(of a " (:term "glossary/feature" "feature") " in a " (:term "glossary/lisp image" "Lisp image") ") a state of being that is in effect if and only if the " (:term "glossary/symbol" "symbol") " naming the " (:term "glossary/feature" "feature") " is an " (:term "glossary/element" "element") " of the " (:term "glossary/features list" "features list") ".")) (:item (:label "2.") (:p "(of a " (:term "glossary/symbol" "symbol") " in a " (:term "glossary/package" "package") ") being accessible in that " (:term "glossary/package" "package") " directly, rather than being inherited from another " (:term "glossary/package" "package") "."))))))
(:entry "glossary/pretty print" :names ("pretty print") :kind :glossary-term :kind-name "Glossary Term" :summary "v.t." :sections (("Definition" (:p (:i "v.t.") " " "(an " (:term "glossary/object" "object") ") to invoke the " (:term "glossary/pretty printer" "pretty printer") " on the " (:term "glossary/object" "object") "."))))
(:entry "glossary/pretty printer" :names ("pretty printer") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " the procedure that prints the character representation of an " (:term "glossary/object" "object") " onto a " (:term "glossary/stream" "stream") " when the " (:term "glossary/value" "value") " of " (:ref "variable/*print-pretty*" "*print-pretty*") " is " (:term "glossary/true" "true") ", and that uses layout techniques (" (:i "e.g.") ", " "indentation) that tend to highlight the structure of the " (:term "glossary/object" "object") " in a way that makes it easier for human readers to parse visually. " "See the " (:term "glossary/variable" "variable") " " (:ref "variable/*print-pprint-dispatch*" "*print-pprint-dispatch*") " and " (:secref "PPrinter" "Section 22.2 (The Lisp Pretty Printer)") "."))))
(:entry "glossary/pretty printing stream" :names ("pretty printing stream") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/stream" "stream") " that does pretty printing. Such streams are created by " "the " (:term "glossary/function" "function") " " (:ref "macro/pprint-logical-block" "pprint-logical-block") " as a link between the output stream and the logical block."))))
(:entry "glossary/primary method" :names ("primary method") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a member of one of two sets of " (:term "glossary/method" "methods") " (the set of " (:term "glossary/auxiliary method" "auxiliary methods") " is the other) that form an exhaustive partition of the set of " (:term "glossary/method" "methods") " on the " (:term "glossary/method" "method") "’s " (:term "glossary/generic function" "generic function") ". How these sets are determined is dependent on the " (:term "glossary/method combination" "method combination") " type; " "see " (:secref "IntroToMethods" "Section 7.6.2 (Introduction to Methods)") "."))))
(:entry "glossary/primary value" :names ("primary value") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " "(of " (:term "glossary/value" "values") " resulting from the " (:term "glossary/evaluation" "evaluation") " of a " (:term "glossary/form" "form") ") the first " (:term "glossary/value" "value") ", if any, or else " (:ref "constant-variable/nil" "nil") " " "if there are no " (:term "glossary/value" "values") ". " "“The primary value returned by " (:ref "function/floor" "truncate") " is an integer quotient, truncated toward zero.”"))))
(:entry "glossary/principal" :names ("principal") :kind :glossary-term :kind-name "Glossary Term" :summary "adj." :sections (("Definition" (:p (:i "adj.") " " "(of a value returned by a " "Common Lisp" " " (:term "glossary/function" "function") " that implements a mathematically irrational or transcendental function defined in the complex domain) of possibly many (sometimes an infinite number of) correct values for the mathematical function, being the particular " (:term "glossary/value" "value") " which the corresponding " "Common Lisp" " " (:term "glossary/function" "function") " has been defined to return."))))
(:entry "glossary/print name" :names ("print name") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " (:i "Trad.") " " "(usually of a " (:term "glossary/symbol" "symbol") ") a " (:term "glossary/name" "name") (:sense "3") "."))))
(:entry "glossary/printer control variable" :names ("printer control variable") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/variable" "variable") " whose specific purpose is to control some action of the " (:term "glossary/lisp printer" "Lisp printer") "; that is, one of the " (:term "glossary/variable" "variables") " in " (:secref "StdPrinterControlVars" "Figure~22--1") ", or else some " (:term "glossary/implementation-defined" "implementation-defined") " " (:term "glossary/variable" "variable") " which is defined by the " (:term "glossary/implementation" "implementation") " to be a " (:term "glossary/printer control variable" "printer control variable") "."))))
(:entry "glossary/printer escaping" :names ("printer escaping") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " The combined state of the " (:term "glossary/printer control variable" "printer control variables") " " (:ref "variable/*print-escape*" "*print-escape*") " and " (:ref "variable/*print-readably*" "*print-readably*") ". If the value of either " (:ref "variable/*print-readably*" "*print-readably*") " or " (:ref "variable/*print-escape*" "*print-escape*") " is " (:term "glossary/true" "true") ", then " (:term "glossary/printer escaping" "printer escaping") " is “enabled”; otherwise (if the values of both " (:ref "variable/*print-readably*" "*print-readably*") " and " (:ref "variable/*print-escape*" "*print-escape*") " are " (:term "glossary/false" "false") "), then " (:term "glossary/printer escaping" "printer escaping") " is “disabled”."))))
(:entry "glossary/printing" :names ("printing") :kind :glossary-term :kind-name "Glossary Term" :summary "adj." :sections (("Definition" (:p (:i "adj.") " " "(of a " (:term "glossary/character" "character") ") being a " (:term "glossary/graphic" "graphic") " " (:term "glossary/character" "character") " other than " (:term "glossary/space" "space") "."))))
(:entry "glossary/process" :names ("process") :kind :glossary-term :kind-name "Glossary Term" :summary "v.t." :sections (("Definition" (:p (:i "v.t.") " " "(a " (:term "glossary/form" "form") " by the " (:term "glossary/compiler" "compiler") ") to perform " (:term "glossary/minimal compilation" "minimal compilation") ", determining the time of evaluation for a " (:term "glossary/form" "form") ", and possibly " (:term "glossary/evaluate" "evaluating") " that " (:term "glossary/form" "form") " (if required)."))))
(:entry "glossary/processor" :names ("processor") :kind :glossary-term :kind-name "Glossary Term" :summary "n., ANSI an implementation." :sections (("Definition" (:p (:i "n.") ", " (:i "ANSI") " " " an " (:term "glossary/implementation" "implementation") "."))))
(:entry "glossary/proclaim" :names ("proclaim") :kind :glossary-term :kind-name "Glossary Term" :summary "v.t." :sections (("Definition" (:p (:i "v.t.") " " "(a " (:term "glossary/proclamation" "proclamation") ") to " (:term "glossary/establish" "establish") " that " (:term "glossary/proclamation" "proclamation") "."))))
(:entry "glossary/proclamation" :names ("proclamation") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/global declaration" "global declaration") "."))))
(:entry "glossary/prog tag" :names ("prog tag") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " (:i "Trad.") " " " a " (:term "glossary/go tag" "go tag") "."))))
(:entry "glossary/program" :names ("program") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " (:i "Trad.") " " " " "Common Lisp" " " (:term "glossary/code" "code") "."))))
(:entry "glossary/programmer" :names ("programmer") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " an active entity, typically a human, that writes a " (:term "glossary/program" "program") ", and that might or might not also be a " (:term "glossary/user" "user") " of the " (:term "glossary/program" "program") "."))))
(:entry "glossary/programmer code" :names ("programmer code") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " " (:term "glossary/code" "code") " that is supplied by the programmer; that is, " (:term "glossary/code" "code") " that is not " (:term "glossary/system code" "system code") "."))))
(:entry "glossary/proper list" :names ("proper list") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " A " (:term "glossary/list" "list") " terminated by the " (:term "glossary/empty list" "empty list") ". (The " (:term "glossary/empty list" "empty list") " is a " (:term "glossary/proper list" "proper list") ".) " "See " (:term "glossary/improper list" "improper list") "."))))
(:entry "glossary/proper name" :names ("proper name") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " "(of a " (:term "glossary/class" "class") ") a " (:term "glossary/symbol" "symbol") " that " (:term "glossary/name" "names") " the " (:term "glossary/class" "class") " whose " (:term "glossary/name" "name") " is that " (:term "glossary/symbol" "symbol") ". " "See the " (:term "glossary/function" "functions") " " (:ref "standard-generic-function/class-name" "class-name") " and " (:ref "accessor/find-class" "find-class") "."))))
(:entry "glossary/proper sequence" :names ("proper sequence") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/sequence" "sequence") " which is not an " (:term "glossary/improper list" "improper list") "; that is, a " (:term "glossary/vector" "vector") " or a " (:term "glossary/proper list" "proper list") "."))))
(:entry "glossary/proper subtype" :names ("proper subtype") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " "(of a " (:term "glossary/type" "type") ") a " (:term "glossary/subtype" "subtype") " of the " (:term "glossary/type" "type") " which is not the " (:term "glossary/same" "same") " " (:term "glossary/type" "type") " as the " (:term "glossary/type" "type") " (" (:i "i.e.") ", " "its " (:term "glossary/element" "elements") " are a “proper subset” of the " (:term "glossary/type" "type") ")."))))
(:entry "glossary/property" :names ("property") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " "(of a " (:term "glossary/property list" "property list") ")") (:list (:item (:label "1.") (:p "a conceptual pairing of a " (:term "glossary/property indicator" "property indicator") " and its associated " (:term "glossary/property value" "property value") " on a " (:term "glossary/property list" "property list") ".")) (:item (:label "2.") (:p "a " (:term "glossary/property value" "property value") "."))))))
(:entry "glossary/property indicator" :names ("property indicator") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " "(of a " (:term "glossary/property list" "property list") ") the " (:term "glossary/name" "name") " part of a " (:term "glossary/property" "property") ", used as a " (:term "glossary/key" "key") " when looking up a " (:term "glossary/property value" "property value") " on a " (:term "glossary/property list" "property list") "."))))
(:entry "glossary/property list" :names ("property list") :kind :glossary-term :kind-name "Glossary Term" :summary "a list containing an even number of elements that are alternating names (sometimes called indicators or keys) and values (sometimes called properties)." :sections (("Definition" (:p (:i "n.")) (:list (:item (:label "1.") (:p "a " (:term "glossary/list" "list") " containing an even number of " (:term "glossary/element" "elements") " that are alternating " (:term "glossary/name" "names") " (sometimes called " (:term "glossary/indicator" "indicators") " or " (:term "glossary/key" "keys") ") and " (:term "glossary/value" "values") " (sometimes called " (:term "glossary/property" "properties") "). When there is more than one " (:term "glossary/name" "name") " and " (:term "glossary/value" "value") " pair with the " (:term "glossary/identical" "identical") " " (:term "glossary/name" "name") " in a " (:term "glossary/property list" "property list") ", the first such pair determines the " (:term "glossary/property" "property") ".")) (:item (:label "2.") (:p "(of a " (:term "glossary/symbol" "symbol") ") the component of the " (:term "glossary/symbol" "symbol") " containing a " (:term "glossary/property list" "property list") "."))))))
(:entry "glossary/property list format" :names ("property list format") :kind :glossary-term :kind-name "Glossary Term" :sections (("Definition" (:p (:i "n.")))))
(:entry "glossary/property value" :names ("property value") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " "(of a " (:term "glossary/property indicator" "property indicator") " on a " (:term "glossary/property list" "property list") ") the " (:term "glossary/object" "object") " associated with the " (:term "glossary/property indicator" "property indicator") " on the " (:term "glossary/property list" "property list") "."))))
(:entry "glossary/purports to conform" :names ("purports to conform") :kind :glossary-term :kind-name "Glossary Term" :summary "v." :sections (("Definition" (:p (:i "v.") " " " makes a good-faith claim of conformance. This term expresses intention to conform, regardless of whether the goal of that intention is realized in practice. For example, language implementations have been known to have bugs, and while an " (:term "glossary/implementation" "implementation") " of this specification with bugs might not be a " (:term "glossary/conforming implementation" "conforming implementation") ", it can still " (:term nil "purport to conform") ". This is an important distinction in certain specific cases; " (:i "e.g.") ", " "see the " (:term "glossary/variable" "variable") " " (:ref "variable/*features*" "*features*") "."))))
(:entry "glossary/qualified method" :names ("qualified method") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/method" "method") " that has one or more " (:term "glossary/qualifier" "qualifiers") "."))))
(:entry "glossary/qualifier" :names ("qualifier") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " "(of a " (:term "glossary/method" "method") " for a " (:term "glossary/generic function" "generic function") ") one of possibly several " (:term "glossary/object" "objects") " used to annotate the " (:term "glossary/method" "method") " in a way that identifies its role in the " (:term "glossary/method combination" "method combination") ". The " (:term "glossary/method combination" "method combination") " " (:term "glossary/type" "type") " determines how many " (:term "glossary/qualifier" "qualifiers") " are permitted for each " (:term "glossary/method" "method") ", which " (:term "glossary/qualifier" "qualifiers") " are permitted, and the semantics of those " (:term "glossary/qualifier" "qualifiers") "."))))
(:entry "glossary/query i/o" :names ("query I/O") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " the " (:term "glossary/bidirectional" "bidirectional") " " (:term "glossary/stream" "stream") " that is the " (:term "glossary/value" "value") " of " "the " (:term "glossary/variable" "variable") " " (:ref "variable/*debug-io*" "*query-io*") "."))))
(:entry "glossary/quoted object" :names ("quoted object") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " an " (:term "glossary/object" "object") " which is the second element of a " (:ref "special-operator/quote" "quote") " " (:term "glossary/form" "form") "."))))
(:entry "glossary/radix" :names ("radix") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " an " (:term "glossary/integer" "integer") " between 2 and 36, inclusive, which can be used to designate a base with respect to which certain kinds of numeric input or output are performed.") (:p "(There are " (:math "n") " valid digit characters for any given " (:term "glossary/radix" "radix") " " (:math "n") ", and those digits are the first " (:math "n") " digits in the sequence " (:code "0") ", " (:code "1") ", " (:math "…") ", " (:code "9") ", " (:code "A") ", " (:code "B") ", " (:math "…") ", " (:code "Z") ", which have the weights " (:code "0") ", " (:code "1") ", " (:math "…") ", " (:code "9") ", " (:code "10") ", " (:code "11") ", " (:math "…") ", " (:code "35") ", respectively. Case is not significant in parsing numbers of radix greater than " (:code "10") ", so “9b8a” and “9B8A” denote the same " (:term "glossary/radix" "radix") " " (:code "16") " number.)"))))
(:entry "glossary/random state" :names ("random state") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " an " (:term "glossary/object" "object") " " "of " (:term "glossary/type" "type") " " (:ref "system-class/random-state" "random-state") "."))))
(:entry "glossary/rank" :names ("rank") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a non-negative " (:term "glossary/integer" "integer") " indicating the number of " (:term "glossary/dimension" "dimensions") " of an " (:term "glossary/array" "array") "."))))
(:entry "glossary/ratio" :names ("ratio") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " an " (:term "glossary/object" "object") " " "of " (:term "glossary/type" "type") " " (:ref "system-class/ratio" "ratio") "."))))
(:entry "glossary/ratio marker" :names ("ratio marker") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a character which is used in the textual notation for a " (:term "glossary/ratio" "ratio") " to separate the numerator from the denominator, and which is " (:term "glossary/slash" "slash") " in the " (:term "glossary/standard readtable" "standard readtable") ". " "See " (:secref "CharacterSyntax" "Section 2.1 (Character Syntax)") "."))))
(:entry "glossary/rational" :names ("rational") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " an " (:term "glossary/object" "object") " " "of " (:term "glossary/type" "type") " " (:ref "system-class/rational" "rational") "."))))
(:entry "glossary/read" :names ("read") :kind :glossary-term :kind-name "Glossary Term" :summary "(a binding or slot or component) to obtain the value of the binding or slot." :sections (("Definition" (:p (:i "v.t.")) (:list (:item (:label "1.") (:p "(a " (:term "glossary/binding" "binding") " or " (:term "glossary/slot" "slot") " or component) to obtain the " (:term "glossary/value" "value") " of the " (:term "glossary/binding" "binding") " or " (:term "glossary/slot" "slot") ".")) (:item (:label "2.") (:p "(an " (:term "glossary/object" "object") " from a " (:term "glossary/stream" "stream") ") to parse an " (:term "glossary/object" "object") " from its representation on the " (:term "glossary/stream" "stream") "."))))))
(:entry "glossary/read macro" :names ("read macro") :kind :glossary-term :kind-name "Glossary Term" :sections (("Definition" (:p (:i "n.") " " (:i "Trad.")))))
(:entry "glossary/readable" :names ("readable") :kind :glossary-term :kind-name "Glossary Term" :summary "adj." :sections (("Definition" (:p (:i "adj.") " " "(of the printed representation of an " (:term "glossary/object" "object") ")"))))
(:entry "glossary/readably" :names ("readably") :kind :glossary-term :kind-name "Glossary Term" :summary "adv." :sections (("Definition" (:p (:i "adv.") " " "(of a manner of printing an " (:term "glossary/object" "object") " " (:math "O" (:sub "1")) ") in such a way as to permit the " (:term "glossary/lisp reader" "Lisp Reader") " to later " (:term nil "parse") " the printed output into an " (:term "glossary/object" "object") " " (:math "O" (:sub "2")) " that is " (:term "glossary/similar" "similar") " to " (:math "O" (:sub "1")) "."))))
(:entry "glossary/reader" :names ("reader") :kind :glossary-term :kind-name "Glossary Term" :summary "a function that reads1 a variable or slot." :sections (("Definition" (:p (:i "n.")) (:list (:item (:label "1.") (:p "a " (:term "glossary/function" "function") " that " (:term "glossary/read" "reads") (:sense "1") " a " (:term "glossary/variable" "variable") " or " (:term "glossary/slot" "slot") ".")) (:item (:label "2.") (:p "the " (:term "glossary/lisp reader" "Lisp reader") "."))))))
(:entry "glossary/reader macro" :names ("reader macro") :kind :glossary-term :kind-name "Glossary Term" :summary "a textual notation introduced by dispatch on one or two characters that defines special-purpose syntax for use by the Lisp reader, and that is implemented by a reader macro function." :sections (("Definition" (:p (:i "n.")) (:list (:item (:label "1.") (:p "a textual notation introduced by dispatch on one or two " (:term "glossary/character" "characters") " that defines special-purpose syntax for use by the " (:term "glossary/lisp reader" "Lisp reader") ", and that is implemented by a " (:term "glossary/reader macro function" "reader macro function") ". " "See " (:secref "ReaderAlgorithm" "Section 2.2 (Reader Algorithm)") ".")) (:item (:label "2.") (:p "the " (:term "glossary/character" "character") " or " (:term "glossary/character" "characters") " that introduce a " (:term "glossary/reader macro" "reader macro") (:sense "1") "; that is, a " (:term "glossary/macro character" "macro character") " or the conceptual pairing of a " (:term "glossary/dispatching macro character" "dispatching macro character") " and the " (:term "glossary/character" "character") " that follows it. (A " (:term "glossary/reader macro" "reader macro") " is not a kind of " (:term "glossary/macro" "macro") ".)"))))))
(:entry "glossary/reader macro function" :names ("reader macro function") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/function" "function") " " (:term "glossary/designator" "designator") " that denotes a " (:term "glossary/function" "function") " that implements a " (:term "glossary/reader macro" "reader macro") (:sense "2") ". " "See the " (:term "glossary/function" "functions") " " (:ref "function/set-macro-character" "set-macro-character") " and " (:ref "function/set-dispatch-macro-character" "set-dispatch-macro-character") "."))))
(:entry "glossary/readtable" :names ("readtable") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " an " (:term "glossary/object" "object") " " "of " (:term "glossary/type" "type") " " (:ref "system-class/readtable" "readtable") "."))))
(:entry "glossary/readtable case" :names ("readtable case") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " an attribute of a " (:term "glossary/readtable" "readtable") " whose value is a " (:term "glossary/case sensitivity mode" "case sensitivity mode") ", and that selects the manner in which " (:term "glossary/character" "characters") " in a " (:term "glossary/symbol" "symbol") "’s " (:term "glossary/name" "name") " are to be treated by the " (:term "glossary/lisp reader" "Lisp reader") " and the " (:term "glossary/lisp printer" "Lisp printer") ". " "See " (:secref "ReadtableCaseReadEffect" "Section 23.1.2 ({}Effect of Readtable Case on the Lisp Reader)") " " "and " (:secref "ReadtableCasePrintEffect" "Section 22.1.3.3.2 ({}Effect of Readtable Case on the Lisp Printer)") "."))))
(:entry "glossary/readtable designator" :names ("readtable designator") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/designator" "designator") " for a " (:term "glossary/readtable" "readtable") "; that is, an " (:term "glossary/object" "object") " that denotes a " (:term "glossary/readtable" "readtable") " and that is one of: " (:ref "constant-variable/nil" "nil") " " "(denoting the " (:term "glossary/standard readtable" "standard readtable") "), or a " (:term "glossary/readtable" "readtable") " (denoting itself)."))))
(:entry "glossary/recognizable subtype" :names ("recognizable subtype") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " "(of a " (:term "glossary/type" "type") ") a " (:term "glossary/subtype" "subtype") " of the " (:term "glossary/type" "type") " which can be reliably detected to be such by the " (:term "glossary/implementation" "implementation") ". " "See the " (:term "glossary/function" "function") " " (:ref "function/subtypep" "subtypep") "."))))
(:entry "glossary/reference" :names ("reference") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") ", " (:i "v.t.")) (:list (:item (:label "1.") (:p (:i "n.") " " "an act or occurrence of referring to an " (:term "glossary/object" "object") ", a " (:term "glossary/binding" "binding") ", an " (:term "glossary/exit point" "exit point") ", a " (:term "glossary/tag" "tag") ", or an " (:term "glossary/environment" "environment") ".")) (:item (:label "2.") (:p (:i "v.t.") " " "to refer to an " (:term "glossary/object" "object") ", a " (:term "glossary/binding" "binding") ", an " (:term "glossary/exit point" "exit point") ", a " (:term "glossary/tag" "tag") ", or an " (:term "glossary/environment" "environment") ", usually by " (:term "glossary/name" "name") "."))))))
(:entry "glossary/registered package" :names ("registered package") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/package" "package") " " (:term "glossary/object" "object") " that is installed in the " (:term "glossary/package registry" "package registry") ". (Every " (:term "glossary/registered package" "registered package") " has a " (:term "glossary/name" "name") " that is a " (:term "glossary/string" "string") ", as well as zero or more " (:term "glossary/string" "string") " nicknames. All " (:term "glossary/package" "packages") " that are initially specified by " "Common Lisp" " " " or created by " (:ref "function/make-package" "make-package") " or " (:ref "macro/defpackage" "defpackage") " are " (:term "glossary/registered package" "registered packages") ". " (:term "glossary/registered package" "Registered packages") " can be turned into " (:term "glossary/unregistered package" "unregistered packages") " by " (:ref "function/delete-package" "delete-package") ".)"))))
(:entry "glossary/relative" :names ("relative") :kind :glossary-term :kind-name "Glossary Term" :summary "(of a time) representing an offset from an absolute time in the units appropriate to that time." :sections (("Definition" (:p (:i "adj.")) (:list (:item (:label "1.") (:p "(of a " (:term "glossary/time" "time") ") representing an offset from an " (:term "glossary/absolute" "absolute") " " (:term "glossary/time" "time") " in the units appropriate to that time. For example, a " (:term "glossary/relative" "relative") " " (:term "glossary/internal time" "internal time") " is the difference between two " (:term "glossary/absolute" "absolute") " " (:term "glossary/internal time" "internal times") ", and is measured in " (:term "glossary/internal time unit" "internal time units") ".")) (:item (:label "2.") (:p "(of a " (:term "glossary/pathname" "pathname") ") representing a position in a directory hierarchy by motion from a position other than the root, which might therefore vary. " "“The notation " (:code "#" "P\"../foo.text\"") " denotes a relative pathname if the host file system is Unix.”" " " "See " (:term "glossary/absolute" "absolute") "."))))))
(:entry "glossary/repertoire" :names ("repertoire") :kind :glossary-term :kind-name "Glossary Term" :summary "n., ISO a subtype of character." :sections (("Definition" (:p (:i "n.") ", " (:i "ISO") " " " a " (:term "glossary/subtype" "subtype") " of " (:ref "system-class/character" "character") ". " "See " (:secref "CharRepertoires" "Section 13.1.2.2 (Character Repertoires)") "."))))
(:entry "glossary/report" :names ("report") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " "(of a " (:term "glossary/condition" "condition") ") to " (:term "glossary/call" "call") " " "the " (:term "glossary/function" "function") " " (:ref "standard-generic-function/print-object" "print-object") " on the " (:term "glossary/condition" "condition") " in an " (:term "glossary/environment" "environment") " where " "the " (:term "glossary/value" "value") " of " (:ref "variable/*print-escape*" "*print-escape*") " is " (:term "glossary/false" "false") "."))))
(:entry "glossary/report message" :names ("report message") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " the text that is output by a " (:term "glossary/condition reporter" "condition reporter") "."))))
(:entry "glossary/required parameter" :names ("required parameter") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " A " (:term "glossary/parameter" "parameter") " for which a corresponding positional " (:term "glossary/argument" "argument") " must be supplied when " (:term "glossary/call" "calling") " the " (:term "glossary/function" "function") "."))))
(:entry "glossary/rest list" :names ("rest list") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " "(of a " (:term "glossary/function" "function") " having a " (:term "glossary/rest parameter" "rest parameter") ") The " (:term "glossary/list" "list") " to which the " (:term "glossary/rest parameter" "rest parameter") " is " (:term "glossary/bound" "bound") " on some particular " (:term "glossary/call" "call") " to the " (:term "glossary/function" "function") "."))))
(:entry "glossary/rest parameter" :names ("rest parameter") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " A " (:term "glossary/parameter" "parameter") " which was introduced by " (:code "&rest") "."))))
(:entry "glossary/restart" :names ("restart") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " an " (:term "glossary/object" "object") " " "of " (:term "glossary/type" "type") " " (:ref "system-class/restart" "restart") "."))))
(:entry "glossary/restart designator" :names ("restart designator") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/designator" "designator") " for a " (:term "glossary/restart" "restart") "; that is, an " (:term "glossary/object" "object") " that denotes a " (:term "glossary/restart" "restart") " and that is one of: a " (:term "glossary/non-nil" "non-nil") " " (:term "glossary/symbol" "symbol") " (denoting the most recently established " (:term "glossary/active" "active") " " (:term "glossary/restart" "restart") " whose " (:term "glossary/name" "name") " is that " (:term "glossary/symbol" "symbol") "), or a " (:term "glossary/restart" "restart") " (denoting itself)."))))
(:entry "glossary/restart function" :names ("restart function") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/function" "function") " that invokes a " (:term "glossary/restart" "restart") ", as if by " (:ref "function/invoke-restart" "invoke-restart") ". The primary purpose of a " (:term "glossary/restart function" "restart function") " is to provide an alternate interface. By convention, a " (:term "glossary/restart function" "restart function") " usually has the same name as the " (:term "glossary/restart" "restart") " which it invokes. " "The next figure" " " "shows a list of the " (:term "glossary/standardized" "standardized") " " (:term "glossary/restart function" "restart functions") ".") (:table :caption ("Standardized Restart Functions") :rows ((("abort") ("muffle-warning") ("use-value")) (("continue") ("store-value") nil))))))
(:entry "glossary/return" :names ("return") :kind :glossary-term :kind-name "Glossary Term" :summary "v.t." :sections (("Definition" (:p (:i "v.t.") " " "(of " (:term "glossary/value" "values") ")") (:list (:item (:label "1.") (:p "(from a " (:term "glossary/block" "block") ") to transfer control and " (:term "glossary/value" "values") " from the " (:term "glossary/block" "block") "; that is, to cause the " (:term "glossary/block" "block") " to " (:term "glossary/yield" "yield") " the " (:term "glossary/value" "values") " immediately without doing any further evaluation of the " (:term "glossary/form" "forms") " in its body.")) (:item (:label "2.") (:p "(from a " (:term "glossary/form" "form") ") to " (:term "glossary/yield" "yield") " the " (:term "glossary/value" "values") "."))))))
(:entry "glossary/return value" :names ("return value") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " (:i "Trad.") " " " a " (:term "glossary/value" "value") (:sense "1")))))
(:entry "glossary/right-parenthesis" :names ("right-parenthesis") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " the " (:term "glossary/standard character" "standard character") " “" (:code ")") "”, that is variously called “right parenthesis” or “close parenthesis” " "See " (:secref "StdCharsThree" "Figure~2--5") "."))))
(:entry "glossary/rule of canonical representation for complex rationals" :names ("rule of canonical representation for complex rationals") :kind :glossary-term :kind-name "Glossary Term" :sections (("Definition" (:p (:i "n.")))))
(:entry "glossary/run time" :names ("run time") :kind :glossary-term :kind-name "Glossary Term" :summary "execution time" :sections (("Definition" (:p (:i "n.")) (:list (:item (:label "1.") (:p (:term "glossary/load time" "load time"))) (:item (:label "2.") (:p (:term "glossary/execution time" "execution time")))))))
(:entry "glossary/run-time compiler" :names ("run-time compiler") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " refers to the " (:ref "function/compile" "compile") " function or to " (:term "glossary/implicit compilation" "implicit compilation") ", for which the compilation and run-time " (:term "glossary/environment" "environments") " are maintained in the same " (:term "glossary/lisp image" "Lisp image") "."))))
(:entry "glossary/run-time definition" :names ("run-time definition") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a definition in the " (:term "glossary/run-time environment" "run-time environment") "."))))
(:entry "glossary/run-time environment" :names ("run-time environment") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " the " (:term "glossary/environment" "environment") " in which a program is " (:term "glossary/execute" "executed") "."))))
(:entry "glossary/safe" :names ("safe") :kind :glossary-term :kind-name "Glossary Term" :summary "(of code) processed in a lexical environment where the the highest safety level (3) was in effect." :sections (("Definition" (:p (:i "adj.")) (:list (:item (:label "1.") (:p "(of " (:term "glossary/code" "code") ") processed in a " (:term "glossary/lexical environment" "lexical environment") " where the the highest " (:code "safety") " level (" (:code "3") ") was in effect. " "See " (:code "") "optimize" ".")) (:item (:label "2.") (:p "(of a " (:term "glossary/call" "call") ") a " (:term "glossary/safe call" "safe call") "."))))))
(:entry "glossary/safe call" :names ("safe call") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/call" "call") " in which the " (:term "glossary/call" "call") ", the " (:term "glossary/function" "function") " being " (:term "glossary/call" "called") ", and the point of " (:term "glossary/functional evaluation" "functional evaluation") " are all " (:term "glossary/safe" "safe") (:sense "1") " " (:term "glossary/code" "code") ". For more detailed information, " "see " (:secref "SafeAndUnsafeCalls" "Section 3.5.1.1 (Safe and Unsafe Calls)") "."))))
(:entry "glossary/same" :names ("same") :kind :glossary-term :kind-name "Glossary Term" :summary "(of objects under a specified predicate) indistinguishable by that predicate." :sections (("Definition" (:p (:i "adj.")) (:list (:item (:label "1.") (:p "(of " (:term "glossary/object" "objects") " under a specified " (:term "glossary/predicate" "predicate") ") indistinguishable by that " (:term "glossary/predicate" "predicate") ". " "“The symbol " (:code "car") ", the string " (:code "\"car\"") ", and the string " (:code "\"CAR\"") " are the " (:code "same") " under " (:ref "function/string=" "string-equal") "”" ".")) (:item (:label "2.") (:p "(of " (:term "glossary/object" "objects") " if no predicate is implied by context) indistinguishable by " (:ref "function/eql" "eql") ". Note that " (:ref "function/eq" "eq") " might be capable of distinguishing some " (:term "glossary/number" "numbers") " and " (:term "glossary/character" "characters") " which " (:ref "function/eql" "eql") " cannot distinguish, but the nature of such, if any, is " (:term "glossary/implementation-dependent" "implementation-dependent") ". Since " (:ref "function/eq" "eq") " is used only rarely in this specification, " (:ref "function/eql" "eql") " is the default predicate when none is mentioned explicitly. " "“The conses returned by two successive calls to " (:ref "function/cons" "cons") " are never the same.”")) (:item (:label "3.") (:p "(of " (:term "glossary/type" "types") ") having the same set of " (:term "glossary/element" "elements") "; that is, each " (:term "glossary/type" "type") " is a " (:term "glossary/subtype" "subtype") " of the others. " "“The types specified by " (:code "(integer 0 1)") ", " (:code "(unsigned-byte 1)") ", and " (:code "bit") " are the same.”"))))))
(:entry "glossary/satisfy the test" :names ("satisfy the test") :kind :glossary-term :kind-name "Glossary Term" :summary "v." :sections (("Definition" (:p (:i "v.") " " " (of an " (:term "glossary/object" "object") " being considered by a " (:term "glossary/sequence function" "sequence function") ")") (:list (:item (:label "1.") (:p "(for a one " (:term "glossary/argument" "argument") " test) to be in a state such that the " (:term "glossary/function" "function") " which is the " (:param "predicate") " " (:term "glossary/argument" "argument") " to the " (:term "glossary/sequence function" "sequence function") " returns " (:term "glossary/true" "true") " when given a single " (:term "glossary/argument" "argument") " that is the result of calling the " (:term "glossary/sequence function" "sequence function") "’s " (:param "key") " " (:term "glossary/argument" "argument") " on the " (:term "glossary/object" "object") " being considered. " "See " (:secref "SatisfyingTheOneArgTest" "Section 17.2.2 (Satisfying a One-Argument Test)") ".")) (:item (:label "2.") (:p "(for a two " (:term "glossary/argument" "argument") " test) to be in a state such that the two-place " (:term "glossary/predicate" "predicate") " which is the " (:term "glossary/sequence function" "sequence function") "’s " (:param "test") " " (:term "glossary/argument" "argument") " returns " (:term "glossary/true" "true") " when given a first " (:term "glossary/argument" "argument") " that is") (:p "the " (:term "glossary/object" "object") " being considered, and when given a second " (:term "glossary/argument" "argument") " that is the result of calling the " (:term "glossary/sequence function" "sequence function") "’s " (:param "key") " " (:term "glossary/argument" "argument") " on an " (:term "glossary/element" "element") " of the " (:term "glossary/sequence function" "sequence function") "’s " (:param "sequence") " " (:term "glossary/argument" "argument") " which is being tested for equality; or to be in a state such that the " (:param "test-not") " " (:term "glossary/function" "function") " returns " (:term "glossary/false" "false") " given the same " (:term "glossary/argument" "arguments") ". " "See " (:secref "SatisfyingTheTwoArgTest" "Section 17.2.1 ({}Satisfying a Two-Argument Test)") "."))))))
(:entry "glossary/scope" :names ("scope") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " the structural or textual region of code in which " (:term "glossary/reference" "references") " to an " (:term "glossary/object" "object") ", a " (:term "glossary/binding" "binding") ", an " (:term "glossary/exit point" "exit point") ", a " (:term "glossary/tag" "tag") ", or an " (:term "glossary/environment" "environment") " (usually by " (:term "glossary/name" "name") ") can occur."))))
(:entry "glossary/script" :names ("script") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " (:i "ISO") " " " one of possibly several sets that form an " (:term "glossary/exhaustive partition" "exhaustive partition") " of the type " (:ref "system-class/character" "character") ". " "See " (:secref "CharScripts" "Section 13.1.2.1 (Character Scripts)") "."))))
(:entry "glossary/secondary value" :names ("secondary value") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " "(of " (:term "glossary/value" "values") " resulting from the " (:term "glossary/evaluation" "evaluation") " of a " (:term "glossary/form" "form") ") the second " (:term "glossary/value" "value") ", if any, or else " (:ref "constant-variable/nil" "nil") " " "if there are fewer than two " (:term "glossary/value" "values") ". " "“The secondary value returned by " (:ref "function/floor" "truncate") " is a remainder.”"))))
(:entry "glossary/section" :names ("section") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a partitioning of output by a " (:term "glossary/conditional newline" "conditional newline") " on a " (:term "glossary/pretty printing stream" "pretty printing stream") ". " "See " (:secref "DynamicControlofOutput" "Section 22.2.1.1 (Dynamic Control of the Arrangement of Output)") "."))))
(:entry "glossary/self-evaluating object" :names ("self-evaluating object") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " an " (:term "glossary/object" "object") " that is neither a " (:term "glossary/symbol" "symbol") " nor a") (:p (:term "glossary/cons" "cons") ". If a " (:term "glossary/self-evaluating object" "self-evaluating object") " is " (:term "glossary/evaluate" "evaluated") ", it " (:term "glossary/yield" "yields") " itself as its only " (:term "glossary/value" "value") ". " "“Strings are self-evaluating objects.”"))))
(:entry "glossary/semi-standard" :names ("semi-standard") :kind :glossary-term :kind-name "Glossary Term" :summary "adj." :sections (("Definition" (:p (:i "adj.") " " "(of a language feature) not required to be implemented by any " (:term "glossary/conforming implementation" "conforming implementation") ", but nevertheless recommended as the canonical approach in situations where an " (:term "glossary/implementation" "implementation") " does plan to support such a feature. The presence of " (:term "glossary/semi-standard" "semi-standard") " aspects in the language is intended to lessen portability problems and reduce the risk of gratuitous divergence among " (:term "glossary/implementation" "implementations") " that might stand in the way of future standardization."))))
(:entry "glossary/semicolon" :names ("semicolon") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " the " (:term "glossary/standard character" "standard character") " that is called “semicolon” (" (:code ";") "). " "See " (:secref "StdCharsThree" "Figure~2--5") "."))))
(:entry "glossary/sequence" :names ("sequence") :kind :glossary-term :kind-name "Glossary Term" :summary "an ordered collection of elements" :sections (("Definition" (:p (:i "n.")) (:list (:item (:label "1.") (:p "an ordered collection of elements")) (:item (:label "2.") (:p "a " (:term "glossary/vector" "vector") " or a " (:term "glossary/list" "list") "."))))))
(:entry "glossary/sequence function" :names ("sequence function") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " one of the " (:term "glossary/function" "functions") " in " (:secref "SequenceFunctions" "Figure~17--1") ", or an " (:term "glossary/implementation-defined" "implementation-defined") " " (:term "glossary/function" "function") " that operates on one or more " (:term "glossary/sequence" "sequences") ". and that is defined by the " (:term "glossary/implementation" "implementation") " to be a " (:term "glossary/sequence function" "sequence function") "."))))
(:entry "glossary/sequential" :names ("sequential") :kind :glossary-term :kind-name "Glossary Term" :summary "adj." :sections (("Definition" (:p (:i "adj.") " " (:i "Trad.") " " "(of " (:term "glossary/binding" "binding") " or " (:term nil "assignment") ") done in the style of " (:ref "special-form/setq" "setq") ", " (:ref "special-operator/let" "let*") ", or " (:ref "macro/do" "do*") "; that is, interleaving the evaluation of the " (:term "glossary/form" "forms") " that produce " (:term "glossary/value" "values") " with the " (:term nil "assignments") " or " (:term "glossary/binding" "bindings") " of the " (:term "glossary/variable" "variables") " (or " (:term "glossary/place" "places") "). " "See " (:term "glossary/parallel" "parallel") "."))))
(:entry "glossary/sequentially" :names ("sequentially") :kind :glossary-term :kind-name "Glossary Term" :summary "adv." :sections (("Definition" (:p (:i "adv.") " " " in a " (:term "glossary/sequential" "sequential") " way."))))
(:entry "glossary/serious condition" :names ("serious condition") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/condition" "condition") " " "of " (:term "glossary/type" "type") " " (:ref "condition-type/serious-condition" "serious-condition") ", which represents a " (:term "glossary/situation" "situation") " that is generally sufficiently severe that entry into the " (:term "glossary/debugger" "debugger") " should be expected if the " (:term "glossary/condition" "condition") " is " (:term "glossary/signal" "signaled") " but not " (:term "glossary/handle" "handled") "."))))
(:entry "glossary/session" :names ("session") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " the conceptual aggregation of events in a " (:term "glossary/lisp image" "Lisp image") " from the time it is started to the time it is terminated."))))
(:entry "glossary/set" :names ("set") :kind :glossary-term :kind-name "Glossary Term" :summary "v.t." :sections (("Definition" (:p (:i "v.t.") " " (:i "Trad.") " " "(any " (:term "glossary/variable" "variable") " or a " (:term "glossary/symbol" "symbol") " that is the " (:term "glossary/name" "name") " of a " (:term "glossary/dynamic variable" "dynamic variable") ") to " (:term "glossary/assign" "assign") " the " (:term "glossary/variable" "variable") "."))))
(:entry "glossary/setf expander" :names ("setf expander") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a function used by " (:ref "macro/setf" "setf") " to compute the " (:term "glossary/setf expansion" "setf expansion") " of a " (:term "glossary/place" "place") "."))))
(:entry "glossary/setf expansion" :names ("setf expansion") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a set of five " (:term "glossary/expression" "expressions") (:sense "1") " that, taken together, describe how to store into a " (:term "glossary/place" "place") " and which " (:term "glossary/subform" "subforms") " of the macro call associated with the " (:term "glossary/place" "place") " are evaluated. " "See " (:secref "SetfExpansions" "Section 5.1.1.2 (Setf Expansions)") "."))))
(:entry "glossary/setf function" :names ("setf function") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/function" "function") " whose " (:term "glossary/name" "name") " is " (:code "(setf " (:term "glossary/symbol" "symbol") ")") "."))))
(:entry "glossary/setf function name" :names ("setf function name") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " "(of a " (:term "glossary/symbol" "symbol") " " (:param "S") ") the " (:term "glossary/list" "list") " " (:code "(setf " (:param "S") ")") "."))))
(:entry "glossary/shadow" :names ("shadow") :kind :glossary-term :kind-name "Glossary Term" :summary "to override the meaning of." :sections (("Definition" (:p (:i "v.t.")) (:list (:item (:label "1.") (:p "to override the meaning of. " "“That binding of " (:code "X") " shadows an outer one.”")) (:item (:label "2.") (:p "to hide the presence of. " "“That " (:ref "special-operator/flet" "macrolet") " of " (:code "F") " shadows the outer " (:ref "special-operator/flet" "flet") " of " (:code "F") ".”")) (:item (:label "3.") (:p "to replace. " "“That package shadows the symbol " (:code "cl:car") " with its own symbol " (:code "car") ".”"))))))
(:entry "glossary/shadowing symbol" :names ("shadowing symbol") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " "(in a " (:term "glossary/package" "package") ") an " (:term "glossary/element" "element") " of the " (:term "glossary/package" "package") "’s " (:term "glossary/shadowing symbols list" "shadowing symbols list") "."))))
(:entry "glossary/shadowing symbols list" :names ("shadowing symbols list") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " "(of a " (:term "glossary/package" "package") ") a " (:term "glossary/list" "list") ", associated with the " (:term "glossary/package" "package") ", of " (:term "glossary/symbol" "symbols") " that are to be exempted from ‘symbol conflict errors’ detected when packages are " (:term "glossary/use" "used") ". " "See the " (:term "glossary/function" "function") " " (:ref "function/package-shadowing-symbols" "package-shadowing-symbols") "."))))
(:entry "glossary/shared slot" :names ("shared slot") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " "(of a " (:term "glossary/class" "class") ") a " (:term "glossary/slot" "slot") " " (:term "glossary/accessible" "accessible") " in more than one " (:term "glossary/instance" "instance") " of a " (:term "glossary/class" "class") "; specifically, such a " (:term "glossary/slot" "slot") " is " (:term "glossary/accessible" "accessible") " in all " (:term "glossary/direct instance" "direct instances") " of the " (:term "glossary/class" "class") " and in those " (:term "glossary/indirect instance" "indirect instances") " whose " (:term "glossary/class" "class") " does not " (:term "glossary/shadow" "shadow") (:sense "1") " the " (:term "glossary/slot" "slot") "."))))
(:entry "glossary/sharpsign" :names ("sharpsign") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " the " (:term "glossary/standard character" "standard character") " that is variously called “number sign,” “sharp,” or “sharp sign” (" (:code "#") "). " "See " (:secref "StdCharsThree" "Figure~2--5") "."))))
(:entry "glossary/short float" :names ("short float") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " an " (:term "glossary/object" "object") " " "of " (:term "glossary/type" "type") " " (:ref "type/short-float" "short-float") "."))))
(:entry "glossary/sign" :names ("sign") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " one of the " (:term "glossary/standard character" "standard characters") " “" (:code "+") "” or “" (:code "-") "”."))))
(:entry "glossary/signal" :names ("signal") :kind :glossary-term :kind-name "Glossary Term" :summary "v." :sections (("Definition" (:p (:i "v.") " " " to announce, using a standard protocol, that a particular situation, represented by a " (:term "glossary/condition" "condition") ", has been detected. " "See " (:secref "ConditionSystemConcepts" "Section 9.1 (Condition System Concepts)") "."))))
(:entry "glossary/signature" :names ("signature") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " "(of a " (:term "glossary/method" "method") ") a description of the " (:term "glossary/parameter" "parameters") " and " (:term "glossary/parameter specializer" "parameter specializers") " for the " (:term "glossary/method" "method") " which determines the " (:term "glossary/method" "method") "’s applicability for a given set of required " (:term "glossary/argument" "arguments") ", and which also describes the " (:term "glossary/argument" "argument") " conventions for its other, non-required " (:term "glossary/argument" "arguments") "."))))
(:entry "glossary/similar" :names ("similar") :kind :glossary-term :kind-name "Glossary Term" :summary "adj." :sections (("Definition" (:p (:i "adj.") " " "(of two " (:term "glossary/object" "objects") ") defined to be equivalent under the " (:term "glossary/similarity" "similarity") " relationship."))))
(:entry "glossary/similarity" :names ("similarity") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a two-place conceptual equivalence predicate, which is independent of the " (:term "glossary/lisp image" "Lisp image") " so that two " (:term "glossary/object" "objects") " in different " (:term "glossary/lisp image" "Lisp images") " can be understood to be equivalent under this predicate. " "See " (:secref "LiteralsInCompiledFiles" "Section 3.2.4 (Literal Objects in Compiled Files)") "."))))
(:entry "glossary/simple" :names ("simple") :kind :glossary-term :kind-name "Glossary Term" :summary "(of an array) being of type simple-array." :sections (("Definition" (:p (:i "adj.")) (:list (:item (:label "1.") (:p "(of an " (:term "glossary/array" "array") ") being " "of " (:term "glossary/type" "type") " " (:ref "type/simple-array" "simple-array") ".")) (:item (:label "2.") (:p "(of a " (:term "glossary/character" "character") ") having no " (:term "glossary/implementation-defined" "implementation-defined") " " (:term "glossary/attribute" "attributes") ", or else having " (:term "glossary/implementation-defined" "implementation-defined") " " (:term "glossary/attribute" "attributes") " each of which has the " (:term "glossary/null" "null") " value for that " (:term "glossary/attribute" "attribute") "."))))))
(:entry "glossary/simple array" :names ("simple array") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " an " (:term "glossary/array" "array") " " "of " (:term "glossary/type" "type") " " (:ref "type/simple-array" "simple-array") "."))))
(:entry "glossary/simple bit array" :names ("simple bit array") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/bit array" "bit array") " that is a " (:term "glossary/simple array" "simple array") "; that is, an " (:term "glossary/object" "object") " of " (:term "glossary/type" "type") " " (:code "(simple-array bit)") "."))))
(:entry "glossary/simple bit vector" :names ("simple bit vector") :kind :glossary-term :kind-name "Glossary Term" :summary "n." :sections (("Definition" (:p (:i "n.") " " " a " (:term "glossary/bit vector" "bit vector") " " "of " (:term "glossary/type" "type") " " (:ref "type/simple-bit-vector" "simple-bit-vector") "."))))
