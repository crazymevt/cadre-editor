(in-package #:cadre-ui-tests)

(define-test clos-browser)

(define-test clos-back-restores-navigation-context :parent clos-browser
  (let* ((page (ui::make-clos-page :connection :connection :search :search :back :back))
         (filter "") (back-enabled nil))
    (with-assistant-functions
        ((ui::clos-page-live-p (lambda (&rest args) (declare (ignore args)) t))
         (ui::connected-p (lambda () t))
         (gtk:label-set-text (lambda (&rest args) (declare (ignore args))))
         (gtk:widget-set-tooltip-text (lambda (&rest args) (declare (ignore args))))
         (gtk:widget-set-sensitive (lambda (widget value) (when (eq widget :back) (setf back-enabled value))))
         (gtk:editable-get-text (lambda (widget) (declare (ignore widget)) filter))
         (gtk:editable-set-text (lambda (widget value) (declare (ignore widget)) (setf filter value)))
         (ui::clos-render-detail (lambda (page) (declare (ignore page))))
         (ui::rex (lambda (connection form &key on-ok on-abort)
                    (declare (ignore connection on-abort))
                    (funcall on-ok (list :kind (second form) :name (third form) :source '(:error "No source"))))))
      (ui::clos-select-entry page '(:kind :class :name "A"))
      (false back-enabled)
      (setf (ui::cb-section page) "Hierarchy" filter "class filter")
      (ui::clos-select-entry page '(:kind :generic :name "B"))
      (true back-enabled)
      (setf (ui::cb-section page) "Methods" filter "method filter")
      (ui::clos-select-entry page '(:kind :class :name "C"))
      (ui::clos-select-entry page '(:kind :class :name "C"))
      (is = 2 (length (ui::cb-history page)))
      (ui::clos-go-back page)
      (is string= "B" (getf (ui::cb-selected page) :name))
      (is string= "Methods" (ui::cb-section page))
      (is string= "method filter" filter)
      (is = 1 (length (ui::cb-history page)))
      (ui::clos-go-back page)
      (is string= "A" (getf (ui::cb-selected page) :name))
      (is string= "Hierarchy" (ui::cb-section page))
      (is string= "class filter" filter)
      (false back-enabled)
      (false (ui::cb-history page))
      ;; Reaching the beginning is harmless and does not create history.
      (ui::clos-go-back page)
      (is string= "A" (getf (ui::cb-selected page) :name)))))

(define-test clos-selection-ignores-stale-replies :parent clos-browser
  (let* ((page (ui::make-clos-page :connection :connection))
         (pending nil) (live t) (renders 0))
    (with-assistant-functions
        ((ui::clos-page-live-p (lambda (page connection) (declare (ignore page connection)) live))
         (gtk:label-set-text (lambda (&rest args) (declare (ignore args))))
         (gtk:widget-set-tooltip-text (lambda (&rest args) (declare (ignore args))))
         (gtk:widget-set-sensitive (lambda (&rest args) (declare (ignore args))))
         (ui::clos-render-detail (lambda (page) (declare (ignore page)) (incf renders)))
         (ui::rex (lambda (connection form &key on-ok on-abort)
                    (declare (ignore connection form on-abort)) (push on-ok pending))))
      (ui::clos-select-entry page '(:kind :class :name "OLD"))
      (ui::clos-select-entry page '(:kind :class :name "NEW"))
      (let ((new (pop pending)) (old (pop pending)))
        (funcall new '(:kind :class :name "NEW" :source (:error "No source")))
        (funcall old '(:kind :class :name "OLD" :source (:error "No source")))
        (is string= "NEW" (getf (ui::cb-description page) :name))
        (is = 3 renders)
        (setf live nil)
        (funcall new '(:kind :class :name "DISCONNECTED"))
        (is string= "NEW" (getf (ui::cb-description page) :name))
        (is = 3 renders)))))
