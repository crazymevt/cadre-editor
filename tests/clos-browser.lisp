(in-package #:cadre-tests)

(define-test clos-browser-filter :parent cadre-tests
  (let ((catalog '(:entries ((:kind :class :name "DEMO::DOCUMENT")
                            (:kind :class :name "DEMO::TEXT-DOCUMENT")
                            (:kind :generic :name "DEMO::SAVE-DOCUMENT")))))
    (is = 3 (length (c:clos-browser-entries catalog :filter "document")))
    (is = 2 (length (c:clos-browser-entries catalog :kind :class)))
    (is equal '("DEMO::SAVE-DOCUMENT")
        (mapcar (lambda (e) (getf e :name)) (c:clos-browser-entries catalog :filter "save")))))

(define-test clos-browser-image :parent cadre-tests
  (let ((connection (start-test-lisp)))
    (unwind-protect
         (progn
           (swank connection "swank:interactive-eval-region" c:+clos-browser-helper+ 3 120)
           (swank connection "swank:interactive-eval-region"
                  "(defpackage :clos-demo (:use :cl))
(in-package :clos-demo)
(defclass document () ((path :initarg :path :type string)))
(defclass evaluable () ((connection :initform nil)))
(defclass text-document (document evaluable) ((text :initform \"\" :type string)))
(defgeneric save-document (document))
(defmethod save-document ((doc document)) doc)
(defmethod save-document :before ((doc text-document)) nil)
(defgeneric (setf content) (value document))
(defmethod (setf content) (value (doc text-document)) value)
(defgeneric choice (value))
(defmethod choice ((value (eql :special))) value)
(defstruct point x y)
(defclass unfinished () ((value :initarg :value)))
(make-instance 'text-document :path \"example.lisp\")" 3 120)
           (flet ((query (operation &rest args)
                    (c:swank-eval-sync connection (apply #'c:clos-browser-call operation args))))
             (let ((catalog (query "catalog" "CLOS-DEMO")))
               (false (getf catalog :error))
               (true (member "CLOS-DEMO" (getf catalog :packages) :test #'equal))
               (true (find "CLOS-DEMO::TEXT-DOCUMENT" (getf catalog :entries)
                           :key (lambda (e) (getf e :name)) :test #'equal))
               (true (find "(COMMON-LISP:SETF CLOS-DEMO::CONTENT)" (getf catalog :entries)
                           :key (lambda (e) (getf e :name)) :test #'equal)))
             (let* ((description (query "describe-entry" :class "text-document" "CLOS-DEMO"))
                    (slots (getf description :slots))
                    (path (find "CLOS-DEMO::PATH" slots :key (lambda (s) (getf s :name)) :test #'equal)))
               (false (getf description :error))
               (is = 3 (length slots))
               (is equal '("CLOS-DEMO::DOCUMENT" "CLOS-DEMO::EVALUABLE") (getf description :superclasses))
               (is equal '("CLOS-DEMO::DOCUMENT") (getf path :defined-by))
               (is string= "COMMON-LISP:STRING" (getf path :type))
               (true (some (lambda (m) (getf m :inherited)) (getf description :methods))))
             (let ((description (query "describe-entry" :generic "save-document" "CLOS-DEMO")))
               (is = 2 (length (getf description :methods)))
               (true (some (lambda (m) (equal '(":BEFORE") (getf m :qualifiers))) (getf description :methods))))
             (let ((method (first (getf (query "describe-entry" :generic "choice" "CLOS-DEMO") :methods))))
               (false (getf (first (getf method :specializers)) :class))
               (true (search "EQL" (getf (first (getf method :specializers)) :name))))
             (false (getf (query "describe-entry" :class "point" "CLOS-DEMO") :error))
             (false (getf (query "describe-entry" :class "integer" "COMMON-LISP") :error))
             (let ((description (query "describe-entry" :class "unfinished" "CLOS-DEMO")))
               (false (getf description :error))
               (false (getf description :finalized))
               (true (getf description :warnings)))
             (true (getf (query "describe-entry" :class "missing" "CLOS-DEMO") :error))
             (true (getf (query "describe-entry" :class "#.(error \"must not execute\")" "CLOS-DEMO") :error))
             (true (getf (query "describe-entry" :class "document text-document" "CLOS-DEMO") :error))
             ;; Redefinition is visible immediately, without restarting the connection.
             (swank connection "swank:interactive-eval-region"
                    "(defclass clos-demo::text-document (clos-demo::document clos-demo::evaluable)
 ((text :initform \"\") (encoding :initform :utf-8)))
(make-instance 'clos-demo::text-document :path \"new.lisp\")" 3 120)
             (is = 4 (length (getf (query "describe-entry" :class "text-document" "CLOS-DEMO") :slots)))
             (is string= "CLOS-DEMO::TEXT-DOCUMENT"
                 (getf (query "class-of-expression" "(make-instance 'clos-demo::text-document :path \"x\")") :name))))
      (c:swank-disconnect connection)
      (c:kill-inferior-lisp (c:connection-process connection)))))
